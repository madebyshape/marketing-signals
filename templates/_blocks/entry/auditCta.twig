{# Block Defaults #}

{% set blockDefaults = {
    handle: entry.type.handle,
    padding: entry.padding|length ? entry.padding.value : 'topBottom',
} %}

{# Merge Defaults #}

{% set params = (params is defined and params is iterable) ? blockDefaults|merge(params) : blockDefaults %}

{# Content #}

{% set hasEyebrow = entry.eyebrow|trim|length > 0 %}
{% set hasHeading = entry.heading|striptags|trim|length > 0 %}
{% set hasText = entry.text|striptags|trim|length > 0 %}
{% set image = entry.image.one() %}

{# Classes #}

{% set blockClasses = {
    margin: vars is defined ? vars.class.siteMargin.x : 'px-10',
    panel: [
        'rounded-[20px] bg-black p-6.25',
        '|',
        'lg:p-10'
    ],
    eyebrow: [
        'mb-12.5',
        '|',
        'lg:mb-37.5'
    ],
    grid: [
        'grid grid-cols-1 gap-5',
        '|',
        'lg:grid-cols-12'
    ],
    column: [
        'col-span-full',
        '|',
        'lg:col-span-5'
    ],
    heading: [
        'font-semibold leading-0.97 tracking-tighter',
        '|',
        'md:text-6xl | lg:text-7xl'
    ],
    text: 'mt-7.5',
    button: 'mt-10',
    media: [
        'relative col-span-full',
        '|',
        'lg:col-span-7'
    ],
    frame: [
        'relative aspect-8/9 w-full overflow-hidden rounded-[30px] bg-primary',
        '|',
        'lg:ml-[14%] lg:w-3/5 lg:rotate-2'
    ]
} %}

{# Output #}

{% if hasHeading %}

    {% embed '_components/section'
        with {
            params: params|merge({
                paddingY: params.padding,
                paddingX: 'none'
            })
        }
    %}
        {% block sectionContent %}

            <div class="{{ blockClasses.margin }}">

                <div class="{{ blockClasses.panel|join(' ')|trim }}">

                    {% if hasEyebrow %}

                        {% include '_components/eyebrow' with {
                            params: {
                                text: entry.eyebrow,
                                colour: 'white',
                                rule: true,
                                ruleColour: 'white-30',
                                class: blockClasses.eyebrow|join(' ')|trim
                            }
                        } only %}

                    {% endif %}

                    <div class="{{ blockClasses.grid|join(' ')|trim }}">

                        <div class="{{ blockClasses.column|join(' ')|trim }}">

                            {% include '_components/headingAlternate' with {
                                params: {
                                    tag: 'h2',
                                    heading: entry.heading,
                                    colour: 'white',
                                    size: '4xl',
                                    alternateStyle: 'secondary',
                                    class: blockClasses.heading|join(' ')|trim
                                }
                            } only %}

                            {% if hasText %}

                                {% include '_components/richText' with {
                                    params: {
                                        content: entry.text,
                                        colour: 'white',
                                        size: 'base',
                                        list: 'check-single',
                                        class: blockClasses.text
                                    }
                                } only %}

                            {% endif %}

                            {% include '_components/button' with {
                                params: {
                                    button: entry.button,
                                    class: blockClasses.button
                                }
                            } only %}

                        </div>

                        <div class="{{ blockClasses.media|join(' ')|trim }}">

                            <div class="{{ blockClasses.frame|join(' ')|trim }}">

                                {% if image %}

                                    {% include '_components/picture' with {
                                        params: {
                                            image: image,
                                            alt: '',
                                            transform: '8x9',
                                            ratio: false,
                                            sizes: '(min-width: 1024px) 32vw, calc(100vw - 130px)',
                                            imgClass: 'absolute inset-0 h-full w-full object-cover'
                                        }
                                    } only %}

                                {% endif %}

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        {% endblock %}
    {% endembed %}

{% endif %}
