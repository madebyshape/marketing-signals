{# Block Defaults #}

{% set blockDefaults = {
    handle: entry.type.handle,
    padding: entry.padding|length ? entry.padding.value : 'topBottom',
} %}

{# Merge Defaults #}

{% set params = (params is defined and params is iterable) ? blockDefaults|merge(params) : blockDefaults %}

{# Content #}

{% set tiles = entry.eyebrowImages.all() %}
{% set buttons = entry.buttonGroup.all() %}

{% set hasHeading = entry.heading|striptags|trim|length > 0 %}

{# Options #}

{% set blockOptions = {
    transform: {
        full: 'noRatioLarge',
        part: 'noRatio'
    },
    sizes: {
        full: '100vw',
        part: '(min-width: 768px) 50vw, 100vw'
    },
    ruleColour: {
        white: 'white-30',
        black: 'black'
    }
} %}

{# Classes #}

{% set blockClasses = {
    headingRow: [
        'grid grid-cols-12 gap-5',
        tiles|length ? 'mb-12.5'
    ],
    heading: 'col-span-12 text-center font-semibold leading-0.97 tracking-tighter | md:col-start-3 md:col-span-8 md:text-7xl lg:text-8xl',
    grid: 'grid grid-cols-1 gap-5',
    tile: 'relative overflow-hidden rounded-[20px] aspect-16/10',
    eyebrow: 'absolute z-10 top-5 inset-x-5 | lg:top-10 lg:inset-x-10',
    buttons: (hasHeading or tiles|length) ? 'mt-10'
} %}

{# Output #}

{% if hasHeading or tiles|length or buttons|length %}

    {% embed '_components/section'
        with {
            params: params|merge({
                paddingY: params.padding,
            })
        }
    %}
        {% block sectionContent %}

            {% if hasHeading %}

                <div class="{{ blockClasses.headingRow|join(' ')|trim }}">

                    {% include '_components/headingAlternate' with {
                        params: {
                            heading: entry.heading,
                            size: '5xl',
                            class: blockClasses.heading
                        }
                    } only %}

                </div>

            {% endif %}

            {% if tiles|length %}

                <div class="{{ blockClasses.grid }}">

                    {# Tiles run in sevens; the first of each run is the full Tile. #}

                    {% for run in tiles|batch(7) %}

                        {% for tile in run %}

                            {% set size = loop.first ? 'full' : 'part' %}
                            {% set textColour = tile.dropdownTextColour.value ?: 'black' %}

                            <div class="{{ blockClasses.tile }}">

                                {% include '_components/picture' with {
                                    params: {
                                        image: tile.image.one(),
                                        transform: blockOptions.transform[size],
                                        ratio: false,
                                        focalPoint: true,
                                        sizes: blockOptions.sizes[size]
                                    }
                                } only %}

                                {% if tile.eyebrow|trim|length %}

                                    {% include '_components/eyebrow' with {
                                        params: {
                                            text: tile.eyebrow,
                                            colour: textColour,
                                            rule: true,
                                            ruleColour: blockOptions.ruleColour[textColour],
                                            class: blockClasses.eyebrow
                                        }
                                    } only %}

                                {% endif %}

                            </div>

                        {% endfor %}

                    {% endfor %}

                </div>

            {% endif %}

            {% include '_components/buttonGroup' with {
                params: {
                    buttons: buttons,
                    align: 'center',
                    class: blockClasses.buttons
                }
            } only %}

        {% endblock %}
    {% endembed %}

{% endif %}
