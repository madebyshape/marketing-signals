{# Block Defaults #}

{% set blockDefaults = {
    handle: entry.type.handle,
    padding: entry.padding|length ? entry.padding.value : 'bottom',
} %}

{# Merge Defaults #}

{% set params = (params is defined and params is iterable) ? blockDefaults|merge(params) : blockDefaults %}

{# Content #}

{% set buttons = entry.buttonGroup.all() %}

{% set isCentred = (entry.alignment.value ?? 'left') == 'center' %}
{% set hasBreadcrumbs = entry.breadcrumbs is not same as(false) %}
{% set hasEyebrow = entry.eyebrow|trim|length > 0 %}
{% set hasText = entry.text|striptags|trim|length > 0 %}
{% set hasButtons = buttons|length > 0 %}

{# Options #}

{% set blockOptions = {
    backgroundColour: {
        creme: {
            panel: null,
            eyebrow: 'black',
            heading: 'base',
            highlight: 'base',
            text: 'black',
            breadcrumb: 'base',
            buttons: ['secondary', 'creme-300-outline']
        },
        black: {
            panel: 'rounded-b-[30px] bg-black pb-15 | xl:pb-[125px]',
            eyebrow: 'white',
            heading: 'creme-100',
            highlight: 'secondary',
            text: 'white',
            breadcrumb: 'white',
            buttons: ['secondary', 'white-30-outline']
        }
    }
} %}

{% set background = blockOptions.backgroundColour[entry.backgroundColour.value ?? 'creme'] ?? blockOptions.backgroundColour.creme %}

{# Classes #}

{# The header is fixed (ADR-0001), so the panel's top padding is the header height #}

{% set blockClasses = {
    panel: [
        'w-full',
        vars is defined ? vars.class.siteMargin.x : 'px-10',
        vars is defined ? vars.class.header.paddingTop : 'pt-20 | xl:pt-[123px]',
        background.panel
    ],
    grid: [
        'grid grid-cols-12 gap-x-5 gap-y-7.5 mt-15',
        '|',
        hasButtons or isCentred ? 'lg:items-start' : 'lg:items-end',
        hasBreadcrumbs ? 'xl:mt-[130px]' : 'xl:mt-[90px]'
    ],
    eyebrow: isCentred ? 'col-span-12 text-center' : (hasButtons ? 'col-span-12 | lg:col-span-8' : 'col-span-12 | lg:col-span-7'),
    heading: isCentred
        ? 'col-span-12 text-center font-semibold leading-0.97 tracking-tighter | md:text-7xl lg:col-span-8 lg:col-start-3 lg:text-9xl xl:text-10xl'
        : (hasButtons
            ? 'col-span-12 font-semibold leading-0.97 tracking-tighter | md:text-7xl lg:col-span-8 lg:text-9xl xl:text-10xl'
            : 'col-span-12 font-semibold leading-0.97 tracking-tighter | md:text-7xl lg:col-span-7 lg:text-9xl xl:text-11xl'),
    text: isCentred ? 'max-w-[750px]' : 'col-span-12 | lg:col-span-3 lg:col-start-10',
    textColumn: isCentred ? 'col-span-12 flex flex-col items-center text-center' : 'col-span-12 | lg:col-span-4 lg:col-start-9',
    buttons: 'mt-7.5'
} %}

{# Output #}

{% embed '_components/section'
    with {
        params: params|merge({
            paddingY: params.padding,
            paddingX: 'none'
        })
    }
%}
    {% block sectionContent %}

        <div class="{{ blockClasses.panel|join(' ')|trim }}">

            {% if hasBreadcrumbs %}

                {% include '_components/breadcrumb' with {
                    params: {
                        entry: entry.owner,
                        colour: background.breadcrumb
                    }
                } only %}

            {% endif %}

            <div class="{{ blockClasses.grid|join(' ')|trim }}">

                {% if hasEyebrow %}

                    {% include '_components/eyebrow' with {
                        params: {
                            text: entry.eyebrow,
                            colour: background.eyebrow,
                            class: blockClasses.eyebrow
                        }
                    } only %}

                {% endif %}

                {% include '_components/headingAlternate' with {
                    params: {
                        tag: 'h1',
                        heading: entry.heading,
                        colour: background.heading,
                        size: '5xl',
                        alternateStyle: background.highlight,
                        class: blockClasses.heading
                    }
                } only %}

                {% if hasButtons or isCentred %}

                    <div class="{{ blockClasses.textColumn }}">

                        {% if hasText %}

                            {% include '_components/richText' with {
                                params: {
                                    content: entry.text,
                                    colour: background.text,
                                    class: isCentred ? blockClasses.text
                                }
                            } only %}

                        {% endif %}

                        {% include '_components/buttonGroup' with {
                            params: {
                                buttons: buttons,
                                colours: background.buttons,
                                align: isCentred ? 'center' : 'start',
                                class: hasText ? blockClasses.buttons
                            }
                        } only %}

                    </div>

                {% else %}

                    {% include '_components/richText' with {
                        params: {
                            content: entry.text,
                            colour: background.text,
                            class: blockClasses.text
                        }
                    } only %}

                {% endif %}

            </div>

        </div>

    {% endblock %}
{% endembed %}
