{# Block Defaults #}

{% set blockDefaults = {
    handle: entry.type.handle,
    padding: entry.padding|length ? entry.padding.value : 'bottom',
} %}

{# Merge Defaults #}

{% set params = (params is defined and params is iterable) ? blockDefaults|merge(params) : blockDefaults %}

{# Classes #}

{# The header is fixed (ADR-0001), so the section's top padding is the header height #}

{% set blockClasses = {
    grid: 'grid grid-cols-12 gap-x-5 gap-y-7.5 mt-15 | lg:items-end xl:mt-[130px]',
    heading: 'col-span-12 font-semibold leading-0.97 tracking-tighter | md:text-7xl lg:col-span-7 lg:text-9xl xl:text-11xl',
    text: 'col-span-12 | lg:col-span-3 lg:col-start-10'
} %}

{# Output #}

{% embed '_components/section'
    with {
        params: params|merge({
            paddingY: params.padding,
            class: vars is defined ? vars.class.header.paddingTop : 'pt-20 | xl:pt-[123px]',
        })
    }
%}
    {% block sectionContent %}

        {% include '_components/breadcrumb' with {
            params: {
                entry: entry.owner
            }
        } only %}

        <div class="{{ blockClasses.grid }}">

            {% include '_components/headingAlternate' with {
                params: {
                    tag: 'h1',
                    heading: entry.heading,
                    size: '5xl',
                    class: blockClasses.heading
                }
            } only %}

            {% include '_components/richText' with {
                params: {
                    content: entry.text,
                    colour: 'black',
                    class: blockClasses.text
                }
            } only %}

        </div>

    {% endblock %}
{% endembed %}
