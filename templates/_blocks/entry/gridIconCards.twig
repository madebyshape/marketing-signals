{# Block Defaults #}

{% set blockDefaults = {
    handle: entry.type.handle,
    padding: entry.padding|length ? entry.padding.value : 'topBottom',
} %}

{# Merge Defaults #}

{% set params = (params is defined and params is iterable) ? blockDefaults|merge(params) : blockDefaults %}

{# Icon Cards #}

{% set cards = entry.iconCards.all()|filter(card => card.heading|trim|length or card.text|striptags|trim|length) %}

{% set avatar = entry.avatarGroup %}

{% set hasHeading = entry.heading|striptags|trim|length > 0 %}
{% set hasText = entry.text|striptags|trim|length > 0 %}

{% set hasHeader = hasHeading or hasText %}
{% set hasFooter = entry.button|length or avatar.avatarName|length %}

{# Options #}

{# Five across only from `xl`: at 1024 five cards inside the site margins are narrower than their own padding allows. #}

{% set blockOptions = {
    columns: {
        1: null,
        2: '| md:grid-cols-2',
        3: '| md:grid-cols-2 | lg:grid-cols-3',
        4: '| md:grid-cols-2 | lg:grid-cols-3 | xl:grid-cols-4',
        5: '| md:grid-cols-2 | lg:grid-cols-3 | xl:grid-cols-5'
    }
} %}

{# Classes #}

{% set blockClasses = {
    header: 'text-center',
    heading: [
        'mx-auto max-w-[1007px] font-semibold leading-0.97 tracking-tighter',
        '|',
        'md:text-6xl | lg:text-7xl'
    ],
    text: 'mx-auto max-w-[494px] mt-7.5',
    grid: [
        'grid grid-cols-1 items-stretch gap-5',
        hasHeader ? 'mt-12.5',
        blockOptions.columns[cards|length] ?? blockOptions.columns[5]
    ],
    footer: 'flex flex-wrap items-center justify-center gap-5 mt-10'
} %}

{# Output #}

{% if hasHeader or cards|length %}

    {% embed '_components/section'
        with {
            params: params|merge({
                paddingY: params.padding,
            })
        }
    %}
        {% block sectionContent %}

            {% if hasHeader %}

                <div class="{{ blockClasses.header }}">

                    {% include '_components/headingAlternate' with {
                        params: {
                            tag: 'h2',
                            heading: entry.heading,
                            colour: 'base',
                            size: '5xl',
                            alternateStyle: 'base',
                            class: blockClasses.heading|join(' ')|trim
                        }
                    } only %}

                    {% if hasText %}

                        <div class="{{ blockClasses.text }}">

                            {% include '_components/richText' with {
                                params: {
                                    content: entry.text,
                                    colour: 'black',
                                    size: 'base'
                                }
                            } only %}

                        </div>

                    {% endif %}

                </div>

            {% endif %}

            {% if cards|length %}

                <div class="{{ blockClasses.grid|join(' ')|trim }}">

                    {% for card in cards %}

                        {% include '_components/iconCard' with {
                            params: {
                                card: card,
                                size: 'sm'
                            }
                        } only %}

                    {% endfor %}

                </div>

            {% endif %}

            {% if hasFooter %}

                <div class="{{ blockClasses.footer }}">

                    {% include '_components/button' with {
                        params: {
                            button: entry.button
                        }
                    } only %}

                    {% if avatar.avatarName|length %}

                        {% include '_components/user' with {
                            params: {
                                image: avatar.avatar.one(),
                                heading: avatar.avatarName,
                                subHeading: avatar.avatarJobRole,
                                size: 'sm'
                            }
                        } only %}

                    {% endif %}

                </div>

            {% endif %}

        {% endblock %}
    {% endembed %}

{% endif %}
