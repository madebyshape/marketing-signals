{# Block Defaults #}

{% set blockDefaults = {
    handle: entry.type.handle,
    padding: entry.padding|length ? entry.padding.value : 'topBottom',
} %}

{# Merge Defaults #}

{% set params = (params is defined and params is iterable) ? blockDefaults|merge(params) : blockDefaults %}

{# Stacking Cards #}

{% set cards = entry.stackingCards.all()|filter(card => card.heading|striptags|trim|length) %}
{% set stacked = cards|length > 1 %}

{% set component = entry.type.handle %}

{# Options #}

{% set blockOptions = {
    scheme: [
        {
            card: 'bg-white',
            heading: 'base',
            text: 'black',
            button: 'creme-300-outline',
            tilt: 'lg:rotate-2'
        },
        {
            card: 'bg-black',
            heading: 'fluro',
            text: 'white',
            button: 'white-30-outline',
            tilt: 'lg:-rotate-1'
        },
        {
            card: 'bg-secondary',
            heading: 'base',
            text: 'black',
            button: 'black-outline',
            tilt: 'lg:rotate-0'
        },
        {
            card: 'bg-fluro',
            heading: 'base',
            text: 'black',
            button: 'black-outline',
            tilt: 'lg:-rotate-2'
        }
    ],
    sizes: {
        column: '100vw',
        row: '(min-width: 1024px) 25vw, 100vw'
    }
} %}

{# Classes #}

{# `stacked` classes carry no group pipe: Alpine reads them as a class list. #}

{% set blockClasses = {
    grid: [
        'grid grid-cols-1',
        '|',
        'motion-safe:lg:grid-cols-12 motion-safe:lg:gap-5'
    ],
    header: 'motion-safe:lg:col-span-4',
    heading: 'font-semibold leading-0.97 tracking-tighter | motion-safe:lg:text-7xl',
    text: 'max-w-[365px] mt-7.5',
    pile: [
        'flex flex-col gap-5 mt-10',
        '|',
        'motion-safe:lg:col-start-5 motion-safe:lg:col-span-8 motion-safe:lg:mt-0'
    ],
    card: {
        base: 'relative flex flex-col overflow-hidden rounded-[20px]',
        row: 'motion-safe:lg:flex-row'
    },
    slot: [
        'relative overflow-hidden m-1.25 rounded-[15px] aspect-[4/3]',
        '|',
        'motion-safe:lg:w-[36%] motion-safe:lg:shrink-0 motion-safe:lg:aspect-auto'
    ],
    image: {
        base: 'absolute inset-0',
        shown: 'opacity-100',
        hidden: 'opacity-0',
        hook: 'js-stacking-cards-image',
        column: 'motion-safe:lg:hidden',
        row: 'hidden | motion-safe:lg:block'
    },
    content: [
        'flex flex-1 flex-col justify-center p-7.5',
        '|',
        'motion-safe:lg:p-25'
    ],
    cardHeading: 'font-semibold leading-0.97 tracking-tighter | motion-safe:lg:text-5xl',
    cardText: 'mt-6.25',
    cardButton: 'mt-7.5',
    footer: [
        'flex flex-wrap items-center gap-5 mt-10',
        '|',
        'motion-safe:lg:col-start-5 motion-safe:lg:col-span-8 motion-safe:lg:mt-15 motion-safe:lg:justify-center'
    ],
    stacked: {
        frame: 'lg:h-screen lg:content-center-safe',
        pile: 'lg:grid lg:grid-cols-1 lg:grid-rows-1 lg:gap-0',
        card: 'lg:col-start-1 lg:row-start-1'
    }
} %}

{# Output #}

{% if cards|length %}

    {% embed '_components/section'
        with {
            params: params|merge({
                paddingY: params.padding,
            })
        }
    %}
        {% block sectionContent %}

            <div
                class="{{ blockClasses.grid|join(' ')|trim }}"
                x-data="{{ component }}"
                {% if stacked %}x-bind:class="{ '{{ blockClasses.stacked.frame }}': stacked }"{% endif %}
                x-ref="frame"
            >

                {% if entry.heading|striptags|trim|length %}

                    <div class="{{ blockClasses.header }}">

                        {% include '_components/headingAlternate' with {
                            params: {
                                heading: entry.heading,
                                size: '5xl',
                                class: blockClasses.heading
                            }
                        } only %}

                        {% if entry.text|striptags|trim|length %}

                            {% include '_components/richText' with {
                                params: {
                                    content: entry.text,
                                    colour: 'black',
                                    class: blockClasses.text
                                }
                            } only %}

                        {% endif %}

                    </div>

                {% endif %}

                <div
                    class="{{ blockClasses.pile|join(' ')|trim }}"
                    {% if stacked %}x-bind:class="{ '{{ blockClasses.stacked.pile }}': stacked }"{% endif %}
                    x-ref="pile"
                >

                    {% for card in cards %}

                        {% set scheme = cycle(blockOptions.scheme, loop.index0) %}

                        {% set cardClasses = [
                            blockClasses.card.base,
                            scheme.card,
                            '|',
                            blockClasses.card.row
                        ] %}

                        <div
                            class="{{ cardClasses|join(' ')|trim }}"
                            {% if stacked %}x-bind:class="{ '{{ blockClasses.stacked.card }} {{ scheme.tilt }}': stacked }"{% endif %}
                        >

                            <div class="{{ blockClasses.slot|join(' ')|trim }}">

                                {% for image in card.images.all() %}

                                    <div class="{{ [
                                        blockClasses.image.base,
                                        loop.first ? blockClasses.image.shown : blockClasses.image.hidden,
                                        '||',
                                        blockClasses.image.hook
                                    ]|join(' ')|trim }}">

                                        {% include '_components/picture' with {
                                            params: {
                                                image: image,
                                                alt: '',
                                                transform: '4x3',
                                                ratio: false,
                                                focalPoint: true,
                                                sizes: blockOptions.sizes.column,
                                                wrapperClass: blockClasses.image.column
                                            }
                                        } only %}

                                        {% include '_components/picture' with {
                                            params: {
                                                image: image,
                                                alt: '',
                                                transform: '3x4',
                                                ratio: false,
                                                focalPoint: true,
                                                sizes: blockOptions.sizes.row,
                                                wrapperClass: blockClasses.image.row
                                            }
                                        } only %}

                                    </div>

                                {% endfor %}

                            </div>

                            <div class="{{ blockClasses.content|join(' ')|trim }}">

                                {% include '_components/headingAlternate' with {
                                    params: {
                                        tag: 'h3',
                                        heading: card.heading,
                                        colour: scheme.heading,
                                        size: '4xl',
                                        class: blockClasses.cardHeading
                                    }
                                } only %}

                                {% if card.text|striptags|trim|length %}

                                    {% include '_components/richText' with {
                                        params: {
                                            content: card.text,
                                            colour: scheme.text,
                                            class: blockClasses.cardText
                                        }
                                    } only %}

                                {% endif %}

                                {% if card.button|length %}

                                    <div class="{{ blockClasses.cardButton }}">

                                        {# Focus scrolls the pinned frame back to the card, so a tabbed button is never off screen. #}

                                        {% include '_components/button' with {
                                            params: {
                                                button: card.button,
                                                colour: scheme.button,
                                                attributes: 'x-on:focus="focusCard(' ~ loop.index0 ~ ')"'
                                            }
                                        } only %}

                                    </div>

                                {% endif %}

                            </div>

                        </div>

                    {% endfor %}

                </div>

                {% set avatar = entry.avatarGroup %}

                {% if entry.button|length or avatar.avatarName|length %}

                    <div class="{{ blockClasses.footer|join(' ')|trim }}">

                        {% include '_components/button' with {
                            params: {
                                button: entry.button,
                                colour: 'secondary'
                            }
                        } only %}

                        {% if avatar.avatarName|length %}

                            {% include '_components/user' with {
                                params: {
                                    image: avatar.avatar.one(),
                                    heading: avatar.avatarName,
                                    subHeading: avatar.avatarJobRole,
                                    size: 'sm'
                                }
                            } only %}

                        {% endif %}

                    </div>

                {% endif %}

            </div>

        {% endblock %}
    {% endembed %}

{% endif %}

{# prettier-ignore-start #}
{% js %}

    document.addEventListener('alpine:init', () => {
        Alpine.data('{{ component }}', () => {

            // Scroll per card as a share of viewport height; everything below is derived from it.
            const SCROLL_PER_CARD = 0.85;

            // Pixels past the top edge so a rotated card's rounding never leaves a sliver.
            const CLEARANCE = 24;

            // Image Cycle hold and cross-fade, in seconds.
            const IMAGE_HOLD = 3;
            const IMAGE_FADE = 0.8;

            // A hook class, not a ref: every card has its own set of images.
            const IMAGE = '.{{ blockClasses.image.hook }}';

            // Held outside the data object so Alpine doesn't make it reactive.
            let trigger = null;

            return {
                stacked: false,
                init() {

                    const media = gsap.matchMedia();

                    media.add('(min-width: 1024px) and (prefers-reduced-motion: no-preference)', (context) => {

                        if (this.$refs.pile.children.length < 2) {
                            return;
                        }

                        this.stacked = true;

                        // Next tick so the cards are measured in the stacked cell Alpine has just written.
                        this.$nextTick(() => context.add(() => {

                            const cards = Array.from(this.$refs.pile.children);

                            // Counts down so the first card is on top; paint order would put the last on top.
                            gsap.set(cards, { zIndex: (index) => cards.length - index });

                            const timeline = gsap.timeline({
                                scrollTrigger: {
                                    trigger: this.$refs.frame,
                                    pin: this.$refs.frame,
                                    start: 'top top',
                                    end: () => '+=' + this.end(cards.length),
                                    scrub: true,
                                    invalidateOnRefresh: true
                                }
                            });

                            // One unit per card, in sequence; the last card arrives and stays.
                            cards.slice(0, -1).forEach((card, index) => {
                                timeline.to(card, {
                                    y: () => -this.travel(card),
                                    ease: 'none',
                                    duration: 1
                                }, index);
                            });

                            // An empty unit holds the pile on the last card before the frame releases.
                            timeline.to({}, { duration: 1 });

                            trigger = timeline.scrollTrigger;

                        }));

                        return () => {

                            this.stacked = false;
                            trigger = null;

                            // clearProps because GSAP leaves the rotate tilt behind as inline style.
                            gsap.set(Array.from(this.$refs.pile.children), { clearProps: 'all' });

                        };

                    });

                    media.add('(prefers-reduced-motion: no-preference)', () => {

                        Array.from(this.$refs.pile.children).forEach((card) => {

                            const images = card.querySelectorAll(IMAGE);

                            if (images.length < 2) {
                                return;
                            }

                            const timeline = gsap.timeline({ repeat: -1, paused: true });

                            images.forEach((image, index) => {

                                timeline
                                    .to(image, {
                                        opacity: 0,
                                        duration: IMAGE_FADE,
                                        ease: 'none'
                                    }, (index + 1) * IMAGE_HOLD)
                                    .to(images[(index + 1) % images.length], {
                                        opacity: 1,
                                        duration: IMAGE_FADE,
                                        ease: 'none'
                                    }, '<');

                            });

                            // Pin length keeps the cycle running while pinned; refreshPriority -1 measures after Pins above.
                            ScrollTrigger.create({
                                trigger: card,
                                start: 'top bottom',
                                end: () => '+=' + (window.innerHeight + card.offsetHeight + this.hold()),
                                refreshPriority: -1,
                                onToggle: (self) => (self.isActive ? timeline.play() : timeline.pause())
                            });

                        });

                    });

                },
                hold() {

                    return this.stacked ? this.end(this.$refs.pile.children.length) : 0;

                },
                step() {

                    return SCROLL_PER_CARD * window.innerHeight;

                },
                end(count) {

                    return count * this.step();

                },
                travel(card) {

                    // Bounding box, not offsetHeight: a tilted card hangs below its upright box.
                    return ((window.innerHeight + card.getBoundingClientRect().height) / 2) + CLEARANCE;

                },
                focusCard(index) {

                    if (!trigger) {
                        return;
                    }

                    // Lenis owns the page's scroll, so the move goes through it.
                    window.lenis.scrollTo(trigger.start + index * this.step());

                    // Hidden overflow still scrolls; stop the browser shunting the frame sideways to reveal focus.
                    this.$refs.frame.scrollLeft = 0;

                }
            };

        })
    })

{% endjs %}
{# prettier-ignore-end #}
