{# Block Defaults #}

{% set blockDefaults = {
    handle: entry.type.handle,
    padding: entry.padding|length ? entry.padding.value : 'topBottom',
} %}

{# Merge Defaults #}

{% set params = (params is defined and params is iterable) ? blockDefaults|merge(params) : blockDefaults %}

{# Clients #}

{% set clients = [] %}

{% for client in entry.entriesClient.all() %}

    {% set logo = client.logo.one() %}

    {% if logo %}

        {% set clients = clients|merge([{
            title: client.title,
            logo: logo
        }]) %}

    {% endif %}

{% endfor %}

{# Logo Rows #}

{# Each row repeats its Clients to 6+ cells so the widest viewport never shows a gap #}

{% set split = (clients|length / 2)|round(0, 'ceil') %}

{% set logoRows = [
    clients|slice(0, split),
    clients|slice(split)
] %}

{% set cellMinimum = 6 %}

{# 0.4 on the marquee's scale is 40px a second #}

{% set crawlSpeed = 0.4 %}

{# Options #}

{# Cells draw top and left edges only, so the two rows share lines and no border doubles #}

{% set blockOptions = {
    row: {
        first: {
            offset: 'ml-0',
            reversed: false,
            cell: 'border-t border-l'
        },
        second: {
            offset: '-ml-[90px] | md:-ml-[120px] lg:-ml-[160px]',
            reversed: true,
            cell: 'border-t border-b border-l'
        }
    }
} %}

{# Classes #}

{# The 2000ms is the hover fade-out; hover itself shortens it to 150ms so the fill arrives at once #}

{% set blockClasses = {
    margin: vars is defined ? vars.class.siteMargin.x : 'px-10',
    header: [
        'text-center mb-10',
        '|',
        'lg:mb-17.5'
    ],
    eyebrow: 'mb-7.5',
    heading: [
        'mx-auto max-w-[1010px] font-semibold leading-0.97 tracking-tighter',
        '|',
        'md:text-6xl | lg:text-8xl'
    ],
    rows: 'w-full overflow-hidden',
    cell: [
        'flex size-[180px] shrink-0 items-center justify-center border-creme-400 text-black transition-colors duration-2000 ease-out',
        '|',
        'pointer-fine:hover:bg-black pointer-fine:hover:text-fluro pointer-fine:hover:duration-150',
        '|',
        'md:size-[240px] | lg:size-[320px]'
    ],
    logo: 'h-auto max-h-[20%] w-auto max-w-[40%]',
    footer: [
        'flex flex-wrap items-center justify-center gap-5 mt-10',
        '|',
        'lg:mt-12.5'
    ]
} %}

{# Output #}

{% if clients|length >= 2 %}

    {% embed '_components/section'
        with {
            params: params|merge({
                paddingY: params.padding,
                paddingX: 'none'
            })
        }
    %}
        {% block sectionContent %}

            {% set hasEyebrow = entry.eyebrow|trim|length > 0 %}
            {% set hasHeading = entry.heading|striptags|trim|length > 0 %}

            {% if hasEyebrow or hasHeading %}

                <div class="{{ blockClasses.margin }} {{ blockClasses.header|join(' ')|trim }}">

                    {% if hasEyebrow %}

                        {% include '_components/eyebrow' with {
                            params: {
                                text: entry.eyebrow,
                                colour: 'black',
                                class: hasHeading ? blockClasses.eyebrow : ''
                            }
                        } only %}

                    {% endif %}

                    {% if hasHeading %}

                        {% include '_components/headingAlternate' with {
                            params: {
                                tag: 'h2',
                                heading: entry.heading,
                                colour: 'base',
                                size: '4xl',
                                alternateStyle: 'base',
                                class: blockClasses.heading|join(' ')|trim
                            }
                        } only %}

                    {% endif %}

                </div>

            {% endif %}

            {# The rows repeat each Client, so this list names each once for screen readers #}

            <ul class="sr-only">

                {% for client in clients %}

                    <li>{{ client.title }}</li>

                {% endfor %}

            </ul>

            <div
                class="{{ blockClasses.rows }}"
                aria-hidden="true"
            >

                {% for row in logoRows %}

                    {% set rowStyle = loop.first ? blockOptions.row.first : blockOptions.row.second %}
                    {% set repeats = (cellMinimum / row|length)|round(0, 'ceil') %}

                    {# Offset on the wrapper, not the marquee: an unsized block widens by its negative margin #}

                    <div class="{{ rowStyle.offset }}">

                        {% embed '_components/marquee' with {
                            params: {
                                component: params.handle ~ loop.index,
                                gap: 'none',
                                props: {
                                    reversed: rowStyle.reversed,
                                    speed: crawlSpeed,
                                    pauseOnHover: true
                                }
                            }
                        } %}
                            {% block marqueeContent %}

                                {% for repeat in 1..repeats %}

                                    {% for client in row %}

                                        <div class="{{ [rowStyle.cell]|merge(blockClasses.cell)|join(' ')|trim }}">

                                            {% include '_components/picture' with {
                                                params: {
                                                    image: client.logo,
                                                    alt: '',
                                                    transform: 'noRatio',
                                                    ratio: false,
                                                    lazy: false,
                                                    svgInline: true,
                                                    imgClass: blockClasses.logo
                                                }
                                            } only %}

                                        </div>

                                    {% endfor %}

                                {% endfor %}

                            {% endblock %}
                        {% endembed %}

                    </div>

                {% endfor %}

            </div>

            {% set avatar = entry.avatarGroup %}

            {% if entry.button|length or avatar.avatarName|length %}

                <div class="{{ blockClasses.margin }}">

                    <div class="{{ blockClasses.footer|join(' ')|trim }}">

                        {% include '_components/button' with {
                            params: {
                                button: entry.button,
                                colour: 'secondary'
                            }
                        } only %}

                        {% if avatar.avatarName|length %}

                            {% include '_components/user' with {
                                params: {
                                    image: avatar.avatar.one(),
                                    heading: avatar.avatarName,
                                    subHeading: avatar.avatarJobRole,
                                    colour: 'base',
                                    size: 'sm'
                                }
                            } only %}

                        {% endif %}

                    </div>

                </div>

            {% endif %}

        {% endblock %}
    {% endembed %}

{% endif %}
