{# Block Defaults #}

{% set blockDefaults = {
    handle: entry.type.handle,
    padding: entry.padding|length ? entry.padding.value : 'topBottom',
} %}

{# Merge Defaults #}

{% set params = (params is defined and params is iterable) ? blockDefaults|merge(params) : blockDefaults %}

{# Clients #}

{# A Client is a title and a Logo, and a Logo is what a Logo Cell shows, so a Client without one
   is left out of the rows and out of the list a screen reader hears. The Logo is resolved once
   here rather than again in the rows, where each Client is drawn several times over. #}

{% set clients = [] %}

{% for client in entry.entriesClient.all() %}

    {% set logo = client.logo.one() %}

    {% if logo %}

        {% set clients = clients|merge([{
            title: client.title,
            logo: logo
        }]) %}

    {% endif %}

{% endfor %}

{# Logo Rows #}

{# The Clients are split in listed order, the first half rounded up filling the first row. Each
   row then repeats its Clients in order until it holds at least six Logo Cells, so a row is at
   least 1920px wide at the desktop cell size and the widest supported viewport never shows a
   gap at the end of it. #}

{% set split = (clients|length / 2)|round(0, 'ceil') %}

{% set logoRows = [
    clients|slice(0, split),
    clients|slice(split)
] %}

{% set cellMinimum = 6 %}

{# Options #}

{# The two rows differ in where they start and which edges they draw. The first row starts at the
   viewport's left edge; the second is shifted left by half a cell so the two read as brickwork
   rather than a grid. Every cell draws its top and left edges, and a second-row cell its bottom
   too, so the two rows together draw the design's grid: the line between them is the second
   row's top edge alone, and no border is ever doubled. #}

{% set blockOptions = {
    row: {
        first: {
            track: '',
            cell: 'border-t border-l'
        },
        second: {
            track: '-ml-[90px] | md:-ml-[120px] lg:-ml-[160px]',
            cell: 'border-t border-b border-l'
        }
    }
} %}

{# Classes #}

{# `classes` is the name the embedded section uses for its own map, so the Block's classes are
   named apart from it. The section's horizontal padding is off: the Section Header and Section
   Footer carry the site margin themselves and the Logo Rows run edge to edge without it.

   The header carries the gap to the rows on its own bottom margin, so a Block with no Eyebrow
   and no heading takes that spacing with it and the rows sit at the top of the section. The
   Eyebrow's own margin is only there when a heading follows it.

   A row is wider than the viewport by design and the second starts outside it, so the rows are
   clipped by their wrapper rather than pushing the page sideways. #}

{% set blockClasses = {
    margin: vars is defined ? vars.class.siteMargin.x : 'px-10',
    header: [
        'text-center mb-10',
        '|',
        'lg:mb-17.5'
    ],
    eyebrow: 'mb-7.5',
    heading: [
        'mx-auto max-w-[1010px] font-semibold leading-0.97 tracking-tighter',
        '|',
        'md:text-6xl | lg:text-8xl'
    ],
    rows: 'w-full overflow-hidden',
    track: [
        'flex'
    ],
    cell: [
        'flex size-[180px] shrink-0 items-center justify-center border-creme-400 text-black',
        '|',
        'md:size-[240px] | lg:size-[320px]'
    ],
    logo: 'h-auto max-h-[20%] w-auto max-w-[40%]',
    footer: [
        'flex flex-wrap items-center justify-center gap-5 mt-10',
        '|',
        'lg:mt-12.5'
    ]
} %}

{# Output #}

{# One Client is a single Logo Cell and an empty second row, which is not a marquee, so the field
   asks for two and a Block left with fewer renderable Clients renders nothing at all, section
   included. #}

{% if clients|length >= 2 %}

    {% embed '_components/section'
        with {
            params: params|merge({
                paddingY: params.padding,
                paddingX: 'none'
            })
        }
    %}
        {% block sectionContent %}

            {% set hasEyebrow = entry.eyebrow|trim|length > 0 %}
            {% set hasHeading = entry.heading|striptags|trim|length > 0 %}

            {% if hasEyebrow or hasHeading %}

                <div class="{{ blockClasses.margin }} {{ blockClasses.header|join(' ')|trim }}">

                    {# An empty Eyebrow drops its row, and an empty heading drops its own. #}

                    {% if hasEyebrow %}

                        {% include '_components/eyebrow' with {
                            params: {
                                text: entry.eyebrow,
                                colour: 'black',
                                class: hasHeading ? blockClasses.eyebrow : ''
                            }
                        } only %}

                    {% endif %}

                    {% if hasHeading %}

                        {% include '_components/headingAlternate' with {
                            params: {
                                tag: 'h2',
                                heading: entry.heading,
                                colour: 'base',
                                size: '4xl',
                                alternateStyle: 'base',
                                class: blockClasses.heading|join(' ')|trim
                            }
                        } only %}

                    {% endif %}

                </div>

            {% endif %}

            {# Every cell repeats and the Clients are split across two rows, so reading the rows
               out would name each Client several times over and in an order nobody sees. The
               rows are hidden from assistive technology and this list stands in for them,
               naming each renderable Client once, in the order the editor set. #}

            <ul class="sr-only">

                {% for client in clients %}

                    <li>{{ client.title }}</li>

                {% endfor %}

            </ul>

            <div
                class="{{ blockClasses.rows }}"
                aria-hidden="true"
            >

                {% for row in logoRows %}

                    {% set rowStyle = loop.first ? blockOptions.row.first : blockOptions.row.second %}
                    {% set repeats = (cellMinimum / row|length)|round(0, 'ceil') %}

                    <div class="{{ blockClasses.track|merge([rowStyle.track])|join(' ')|trim }}">

                        {% for repeat in 1..repeats %}

                            {% for client in row %}

                                <div class="{{ [rowStyle.cell]|merge(blockClasses.cell)|join(' ')|trim }}">

                                    {# The Logo is written into the page rather than linked, so it
                                       takes the cell's text colour and the next ticket's hover
                                       fill has something to recolour. It is capped at 40% of the
                                       cell's width and 20% of its height, which is the room the
                                       design leaves around the widest and the tallest of them.
                                       The rows are hidden from assistive technology, so the Logo
                                       carries no alt of its own. #}

                                    {% include '_components/picture' with {
                                        params: {
                                            image: client.logo,
                                            alt: '',
                                            transform: 'noRatio',
                                            ratio: false,
                                            lazy: false,
                                            svgInline: true,
                                            imgClass: blockClasses.logo
                                        }
                                    } only %}

                                </div>

                            {% endfor %}

                        {% endfor %}

                    </div>

                {% endfor %}

            </div>

            {# A button with no link, or an Avatar Group with no name, drops that item; both
               missing drops the row. #}

            {% set avatar = entry.avatarGroup %}

            {% if entry.button|length or avatar.avatarName|length %}

                <div class="{{ blockClasses.margin }}">

                    <div class="{{ blockClasses.footer|join(' ')|trim }}">

                        {% include '_components/button' with {
                            params: {
                                button: entry.button,
                                colour: 'secondary'
                            }
                        } only %}

                        {% if avatar.avatarName|length %}

                            {% include '_components/user' with {
                                params: {
                                    image: avatar.avatar.one(),
                                    heading: avatar.avatarName,
                                    subHeading: avatar.avatarJobRole,
                                    colour: 'base',
                                    size: 'sm'
                                }
                            } only %}

                        {% endif %}

                    </div>

                </div>

            {% endif %}

        {% endblock %}
    {% endembed %}

{% endif %}
