{# Block Defaults #}

{% set blockDefaults = {
    handle: entry.type.handle,
    padding: entry.padding|length ? entry.padding.value : 'topBottom',
} %}

{# Merge Defaults #}

{% set params = (params is defined and params is iterable) ? blockDefaults|merge(params) : blockDefaults %}

{# Branding Columns #}

{% set columns = entry.columns.all()|filter(column =>
    column.eyebrow|trim|length
    or column.text|striptags|trim|length
    or column.image.one()
    or column.icons.all()|filter(item => item.icon|trim|split(' ')|last|trim not in ['', 'fa-'])|length
    or column.buttonGroup.all()|length
) %}

{# Options #}

{% set blockOptions = {
    scheme: [
        {
            panel: 'bg-black',
            eyebrow: 'white',
            rule: 'white-30',
            text: 'creme-400',
            buttons: ['secondary', 'white-30-outline']
        },
        {
            panel: 'bg-white',
            eyebrow: 'black',
            rule: 'creme-400',
            text: 'black',
            buttons: ['secondary', 'creme-300-outline']
        }
    ]
} %}

{# Classes #}

{% set blockClasses = {
    grid: 'grid grid-cols-12 gap-5',
    column: {
        base: 'col-span-12 flex flex-col rounded-[20px] p-7.5',
        responsive: 'md:p-10 lg:col-span-6'
    },
    text: 'mt-5 | md:mt-7.5',
    image: 'mt-7.5 | md:mt-10',
    imageInner: 'h-auto w-full rounded-[20px]',
    icons: 'grid grid-cols-4 justify-items-center gap-y-10 | md:gap-y-15',
    icon: 'fa-sharp-duotone fa-light text-[40px] text-primary [--fa-secondary-opacity:0.2] | md:text-[50px]',
    afterPart: 'mt-10 | md:mt-15'
} %}

{# Output #}

{% if columns|length %}

    {% embed '_components/section'
        with {
            params: params|merge({
                paddingY: params.padding,
            })
        }
    %}
        {% block sectionContent %}

            <div class="{{ blockClasses.grid }}">

                {% for column in columns %}

                    {% set scheme = cycle(blockOptions.scheme, loop.index0) %}
                    {% set hasEyebrow = column.eyebrow|trim|length > 0 %}
                    {% set hasText = column.text|striptags|trim|length > 0 %}
                    {% set image = column.image.one() %}
                    {% set icons = [] %}

                    {# The last word with any `fa-` prefix dropped, as the Icon Card reads it. #}

                    {% for item in column.icons.all() %}
                        {% set icon = item.icon|trim|split(' ')|last|trim %}
                        {% set icon = icon starts with 'fa-' ? icon|slice(3) : icon %}
                        {% set icons = icon|length ? icons|merge([icon]) : icons %}
                    {% endfor %}

                    {% set buttons = column.buttonGroup.all() %}

                    <div class="{{ [blockClasses.column.base, scheme.panel, '|', blockClasses.column.responsive]|join(' ')|trim }}">

                        {% if hasEyebrow %}

                            {% include '_components/eyebrow' with {
                                params: {
                                    text: column.eyebrow,
                                    tag: 'h2',
                                    colour: scheme.eyebrow,
                                    rule: true,
                                    ruleColour: scheme.rule
                                }
                            } only %}

                        {% endif %}

                        {% if hasText %}

                            {% include '_components/richText' with {
                                params: {
                                    content: column.text,
                                    colour: scheme.text,
                                    size: 'sm',
                                    class: hasEyebrow ? blockClasses.text
                                }
                            } only %}

                        {% endif %}

                        {% if image %}

                            <div class="{{ (hasEyebrow or hasText) ? blockClasses.image }}">

                                {% include '_components/picture' with {
                                    params: {
                                        image: image,
                                        alt: image.alt,
                                        transform: 'noRatio',
                                        ratio: false,
                                        sizes: '(min-width: 1024px) 50vw, 100vw',
                                        imgClass: blockClasses.imageInner
                                    }
                                } only %}

                            </div>

                        {% endif %}

                        {% if icons|length %}

                            <div class="{{ [blockClasses.icons, (hasEyebrow or hasText or image) ? blockClasses.afterPart]|join(' ')|trim }}">

                                {% for icon in icons %}

                                    <i
                                        class="{{ [blockClasses.icon, 'fa-' ~ icon]|join(' ') }}"
                                        aria-hidden="true"
                                    ></i>

                                {% endfor %}

                            </div>

                        {% endif %}

                        {% include '_components/buttonGroup' with {
                            params: {
                                buttons: buttons,
                                colours: scheme.buttons,
                                align: 'center',
                                class: (hasEyebrow or hasText or image or icons|length) ? blockClasses.afterPart
                            }
                        } only %}

                    </div>

                {% endfor %}

            </div>

        {% endblock %}
    {% endembed %}

{% endif %}
