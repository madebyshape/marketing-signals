{# Block Defaults #}

{% set blockDefaults = {
    handle: entry.type.handle,
    padding: entry.padding|length ? entry.padding.value : 'topBottom',
} %}

{# Merge Defaults #}

{% set params = (params is defined and params is iterable) ? blockDefaults|merge(params) : blockDefaults %}

{# Case Studies #}

{# One Slide per enabled Case Study the editor picked, in the field's order. A disabled Case
   Study has no page to link to, so it never becomes a Slide. #}

{% set caseStudies = entry.entriesCaseStudy.all() %}

{# Classes #}

{# `classes` is the name the embedded section uses for its own map, so the Block's classes are
   named apart from it. The section's horizontal padding is off and the Block places the panel
   itself: the site margin on the outside, then a black panel with the design's 20px corners
   clipping its own overflow, so the Slides are cut at its rounded edge.

   The rows carry their own bottom margin rather than sharing a gap, because each is only
   rendered when it has something to say: an empty Eyebrow or heading takes its spacing with it
   and the rows below close up.

   From `md` the row of Slides is pulled out to the panel's edges by negative margins the size of
   the side padding, so the Slides run under the padding and the neighbours peek to the panel's
   edge while the Eyebrow, heading and Controls stay inside it. Below `md` there is no pull-out
   and no neighbour to show, so the one card is the panel's inner width and lines up with the
   heading above it. The carousel component's wrapper is full width, and a percentage width is
   read from the padded box whatever the margins do, so the pull-out comes with `w-auto` to let
   the wrapper take the width its negative margins give it. Served, Swiper's own layout stands:
   the Slides in a row from the panel's left edge, clipped at the panel, the Controls visible but
   inert.

   The card is 3x4 portrait below `md` and 16x10 landscape from `md`, which makes it the design's
   750 by 469 at 1600. The Thumbnail fills it at 90% under two shades, the top one fading from
   black at half to nothing over the first 37% and the bottom one from nothing to black at four
   fifths over the last 46%, as the node's two gradient assets measure. #}

{% set blockClasses = {
    margin: vars is defined ? vars.class.siteMargin.x : 'px-10',
    panel: [
        'overflow-hidden rounded-[20px] bg-black px-5 py-10',
        '|',
        'lg:px-12.5 lg:py-25'
    ],
    eyebrow: [
        'mb-7.5',
        '|',
        'lg:mb-12.5'
    ],
    headingRow: [
        'mb-7.5',
        '|',
        'lg:mb-15 lg:grid lg:grid-cols-12 lg:gap-5'
    ],
    heading: [
        'font-semibold leading-0.97 tracking-tighter',
        '|',
        'md:text-6xl | lg:col-span-8 lg:text-7xl'
    ],
    carousel: [
        'md:-mx-5 md:w-auto',
        '|',
        'lg:-mx-12.5'
    ],
    controls: [
        'mt-7.5',
        '|',
        'lg:mt-12.5'
    ],
    card: 'relative block w-full overflow-hidden rounded-[20px] bg-black',
    thumbnail: {
        portrait: [
            'opacity-90',
            '|',
            'md:hidden'
        ],
        landscape: [
            'hidden opacity-90',
            '|',
            'md:block'
        ]
    },
    placeholder: [
        'aspect-[3/4]',
        '|',
        'md:aspect-[16/10]'
    ],
    shadeTop: 'absolute inset-x-0 top-0 z-10 h-[37%] bg-linear-to-b from-black/50 to-transparent',
    shadeBottom: 'absolute inset-x-0 bottom-0 z-10 h-[46%] bg-linear-to-t from-black/80 to-transparent',
    badge: [
        'absolute left-5 top-5 z-20',
        '|',
        'lg:left-7.5 lg:top-7.5'
    ],
    logo: 'absolute inset-0 z-20 flex items-center justify-center',
    logoImage: 'h-auto max-h-[20%] w-auto max-w-[30%]',
    tagLine: [
        'absolute inset-x-5 bottom-5 z-20',
        '|',
        'lg:inset-x-10 lg:bottom-10'
    ],
    tagLineText: [
        'font-medium leading-1.2 tracking-tighter',
        '|',
        'lg:text-3xl'
    ]
} %}

{# Output #}

{# A Block with no Case Studies renders nothing at all, section included. #}

{% if caseStudies|length %}

    {% embed '_components/section'
        with {
            params: params|merge({
                paddingY: params.padding,
                paddingX: 'none'
            })
        }
    %}
        {% block sectionContent %}

            <div class="{{ blockClasses.margin }}">

                <div class="{{ blockClasses.panel|join(' ')|trim }}">

                    {# An empty Eyebrow drops the whole row, Rule included. #}

                    {% if entry.eyebrow|trim|length %}

                        {% include '_components/eyebrow' with {
                            params: {
                                text: entry.eyebrow,
                                colour: 'white',
                                rule: true,
                                ruleColour: 'white-30',
                                class: blockClasses.eyebrow|join(' ')|trim
                            }
                        } only %}

                    {% endif %}

                    {# An empty heading drops its row. The heading takes the first eight of the
                       panel's twelve columns from `lg` and the full width below. #}

                    {% if entry.heading|striptags|trim|length %}

                        <div class="{{ blockClasses.headingRow|join(' ')|trim }}">

                            {% include '_components/headingAlternate' with {
                                params: {
                                    tag: 'h2',
                                    heading: entry.heading,
                                    colour: 'creme-100',
                                    size: '4xl',
                                    alternateStyle: 'secondary',
                                    class: blockClasses.heading|join(' ')|trim
                                }
                            } only %}

                        </div>

                    {% endif %}

                    {# The carousel component owns the Alpine scope, so the Controls go in its
                       after-content slot where their `prev` and `next` refs resolve, and the
                       Slides in its slide slot. Swiper writes each Slide's width itself from
                       `slidesPerView`, so the Block sets the counts and the gap and nothing else
                       measures the row.

                       Looping needs more Slides than the row shows at once to have something to
                       wrap, and two per view makes three the floor: two Case Studies page to
                       their ends and dim the button there instead. #}

                    {% embed '_components/carousel'
                        with {
                            params: {
                                id: params.handle,
                                items: caseStudies,
                                tag: 'ul',
                                slideTag: 'li',
                                ease: 'smooth',
                                class: blockClasses.carousel|join(' ')|trim,
                                props: {
                                    centeredSlides: true,
                                    slidesPerView: 1,
                                    spaceBetween: 20,
                                    speed: 600,
                                    loop: caseStudies|length >= 3,
                                    simulateTouch: true,
                                    allowTouchMove: true,
                                    preventClicks: true,
                                    preventClicksPropagation: true,
                                    breakpoints: {
                                        768: { slidesPerView: 1.5 },
                                        1024: { slidesPerView: 2 }
                                    },
                                    a11y: {
                                        enabled: true,
                                        containerRole: 'region'
                                    }
                                }
                            }
                        }
                    %}

                        {% block slideContent %}

                            {# The whole card is the link, so the Slide has one link and no link
                               inside it. Its accessible name is what the card holds — the
                               Category, the Logo's alt and the Tag Line — so no `aria-label`
                               overrides it.

                               Entering the card raises the Cursor Label the global layout mounts
                               and leaving lowers it, whether the Slide is the centre one or a
                               peeking neighbour; the event goes to the window, so the Block never
                               reaches for the cursor's markup. A coarse pointer fires these too
                               and the cursor component ignores them there, which is what leaves
                               the touch visitor a plain card and a tap. #}

                            <a
                                href="{{ item.url }}"
                                class="{{ blockClasses.card }}"
                                x-on:mouseenter="$dispatch('component-cursor', { active: true, text: 'View Case Study' })"
                                x-on:mouseleave="$dispatch('component-cursor', { active: false })"
                            >

                                {% set thumbnail = item.thumbnail.one() %}
                                {% set logo = item.logo.one() %}
                                {% set category = item.categoriesCaseStudy.one() %}

                                {# A Case Study without a Thumbnail renders its card on solid
                                   black, so the placeholder holds the card's shape in its place.
                                   The photograph is decorative: its alt is empty and the Logo
                                   names the client. #}

                                {% if thumbnail %}

                                    {% include '_components/picture' with {
                                        params: {
                                            image: thumbnail,
                                            alt: '',
                                            transform: '3x4',
                                            ratio: true,
                                            focalPoint: true,
                                            sizes: '85vw',
                                            wrapperClass: blockClasses.thumbnail.portrait|join(' ')|trim
                                        }
                                    } only %}

                                    {% include '_components/picture' with {
                                        params: {
                                            image: thumbnail,
                                            alt: '',
                                            transform: '16x10',
                                            ratio: true,
                                            focalPoint: true,
                                            sizes: '(min-width: 1024px) 47vw, 60vw',
                                            wrapperClass: blockClasses.thumbnail.landscape|join(' ')|trim
                                        }
                                    } only %}

                                {% else %}

                                    <div class="{{ blockClasses.placeholder|join(' ')|trim }}"></div>

                                {% endif %}

                                <div class="{{ blockClasses.shadeTop }}"></div>
                                <div class="{{ blockClasses.shadeBottom }}"></div>

                                {# A Case Study with no Logo shows the Thumbnail and the Tag Line
                                   alone. The Logo is the Slide's visible title, so its alt is the
                                   Case Study's. #}

                                {% if logo %}

                                    <div class="{{ blockClasses.logo }}">

                                        {% include '_components/picture' with {
                                            params: {
                                                image: logo,
                                                alt: item.title,
                                                transform: 'noRatio',
                                                ratio: false,
                                                imgClass: blockClasses.logoImage
                                            }
                                        } only %}

                                    </div>

                                {% endif %}

                                {# The badge shows the first Category's title only. A Case Study
                                   with no Category shows no badge. #}

                                {% if category %}

                                    <div class="{{ blockClasses.badge|join(' ')|trim }}">

                                        {% include '_components/badge' with {
                                            params: {
                                                badge: category.title,
                                                colour: 'white-20',
                                                size: 'sm'
                                            }
                                        } only %}

                                    </div>

                                {% endif %}

                                {# A link inside the Slide's link is invalid HTML and a heading
                                   here would compete with the Block's, so the Tag Line keeps its
                                   italic Highlight, bold and line breaks and renders as a
                                   paragraph. #}

                                {% set tagLine = item.tagLine|striptags('<em><i><strong><b><br>') %}

                                {% if tagLine|striptags|trim|length %}

                                    <div class="{{ blockClasses.tagLine|join(' ')|trim }}">

                                        {% include '_components/headingAlternate' with {
                                            params: {
                                                tag: 'p',
                                                heading: tagLine,
                                                colour: 'white',
                                                size: '2xl',
                                                alternateStyle: 'fluro',
                                                class: blockClasses.tagLineText|join(' ')|trim
                                            }
                                        } only %}

                                    </div>

                                {% endif %}

                            </a>

                        {% endblock %}

                        {% block afterContent %}

                            {# One Case Study is a single static card: there is nowhere to page
                               to, so it gets no Controls and the carousel wires no navigation. #}

                            {% if caseStudies|length > 1 %}

                                {% include '_components/carouselControls' with {
                                    params: {
                                        class: blockClasses.controls|join(' ')|trim
                                    }
                                } only %}

                            {% endif %}

                        {% endblock %}

                    {% endembed %}

                </div>

            </div>

        {% endblock %}
    {% endembed %}

{% endif %}
