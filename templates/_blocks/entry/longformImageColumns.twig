<div class="w-full grid grid-cols-1 sm:grid-cols-12 gap-3">

    {% for image in entry.images.all() %}


        <div class="col-span-12 sm:col-span-6">
            <div class="aspect-4/3 sm:aspect-3/5 relative w-full">
                {% include '_components/picture' with {
                    params: {
                        image: image,
                        transform: '3x4',
                        ratio: false,
                        lazy: true,
                        imgClass: 'w-full h-full absolute top-0 left-0 object-cover rounded-[20px]'
                    }
                } only %}
            </div>
        </div>

    {% endfor %}

</div>