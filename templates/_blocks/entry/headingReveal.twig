{# Block Defaults #}

{% set blockDefaults = {
    handle: entry.type.handle,
    padding: entry.padding|length ? entry.padding.value : 'topBottom',
} %}

{# Merge Defaults #}

{% set params = (params is defined and params is iterable) ? blockDefaults|merge(params) : blockDefaults %}

{# Classes #}

{% set blockClasses = {
    heading: 'md:text-7xl | lg:text-9xl | 2xl:text-10xl'
} %}

{# Output #}

{% if entry.eyebrow|trim|length or entry.heading|striptags|trim|length %}

    {% embed '_components/section'
        with {
            params: params|merge({
                paddingY: params.padding,
            })
        }
    %}
        {% block sectionContent %}

            {% if entry.eyebrow|trim|length %}

                {% include '_components/eyebrow' with {
                    params: {
                        text: entry.eyebrow,
                        rule: true,
                        margin: 'bottom'
                    }
                } only %}

            {% endif %}

            {% include '_components/headingReveal' with {
                params: {
                    heading: entry.heading,
                    indent: 'columns',
                    class: blockClasses.heading
                }
            } only %}

        {% endblock %}
    {% endembed %}

{% endif %}
