{# Block Defaults #}

{% set blockDefaults = {
    handle: entry.type.handle,
    padding: entry.padding|length ? entry.padding.value : 'topBottom',
} %}

{# Merge Defaults #}

{% set params = (params is defined and params is iterable) ? blockDefaults|merge(params) : blockDefaults %}

{# Careers #}

{# Any pick, even a disabled one, stops the fallback to every enabled Career. #}

{% set careerIds = clone(entry.entriesCareer).status(null).exists()
    ? entry.entriesCareer.ids()
    : craft.entries.section('career').orderBy('postDate DESC').ids() %}

{% set prefix = params.handle ~ '-' ~ entry.id %}

{% set hasEyebrow = entry.eyebrow|trim|length > 0 %}
{% set hasHeading = entry.heading|striptags|trim|length > 0 %}

{# Classes #}

{% set blockClasses = {
    margin: vars is defined ? vars.class.siteMargin.x : 'px-10',
    panel: [
        'rounded-[20px] bg-black px-5 pt-10 pb-5',
        '|',
        'md:p-10 md:pt-15',
        '|',
        'lg:pt-25'
    ],
    eyebrow: 'mb-7.5 | lg:mb-12.5',
    content: 'grid gap-y-7.5 | lg:grid-cols-[1fr_auto] lg:items-end lg:gap-x-5 lg:gap-y-10',
    heading: [
        'font-semibold leading-0.97 tracking-tighter',
        '|',
        'md:text-5xl | lg:text-6xl'
    ],
    sprig: 'contents'
} %}

{# Output #}

{% if careerIds|length or hasHeading %}

    {% embed '_components/section'
        with {
            params: params|merge({
                paddingY: params.padding,
                paddingX: 'none'
            })
        }
    %}
        {% block sectionContent %}

            <div class="{{ blockClasses.margin }}">

                <div class="{{ blockClasses.panel|join(' ')|trim }}">

                    {% if hasEyebrow %}

                        {% include '_components/eyebrow' with {
                            params: {
                                text: entry.eyebrow,
                                colour: 'white',
                                rule: true,
                                ruleColour: 'white-30',
                                class: blockClasses.eyebrow
                            }
                        } only %}

                    {% endif %}

                    <div class="{{ blockClasses.content }}">

                        {% if hasHeading %}

                            {% include '_components/headingAlternate' with {
                                params: {
                                    tag: 'h2',
                                    heading: entry.heading,
                                    colour: 'creme-100',
                                    size: '4xl',
                                    alternateStyle: 'secondary',
                                    class: blockClasses.heading|join(' ')|trim
                                }
                            } only %}

                        {% endif %}

                        {# The wrapper steps aside so the filter and rows share the heading's grid. #}

                        {% if careerIds|length %}

                            {{ sprig('_sprig/careers', {
                                ids: careerIds|join(','),
                                prefix: prefix
                            }, {
                                id: prefix ~ '-sprig',
                                class: blockClasses.sprig
                            }) }}

                        {% endif %}

                    </div>

                </div>

            </div>

        {% endblock %}
    {% endembed %}

{% endif %}
