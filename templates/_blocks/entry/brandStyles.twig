{# Block Defaults #}

{% set blockDefaults = {
    handle: entry.type.handle,
    padding: entry.padding|length ? entry.padding.value : 'topBottom',
} %}

{# Merge Defaults #}

{% set params = (params is defined and params is iterable) ? blockDefaults|merge(params) : blockDefaults %}

{# Content #}

{% set buttons = entry.buttonGroup.all() %}

{% set hasHeading = entry.heading|striptags|trim|length > 0 %}
{% set hasText = entry.text|striptags|trim|length > 0 %}

{# The Swatches sit on a 24-column grid so Creme 200 and White can halve three of the 12 columns. #}

{% set swatches = [
    { label: '#0E0A10', class: 'col-span-2 h-50 bg-black text-white | lg:col-span-6 lg:row-span-3 lg:h-auto' },
    { label: '#F3F0E8', class: 'col-span-2 h-50 bg-creme-100 text-black | lg:col-span-6 lg:row-span-3 lg:h-auto' },
    { label: '#E9E6DE', class: 'h-50 bg-creme-200 text-black | lg:col-span-3 lg:row-span-3 lg:h-auto' },
    { label: '#FFFFFF', class: 'h-50 bg-white border border-black text-black | lg:col-span-3 lg:row-span-3 lg:h-auto' },
    { label: '#745CF6', class: 'col-span-2 h-29.75 bg-primary text-white | lg:col-span-6 lg:col-start-19 lg:row-start-1 lg:h-auto' },
    { label: '#AFAFFF', class: 'col-span-2 h-29.75 bg-secondary text-black | lg:col-span-6 lg:col-start-19 lg:row-start-2 lg:h-auto' },
    { label: '#DBFE87', class: 'col-span-2 h-29.75 bg-fluro text-black | lg:col-span-6 lg:col-start-19 lg:row-start-3 lg:h-auto' }
] %}

{# Classes #}

{% set blockClasses = {
    panels: 'flex flex-col gap-5',
    panel: 'rounded-[20px] bg-white p-7.5 | md:px-10 | lg:pt-18.5 lg:pb-19',
    header: [
        'grid grid-cols-1 gap-x-5',
        '|',
        'lg:grid-cols-12 lg:items-end'
    ],
    heading: [
        'col-span-full font-semibold leading-0.97 tracking-tighter',
        '|',
        'lg:col-start-1 lg:col-span-7 lg:row-start-1 lg:text-7xl'
    ],
    text: [
        'col-span-full font-medium',
        hasHeading ? 'mt-7.5',
        '|',
        'lg:col-start-9 lg:col-span-4 lg:row-start-1',
        hasHeading ? 'lg:mt-0'
    ],
    swatches: [
        'grid grid-cols-2 gap-5',
        hasHeading or hasText ? 'mt-10',
        '|',
        'lg:grid-cols-24 lg:grid-rows-3 lg:h-99.25',
        hasHeading or hasText ? 'lg:mt-12.5'
    ],
    swatch: 'flex items-end rounded-[20px] p-5 text-base font-medium leading-1.33 uppercase',
    buttons: 'mt-7.5'
} %}

{# Output #}

{% embed '_components/section'
    with {
        params: params|merge({
            paddingY: params.padding,
        })
    }
%}
    {% block sectionContent %}

        <div class="{{ blockClasses.panels }}">

            <div class="{{ blockClasses.panel }}">

                {% if hasHeading or hasText %}

                    <div class="{{ blockClasses.header|join(' ')|trim }}">

                        {% include '_components/headingAlternate' with {
                            params: {
                                tag: 'h2',
                                heading: entry.heading,
                                size: '5xl',
                                class: blockClasses.heading|join(' ')|trim
                            }
                        } only %}

                        {% if hasText %}

                            {% include '_components/richText' with {
                                params: {
                                    content: entry.text,
                                    colour: 'black',
                                    size: 'sm',
                                    class: blockClasses.text|join(' ')|trim
                                }
                            } only %}

                        {% endif %}

                    </div>

                {% endif %}

                <ul class="{{ blockClasses.swatches|join(' ')|trim }}">

                    {% for swatch in swatches %}

                        <li class="{{ blockClasses.swatch }} {{ swatch.class }}">{{ swatch.label }}</li>

                    {% endfor %}

                </ul>

            </div>

        </div>

        {% include '_components/buttonGroup' with {
            params: {
                buttons: buttons,
                colours: ['secondary', 'white'],
                align: 'center',
                class: blockClasses.buttons
            }
        } only %}

    {% endblock %}
{% endembed %}
