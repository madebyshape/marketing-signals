{# Block Defaults #}

{% set blockDefaults = {
    handle: entry.type.handle,
    padding: entry.padding|length ? entry.padding.value : 'topBottom',
} %}

{# Merge Defaults #}

{% set params = (params is defined and params is iterable) ? blockDefaults|merge(params) : blockDefaults %}

{# FAQs #}

{% set faqs = [] %}

{% for faq in entry.entriesFaq.all() %}

    {% if faq.text|striptags|trim|length %}

        {% set faqs = faqs|merge([{
            id: faq.id,
            heading: faq.title,
            content: faq.text,
            buttons: faq.buttonGroup.all()
        }]) %}

    {% endif %}

{% endfor %}

{# Classes #}

{% set blockClasses = {
    margin: vars is defined ? vars.class.siteMargin.x : 'px-10',
    panel: [
        'rounded-[20px] bg-creme-200 px-5 py-10',
        '|',
        'lg:grid lg:grid-cols-12 lg:items-start lg:gap-5 lg:px-10 lg:py-25'
    ],
    headingColumn: [
        'mb-10',
        '|',
        'lg:col-span-5 lg:mb-0'
    ],
    heading: [
        'font-semibold leading-0.97 tracking-tighter',
        '|',
        'md:text-6xl | lg:text-7xl'
    ],
    accordion: 'lg:col-span-7'
} %}

{# Output #}

{% if faqs|length %}

    {% embed '_components/section'
        with {
            params: params|merge({
                paddingY: params.padding,
                paddingX: 'none'
            })
        }
    %}
        {% block sectionContent %}

            <div class="{{ blockClasses.margin }}">

                <div class="{{ blockClasses.panel|join(' ')|trim }}">

                    <div class="{{ blockClasses.headingColumn|join(' ')|trim }}">

                        {% include '_components/headingAlternate' with {
                            params: {
                                tag: 'h2',
                                heading: entry.heading,
                                size: '4xl',
                                class: blockClasses.heading|join(' ')|trim
                            }
                        } only %}

                    </div>

                    {% include '_components/accordion' with {
                        params: {
                            id: params.handle ~ '-' ~ entry.id,
                            items: faqs,
                            class: blockClasses.accordion
                        }
                    } only %}

                </div>

            </div>

        {% endblock %}
    {% endembed %}

{% endif %}
