{# Carousel Controls · every style, on each panel #}

{% set variants = [
    { style: 'pill', colour: 'base' },
    { style: 'icon', colour: 'white-30-outline' }
] %}

<section class="grid gap-y-10" id="carousel-controls">

    <h2 class="text-2xl font-medium leading-1.2 tracking-tighter">Carousel Controls</h2>

    {% for panel in panels %}

        <div class="grid gap-y-8 p-10 rounded-md | {{ panel.class }}">

            <h3 class="text-xs opacity-60">{{ panel.label }}</h3>

            {% for variant in variants %}

                <div class="grid gap-y-3 justify-items-start">

                    <h4 class="text-xs font-mono opacity-60">style: {{ variant.style }} · colour: {{ variant.colour }}</h4>

                    {% include '_components/carouselControls' with {
                        params: variant
                    } only %}

                </div>

            {% endfor %}

        </div>

    {% endfor %}

</section>
