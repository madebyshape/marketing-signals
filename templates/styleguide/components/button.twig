{# Button · every colour × icon position × icon style, on each panel #}

{% set colours = ['secondary', 'creme-100', 'creme-100-outline', 'creme-300-outline'] %}
{% set iconStyles = ['inline', 'circle'] %}
{% set iconPositions = ['after', 'before'] %}

<section class="grid gap-y-10" id="button">

    <h2 class="text-2xl font-medium leading-1.2 tracking-tighter">Button</h2>

    {% for panel in panels %}

        <div class="grid gap-y-8 p-10 rounded-md | {{ panel.class }}">

            <h3 class="text-xs opacity-60">{{ panel.label }}</h3>

            {% for colour in colours %}

                <div class="grid gap-y-3">

                    <h4 class="text-xs font-mono opacity-60">colour: {{ colour }}</h4>

                    <div class="flex flex-wrap gap-5 items-center">

                        {% for iconStyle in iconStyles %}
                            {% for iconPosition in iconPositions %}

                                {% include '_components/button' with {
                                    params: {
                                        button: { value: '#', label: 'Let’s Work Together' },
                                        colour: colour,
                                        iconStyle: iconStyle,
                                        iconPosition: iconPosition,
                                        attributes: 'data-variant="' ~ colour ~ '/' ~ iconStyle ~ '/' ~ iconPosition ~ '"'
                                    }
                                } %}

                            {% endfor %}
                        {% endfor %}

                        {% include '_components/button' with {
                            params: {
                                button: { value: '#', label: 'No Icon' },
                                colour: colour,
                                icon: null,
                                attributes: 'data-variant="' ~ colour ~ '/no-icon"'
                            }
                        } %}

                    </div>

                </div>

            {% endfor %}

        </div>

    {% endfor %}

</section>
