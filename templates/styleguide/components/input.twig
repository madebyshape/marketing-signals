{# Input · every colour × size, with and without a label and a leading icon, on each panel #}

{% set colours = ['base', 'white-10'] %}
{% set sizes = ['base', 'pill'] %}

<section class="grid gap-y-10" id="input">

    <h2 class="text-2xl font-medium leading-1.2 tracking-tighter">Input</h2>

    {% for panel in panels %}

        <div class="grid gap-y-8 p-10 rounded-md | {{ panel.class }}">

            <h3 class="text-xs opacity-60">{{ panel.label }}</h3>

            {% for colour in colours %}

                <div class="grid gap-y-3">

                    <h4 class="text-xs font-mono opacity-60">colour: {{ colour }}</h4>

                    <div class="grid md:grid-cols-2 gap-5 items-start">

                        {% for size in sizes %}

                            {% include '_components/form/input' with {
                                params: {
                                    name: 'styleguide-' ~ colour ~ '-' ~ size,
                                    label: 'Email Address',
                                    instructions: 'We will never share your address.',
                                    type: 'email',
                                    placeholder: 'Enter Your Email Address',
                                    colour: colour,
                                    size: size,
                                    attributes: 'data-variant="' ~ colour ~ '/' ~ size ~ '"'
                                }
                            } only %}

                            {% include '_components/form/input' with {
                                params: {
                                    name: 'styleguide-' ~ colour ~ '-' ~ size ~ '-icon',
                                    type: 'email',
                                    placeholder: 'Enter Your Email Address',
                                    icon: 'fa-sharp fa-solid fa-paper-plane',
                                    colour: colour,
                                    size: size,
                                    attributes: 'data-variant="' ~ colour ~ '/' ~ size ~ '/icon"'
                                }
                            } only %}

                        {% endfor %}

                    </div>

                </div>

            {% endfor %}

        </div>

    {% endfor %}

    {# The pill field beside the button component's base pill, so the two heights can be compared #}

    <div class="grid gap-y-3 p-10 rounded-md | bg-black text-white">

        <h4 class="text-xs font-mono opacity-60">size: pill, beside the button component</h4>

        <div class="flex gap-2.5 items-start max-w-[778px]">

            {% include '_components/form/input' with {
                params: {
                    name: 'styleguide-gate',
                    type: 'email',
                    placeholder: 'Enter Your Email Address',
                    icon: 'fa-sharp fa-solid fa-paper-plane',
                    colour: 'white-10',
                    size: 'pill',
                    attributes: 'data-variant="gate"'
                }
            } only %}

            {% include '_components/button' with {
                params: {
                    type: 'button',
                    button: { label: 'Get The Checklist' },
                    icon: null
                }
            } only %}

        </div>

    </div>

</section>
