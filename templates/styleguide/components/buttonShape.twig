{# Button Shape · every colour, on each panel #}

{% set colours = ['secondary', 'creme-100', 'creme-100-outline', 'creme-300-outline'] %}

<section class="grid gap-y-10" id="button-shape">

    <h2 class="text-2xl font-medium leading-1.2 tracking-tighter">Button Shape</h2>

    {% for panel in panels %}

        <div class="grid gap-y-8 p-10 rounded-md | {{ panel.class }}">

            <h3 class="text-xs opacity-60">{{ panel.label }}</h3>

            <div class="flex flex-wrap gap-5 items-center">

                {% for colour in colours %}

                    {% include '_components/buttonShape' with {
                        params: {
                            type: 'button',
                            button: { value: '#' },
                            icon: 'fa-sharp fa-regular fa-arrow-right',
                            colour: colour,
                            attributes: 'data-variant="' ~ colour ~ '"'
                        }
                    } %}

                {% endfor %}

            </div>

        </div>

    {% endfor %}

</section>
