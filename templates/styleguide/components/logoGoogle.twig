{# Logo Google · the Review Badge's 17px and a larger size, on each panel #}

{% set sizes = {
    '17px': 'size-[17px]',
    '68px': 'size-[68px]'
} %}

<section class="grid gap-y-10" id="logoGoogle">

    <h2 class="text-2xl font-medium leading-1.2 tracking-tighter">Logo Google</h2>

    {% for panel in panels %}

        <div class="grid gap-y-8 p-10 rounded-md | {{ panel.class }}">

            <h3 class="text-xs opacity-60">{{ panel.label }}</h3>

            <div class="flex flex-wrap items-start gap-10">

                {% for label, class in sizes %}

                    <div class="grid gap-y-3 justify-items-start">

                        <h4 class="text-xs font-mono opacity-60">class: {{ label }}</h4>

                        {% include '_components/logoGoogle' with {
                            params: {
                                class: class
                            }
                        } only %}

                    </div>

                {% endfor %}

            </div>

        </div>

    {% endfor %}

</section>
