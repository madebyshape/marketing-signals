{# Badge · every colour × size, on each panel #}

{% set colours = ['base', 'white-20', 'white-20-black', 'creme-300-outline'] %}
{% set sizes = ['xs', 'base', 'sm', 'lg'] %}

<section class="grid gap-y-10" id="badge">

    <h2 class="text-2xl font-medium leading-1.2 tracking-tighter">Badge</h2>

    {% for panel in panels %}

        <div class="grid gap-y-8 p-10 rounded-md | {{ panel.class }}">

            <h3 class="text-xs opacity-60">{{ panel.label }}</h3>

            {% for colour in colours %}

                <div class="grid gap-y-3">

                    <h4 class="text-xs font-mono opacity-60">colour: {{ colour }}</h4>

                    <div class="flex flex-wrap gap-5 items-center">

                        {% for size in sizes %}

                            {% include '_components/badge' with {
                                params: {
                                    badge: 'Organic Search',
                                    colour: colour,
                                    size: size
                                }
                            } only %}

                        {% endfor %}

                    </div>

                </div>

            {% endfor %}

        </div>

    {% endfor %}

</section>
