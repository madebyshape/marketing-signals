{# Playbook Card · the first Playbook in the structure, at its designed width, on each panel #}

{% set playbook = craft.entries().section('playbook').one() %}

{% if playbook %}

    <section class="grid gap-y-10" id="playbookCard">

        <h2 class="text-2xl font-medium leading-1.2 tracking-tighter">Playbook Card</h2>

        {% for panel in panels %}

            <div class="grid gap-y-8 p-5 rounded-md | {{ panel.class }} | lg:p-10">

                <h3 class="text-xs opacity-60">{{ panel.label }}</h3>

                <div class="max-w-[493px]">

                    {% include '_components/playbookCard' with {
                        params: {
                            playbook: playbook,
                            number: 1,
                            sizes: '493px'
                        }
                    } only %}

                </div>

            </div>

        {% endfor %}

    </section>

{% endif %}
