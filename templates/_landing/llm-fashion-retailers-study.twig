/td><td><span class="tier-badge tier-bottom">Bottom 20</span></td></tr><tr data-rank="49" data-domain="marksandspencer.com" data-traffic="21129911" data-chatgpt="0.04" data-googleai="0.94" data-semrush="9.86" data-index="3.61" data-tier="Bottom 20"><td class="tc">49</td><td class="td">marksandspencer.com</td><td class="tt">21,129,911</td><td class="tn">0.04</td><td class="tn">0.94</td><td class="tn">9.86</td><td class="ti"><strong>3.61</strong></td><td><span class="tier-badge tier-bottom">Bottom 20</span></td></tr><tr data-rank="50" data-domain="primark.com" data-traffic="6654745" data-chatgpt="0.17" data-googleai="2.46" data-semrush="7.56" data-index="3.39" data-tier="Bottom 20"><td class="tc">50</td><td class="td">primark.com</td><td class="tt">6,654,745</td><td class="tn">0.17</td><td class="tn">2.46</td><td class="tn">7.56</td><td class="ti"><strong>3.39</strong></td><td><span class="tier-badge tier-bottom">Bottom 20</span></td></tr><tr data-rank="51" data-domain="matalan.co.uk" data-traffic="3537276" data-chatgpt="0.01" data-googleai="1.72" data-semrush="8.13" data-index="3.29" data-tier="Bottom 20"><td class="tc">51</td><td class="td">matalan.co.uk</td><td class="tt">3,537,276</td><td class="tn">0.01</td><td class="tn">1.72</td><td class="tn">8.13</td><td class="ti"><strong>3.29</strong></td><td><span class="tier-badge tier-bottom">Bottom 20</span></td></tr><tr data-rank="52" data-domain="bershka.com" data-traffic="533025" data-chatgpt="2.6" data-googleai="1.14" data-semrush="5.95" data-index="3.23" data-tier="Bottom 20"><td class="tc">52</td><td class="td">bershka.com</td><td class="tt">533,025</td><td class="tn">2.6</td><td class="tn">1.14</td><td class="tn">5.95</td><td class="ti"><strong>3.23</strong></td><td><span class="tier-badge tier-bottom">Bottom 20</span></td></tr><tr data-rank="53" data-domain="sportsdirect.com" data-traffic="8389569" data-chatgpt="1.1" data-googleai="1.84" data-semrush="6.43" data-index="3.13" data-tier="Bottom 20"><td class="tc">