{% extends '_layouts/global' %}

{% block site %}

    {# Contact #}

    {# Named apart from `params` and `classes`, which the section embed shadows #}

    {% set contactClasses = {
        panel: [
            'w-full',
            vars.class.siteMargin.x,
            vars.class.header.paddingTop
        ],
        grid: [
            'mt-7.5 grid grid-cols-12 gap-5',
            '|',
            'md:mt-12.5 lg:mt-17.5 xl:mt-[90px]'
        ],
        details: [
            'col-span-12 max-w-[622px]',
            '|',
            'lg:col-span-6'
        ],
        heading: [
            'mt-7.5'
        ],
        divider: [
            'mt-7.5 border-creme-300'
        ],
        highlight: [
            'mt-7.5'
        ],
        list: [
            'mt-7.5 flex flex-col gap-y-6 text-md leading-1.33 text-black'
        ],
        item: [
            'flex items-start gap-2.25'
        ],
        icon: [
            'flex h-6 w-3.5 shrink-0 items-center justify-center text-[14px] text-primary'
        ],
        link: [
            'font-medium underline-offset-2',
            '|',
            'hover:underline focus-visible:underline'
        ],
        location: [
            '[&_strong]:mb-0.75 [&_strong]:block [&_strong]:font-medium [&_strong+br]:hidden'
        ],
        form: [
            'col-span-12 mt-10',
            '|',
            'lg:col-span-6 lg:mt-0 lg:pt-14'
        ]
    } %}

    {# Formie theme config: rows as the grid, errors in Primary, and no Formie label where a component draws one #}

    {% set contactFormConfig = {
        pageContainer: {
            attributes: { class: 'grid gap-y-7.5' }
        },
        row: {
            attributes: { class: 'grid gap-5 md:auto-cols-fr md:grid-flow-col' }
        },
        fieldError: {
            attributes: { class: 'mt-2 text-xs text-primary' }
        },
        buttonWrapper: {
            attributes: { class: 'mt-7.5 flex flex-col gap-5 md:flex-row md:items-center md:justify-between' }
        },
        singleLineText: {
            fieldLabel: false
        },
        emailAddress: {
            fieldLabel: false
        },
        multiLineText: {
            fieldLabel: false
        },
        radioButtons: {
            fieldLabel: {
                attributes: { class: 'mb-3.75 text-base font-medium leading-1.33 text-black' }
            }
        }
    } %}

    {% set inlineImages = entry.headingInlineImages %}
    {% set contactForm = entry.form.one() %}

    {% embed '_components/section' with {
        params: {
            paddingY: 'bottom',
            paddingX: 'none'
        }
    } %}
        {% block sectionContent %}

            <div class="{{ contactClasses.panel|join(' ')|trim }}">

                <div class="{{ contactClasses.grid|join(' ')|trim }}">

                    <div class="{{ contactClasses.details|join(' ')|trim }}">

                        {% include '_components/eyebrow' with {
                            params: {
                                text: entry.eyebrow,
                                colour: 'black'
                            }
                        } only %}

                        {% include '_components/headingInlineImages' with {
                            params: {
                                tag: 'h1',
                                heading: inlineImages.heading,
                                imagePosition: inlineImages.wordCount,
                                images: inlineImages.images.all(),
                                class: contactClasses.heading|join(' ')|trim
                            }
                        } only %}

                        <hr class="{{ contactClasses.divider|join(' ')|trim }}">

                        {% if entry.heading %}

                            {% include '_components/richText' with {
                                params: {
                                    content: entry.heading,
                                    colour: 'black',
                                    size: '3xl',
                                    class: contactClasses.highlight|join(' ')|trim
                                }
                            } only %}

                        {% endif %}

                        {% if entry.email or entry.phone or entry.location %}

                            <ul class="{{ contactClasses.list|join(' ')|trim }}">

                                {% if entry.email %}

                                    <li class="{{ contactClasses.item|join(' ')|trim }}">
                                        <span class="{{ contactClasses.icon|join(' ')|trim }}" aria-hidden="true"><i class="fa-sharp fa-solid fa-paper-plane"></i></span>
                                        <a href="{{ entry.email.value }}" class="{{ contactClasses.link|join(' ')|trim }}">{{ entry.email.label }}</a>
                                    </li>

                                {% endif %}

                                {% if entry.phone %}

                                    <li class="{{ contactClasses.item|join(' ')|trim }}">
                                        <span class="{{ contactClasses.icon|join(' ')|trim }}" aria-hidden="true"><i class="fa-sharp fa-solid fa-phone"></i></span>
                                        <a href="{{ entry.phone.value }}" class="{{ contactClasses.link|join(' ')|trim }}">{{ entry.phone.label }}</a>
                                    </li>

                                {% endif %}

                                {% if entry.location %}

                                    <li class="{{ contactClasses.item|join(' ')|trim }}">
                                        <span class="{{ contactClasses.icon|join(' ')|trim }}" aria-hidden="true"><i class="fa-sharp fa-solid fa-location-dot"></i></span>

                                        {% include '_components/richText' with {
                                            params: {
                                                content: entry.location,
                                                colour: 'black',
                                                size: 'md',
                                                class: contactClasses.location|join(' ')|trim
                                            }
                                        } only %}
                                    </li>

                                {% endif %}

                            </ul>

                        {% endif %}

                    </div>

                    {% if contactForm %}

                        {# The site Form Template is set here, so the control panel's choice doesn't matter #}
                        {% do contactForm.setTemplate(craft.formie.plugin.formTemplates.getTemplateByHandle('site')) %}

                        <div class="{{ contactClasses.form|join(' ')|trim }}">
                            {{ craft.formie.renderForm(contactForm, {
                                themeConfig: contactFormConfig
                            }) }}
                        </div>

                    {% endif %}

                </div>

            </div>

        {% endblock %}
    {% endembed %}

    {# Blocks #}

    {{ entry.blocks.render({
        vars: vars
    }) }}

{% endblock %}
