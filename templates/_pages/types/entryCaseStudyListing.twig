{% extends '_layouts/global' %}

{# Header Colour #}

{# The Header follows the page's Hero Layout (ADR-0004), so an editor never sets it. #}

{% set headerColours = {
    heroHome: 'black'
} %}

{% set hero = entry.hero.one() %}
{% set headerColour = hero ? headerColours[hero.type.handle]|default('creme-100') : 'creme-100' %}

{% block site %}

    {{ entry.hero.render({
        vars: vars
    }) }}

    {# Case Study Grid #}

    {# The Category and page live in the query string, so a direct load renders the state a swap would. #}

    {% embed '_components/section' with {
        params: {
            paddingY: 'topBottom',
            paddingYSize: 'base'
        }
    } %}
        {% block sectionContent %}

            {{ sprig('_sprig/caseStudyGrid', {
                category: craft.app.request.getQueryParam('category') ?? '',
                page: craft.app.request.getQueryParam('page') ?? 1
            }, {
                id: 'caseStudyGrid'
            }) }}

        {% endblock %}
    {% endembed %}

    {# Blocks #}
    {{ entry.blocks.render({
        vars: vars
    }) }}

{% endblock %}

