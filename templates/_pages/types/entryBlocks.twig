{% extends '_layouts/global' %}

{% block site %}

    {# The hero renders with the Blocks, so a page with no Blocks renders nothing. Guarding on the
       count rather than looping over the Blocks keeps a second Block from rendering the whole page
       a second time. #}

    {% if entry.blocks.count() %}

        {{ entry.hero.render({
            vars: vars
        }) }}

        {{ entry.blocks.render({
            vars: vars
        }) }}

    {% endif %}

{% endblock %}
