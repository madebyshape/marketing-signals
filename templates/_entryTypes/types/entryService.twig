{% extends '_layouts/global' %}

{# Header Colour #}

{# The Header follows the page's Hero Layout (ADR-0004), so an editor never sets it. #}

{% set headerColour = 'black' %}

{# Schema #}

{% set webPage = seomatic.jsonLd.get('mainEntityOfPage') %}

{% do seomatic.jsonLd.create({
    type: 'Service',
    key: 'mainEntityOfPage',
    name: entry.title,
    serviceType: entry.title,
    description: entry.description|striptags|trim ?: webPage.description ?? null,
    image: entry.thumbnail.one().url ?? null,
    url: entry.url,
    provider: { id: siteUrl ~ '#organization' },
    areaServed: {
        type: 'Country',
        name: 'GB'
    }
}) %}

{% block site %}

    {# Hero #}

    {% include '_components/heroService' with {
        params: {
            entry: entry,
            vars: vars
        }
    } only %}

    {# Blocks #}
    {{ entry.blocks.render({
        vars: vars
    }) }}

    {# Lead Modal #}

    {% if entry.leadGenerationPopup %}

        {% include '_components/leadModal' with {
            params: {
                content: craft.entries.section('site').one().leadGenerationPopup ?? null
            }
        } only %}

    {% endif %}

{% endblock %}
