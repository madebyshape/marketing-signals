{% extends '_layouts/global' %}

{# Schema #}

{% set webPage = seomatic.jsonLd.get('mainEntityOfPage') %}
{% set image = entry.thumbnail.one() ?? entry.heroImage.one() ?? null %}

{% do seomatic.jsonLd.create({
    type: 'CreativeWork',
    key: 'mainEntityOfPage',
    name: entry.title,
    headline: entry.title,
    description: entry.description|striptags|trim ?: webPage.description ?? null,
    image: image.url ?? null,
    datePublished: entry.postDate|atom,
    dateModified: entry.dateUpdated|atom,
    url: entry.url
}) %}

{% block site %}

    {# Blog Hero #}

    {% include '_components/heroBlog' with {
        params: {
            entry: entry,
            vars: vars
        }
    } only %}

    {# Longform #}

    {% set authorSignOff %}
        {% include '_components/authorSignOff' with {
            params: {
                entry: entry
            }
        } only %}
    {% endset %}

    {% include '_components/longform' with {
        params: {
            entry: entry,
            vars: vars,
            id: 'blog-content',
            closing: authorSignOff
        }
    } only %}

    {# Playbook CTA #}

    {% set globalBlocksEntry = globalBlocks ?? null %}
    {% set hasPlaybookCta = globalBlocksEntry and globalBlocksEntry.fieldLayout.getFieldByHandle('playbookCta') %}
    {% set playbookCta = hasPlaybookCta ? globalBlocksEntry.playbookCta.one() : null %}

    {% if playbookCta %}

        {{ playbookCta.render({
            vars: vars,
            params: {
                padding: 'topBottom'
            }
        }) }}

    {% endif %}

    {# Blocks #}

    {{ entry.blocks.render({
        vars: vars
    }) }}

{% endblock %}
