{% extends '_layouts/global' %}

{% block site %}

    {# Blog Hero #}

    {% include '_components/heroBlog' with {
        params: {
            entry: entry,
            vars: vars
        }
    } only %}

    {# Longform #}

    {% set authorSignOff %}
        {% include '_components/authorSignOff' with {
            params: {
                entry: entry
            }
        } only %}
    {% endset %}

    {% include '_components/longform' with {
        params: {
            entry: entry,
            vars: vars,
            id: 'blog-content',
            closing: authorSignOff
        }
    } only %}

    {# Blocks #}

    {{ entry.blocks.render({
        vars: vars
    }) }}

{% endblock %}
