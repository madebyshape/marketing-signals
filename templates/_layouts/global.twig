{% extends '_layouts/base' %}

{% set vars = {
	class: {
		siteMargin: {
			x: 'px-10',
			r: 'pr-10',
			l: 'pl-10'
		},
		header: {
			height: 'h-20 | xl:h-[123px]',
			paddingTop: 'pt-20 | xl:pt-[123px]',
			paddingBottom: 'pb-20 | xl:pb-[123px]',
			top: 'top-20 | xl:top-[123px]',
			scrollMargin: 'scroll-mt-20 | xl:scroll-mt-[123px]'
		},
		gutter: {
			x: 'px-5',
			y: 'py-5',
			t: 'pt-5',
			r: 'pr-5',
			b: 'pb-5',
			l: 'pl-5'
		},
		gap: {
			x: {
				sm: 'gap-x-2 | lg:gap-x-3',
				base: 'gap-x-3 | lg:gap-x-4',
				md: 'gap-x-5 | lg:gap-x-6',
				lg: 'gap-x-5 | lg:gap-x-10',
				xl: 'gap-x-5 | lg:gap-x-12',
				xxl: 'gap-x-12 | lg:gap-x-16',
			},
			y: {
				sm: 'gap-y-2 | lg:gap-y-3',
				base: 'gap-y-3 | lg:gap-y-4',
				md: 'gap-y-5 | lg:gap-y-6',
				lg: 'gap-y-5 | lg:gap-y-10',
				xl: 'gap-y-5 | lg:gap-y-12',
				xxl: 'gap-y-12 | lg:gap-y-24',
			},
		}
	}
} %}

{# Header Colour #}

{# The Header follows the page's Hero (ADR-0007) unless the page template sets it. #}

{% if headerColour is not defined %}

	{% set headerHero = (entry.hero ?? null) ? entry.hero.one() : null %}
	{% set darkHeroes = ['heroHome', 'heroFullScreen', 'heroTeam'] %}
	{% set isDarkHero = headerHero and (headerHero.type.handle in darkHeroes or (headerHero.type.handle == 'heroSimple' and headerHero.backgroundColour.value == 'black')) %}
	{% set headerColour = isDarkHero ? 'black' : 'creme-100' %}

{% endif %}

{# Show Footer #}

{% set showFooter = showFooter ?? true %}

{# Schema #}

{# SEOmatic's relative #identity and #creator become one absolute Organization (ADR-0008). #}

{% set organization = { id: siteUrl ~ '#organization' } %}
{% set website = { id: siteUrl ~ '#website' } %}
{% set identity = seomatic.jsonLd.get('identity') %}
{% set creator = seomatic.jsonLd.get('creator') %}
{% set mainEntity = seomatic.jsonLd.get('mainEntityOfPage') %}

{% if identity %}

	{% set contact = craft.entries().section('page').type('entryContact').one() %}

	{% do identity.id(organization.id) %}
	{% do identity.legalName('Marketing Signals Limited') %}

	{% if contact %}
		{% do identity.contactPoint({
			type: 'ContactPoint',
			contactType: 'sales',
			email: (contact.email.value ?? '')|replace({ 'mailto:': '' }),
			telephone: (contact.phone.value ?? '')|replace({ 'tel:': '' }),
			url: contact.url
		}) %}
	{% endif %}

	{% do seomatic.jsonLd.create({
		type: 'WebSite',
		key: 'website',
		id: website.id,
		name: siteName,
		url: siteUrl,
		description: seomatic.site.identity.genericDescription ?: 'Digital Marketing Solutions for Ambitious Brands',
		publisher: organization,
		inLanguage: seomatic.meta.language
	}) %}

{% endif %}

{% if creator %}
	{% do creator.include(false) %}
{% endif %}

{% if mainEntity %}

	{% do mainEntity.author(organization) %}
	{% do mainEntity.copyrightHolder(organization) %}
	{% do mainEntity.creator(organization) %}
	{% do mainEntity.publisher(organization) %}

	{% if 'isPartOf' in mainEntity.getSchemaPropertyNames() %}
		{% do mainEntity.isPartOf(website) %}
	{% endif %}

{% endif %}

{% block body %}

	{# Global Site Header #}
	{% include '_components/global/header' with {
		params: {
			colour: headerColour
		}
	} %}

	{% block site %}
	{% endblock %}

	{# Global Site Footer #}
    {% if showFooter %}
        {% include '_components/global/footer' %}
    {% endif %}

	{# Global Cursor Label #}

	{# Mounted once and raised by window event, so Blocks need no cursor of their own. #}
    {% include '_components/cursor' %}

	{# Scroll Cue #}

	{# Registered once so every Hero binds x-data="scrollCue" to the same behaviour. #}
    {% include '_components/scrollCue' %}

	{# Layout Guidelines #}
    {% include '_components/layoutGuidelines' %}

	{# Screensize #}
    {% include '_components/screensize' %}

{% endblock %}