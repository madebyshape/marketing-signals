{# Default Variables #}

{% set category = category ?? '' %}
{% set page = page ?? 1 %}

{# Case Studies #}

{% set perPage = 8 %}

{# A `page` from the query string arrives as a string and the paginator takes an int. #}

{% set page = page matches '/^[0-9]+$/' ? page + 0 : 1 %}

{% set activeCategory = category|length ? craft.categories.group('caseStudy').slug(category).one() : null %}

{% set query = craft.entries.section('caseStudy').status('enabled').relatedTo(activeCategory).limit(perPage) %}

{# The paginator clamps a page beyond the last to the last. #}

{% set pageInfo = sprig.paginate(query, page) %}
{% set caseStudies = query.offset(perPage * (pageInfo.currentPage - 1)).all() %}

{# Options #}

{# Each Slot carries its Card Size and the columns the Card spans from `md`. #}

{% set options = {
    slot: [
        { size: 'large', span: 'md:col-span-12' },
        { size: 'half', span: 'md:col-span-6' },
        { size: 'half', span: 'md:col-span-6' },
        { size: 'half', span: 'md:col-span-6' },
        { size: 'half', span: 'md:col-span-6' },
        { size: 'large', span: 'md:col-span-12' },
        { size: 'half', span: 'md:col-span-6' },
        { size: 'half', span: 'md:col-span-6' }
    ],
    sizes: {
        large: {
            portrait: '95vw',
            landscape: '95vw'
        },
        half: {
            portrait: '95vw',
            landscape: '(min-width: 768px) 47vw, 95vw'
        }
    }
} %}

{# Attributes #}

{# The grid is the indicator, so a trigger dims it by id. #}

{% set gridId = 'caseStudyGridItems' %}

{# A `>` anywhere in an s-* value truncates Sprig's tag match. #}

{% set attributes = [
    'sprig',
    's-indicator="#' ~ gridId ~ '"'
] %}

{# Classes #}

{% set classes = {
    rule: 'mb-10 h-px w-full bg-creme-300 scroll-mt-20 | xl:scroll-mt-[123px]',
    grid: 'grid grid-cols-12 gap-5 [&.htmx-request]:pointer-events-none [&.htmx-request]:opacity-50',
    item: 'col-span-12',
    empty: 'text-base'
} %}

{# Output #}

{# A swap scrolls the rule beneath the Header, whose height is the rule's scroll margin. #}

<div class="{{ classes.rule }}"{% if sprig.isRequest %} x-data x-init="window.lenis.scrollTo($el)"{% endif %}></div>

{% if caseStudies|length %}

    <ul id="{{ gridId }}" class="{{ classes.grid }}">

        {% for caseStudy in caseStudies %}

            {% set slot = cycle(options.slot, loop.index0) %}

            {% set itemClasses = [
                classes.item,
                '|',
                slot.span
            ] %}

            <li class="{{ itemClasses|join(' ')|trim }}">

                {% include '_components/caseStudyCard' with {
                    params: {
                        caseStudy: caseStudy,
                        size: slot.size,
                        sizes: options.sizes[slot.size]
                    }
                } only %}

            </li>

        {% endfor %}

    </ul>

    {% include '_components/pagination' with {
        params: {
            pageInfo: pageInfo,
            attributes: attributes
        }
    } only %}

{% else %}

    <p class="{{ classes.empty }}">No case studies found</p>

{% endif %}
