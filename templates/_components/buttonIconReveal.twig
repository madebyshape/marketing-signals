{# Default Params #}

{% set defaultParams = {
    type: 'a',
    button: {},
    colour: 'base',
    size: 'base',
    icon: 'fa-sharp fa-regular fa-arrow-right',
    iconPosition: 'after',
    class: '',
    attributes: ''
} %}

{# Merge Params #}

{% set params = params is defined ? defaultParams|merge(params) : defaultParams %}

{# Options #}

{% set options = {
    colour: {
        base: 'bg-black text-white ring-black/50 pointer-fine:hover:bg-zinc-600',
    },
    size: {
        base: 'text-md px-5 py-3 rounded-md'
    },
    iconPosition: {
        before: {
            icon: 'left-0',
            label: 'pointer-fine:group-hover:pl-7'
        },
        after: {
            icon: 'right-0',
            label: 'pointer-fine:group-hover:pr-7'
        }
    }
} %}

{# Classes #}

{% set classes = {
    button: [
        'group inline-flex flex-shrink-0 justify-center items-center relative leading-none overflow-hidden border border-transparent cursor-pointer motion-safe:transition focus:outline-none focus:ring-3',
        options.size[params.size],
        options.colour[params.colour],
        params.class
    ],
    icon: [
        'absolute transform transition-all duration-300 scale-0 overflow-hidden pointer-fine:group-hover:scale-100',
        options.iconPosition[params.iconPosition].icon
    ],
    label: [
        'transition-all duration-300',
        options.iconPosition[params.iconPosition].label
    ]
} %}

{# Output #}

{% if params.button|length %}

    <{{ params.type }}
        {% if params.type == 'a' %}
            href="{{ params.button.value }}"
            {% if params.button.target is defined %}
                target="{{ params.button.target }}"
                {% if params.button.target == '_blank' %}
                    rel="noopener noreferrer"
                {% endif %}
            {% endif %}
        {% endif %}
        class="{{ classes.button|join(' ')|trim }}"
        {{ params.attributes|raw }}
    >
        <span class="relative inline-flex items-center">
            {% if params.icon %}
                <span class="{{ classes.icon|join(' ')|trim }}" aria-hidden="true">
                    <i class="{{ params.icon }}"></i>
                </span>
            {% endif %}
            <span class="{{ params.icon ? classes.label|join(' ')|trim }}">{{ params.button.label }}</span>
        </span>
    </{{ params.type }}>

{% endif %}

