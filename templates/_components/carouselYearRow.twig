{% set component = 'carouselYearRow' %}

{# Default Params #}

{% set defaultParams = {
    labels: null,
    class: null
} %}

{# Merge Params #}

{% set params = params is defined ? defaultParams|merge(params) : defaultParams %}

{# Options #}

{% set options = {
    mark: {
        active: 'text-white',
        inactive: 'text-creme-500'
    },
    dash: {
        active: 'opacity-100',
        inactive: 'opacity-0'
    }
} %}

{# Classes #}

{% set classes = {
    row: [
        'mx-auto flex w-max max-w-full overflow-x-auto [scrollbar-width:none]',
        '|',
        '[&::-webkit-scrollbar]:hidden',
        '|',
        'lg:overflow-visible',
        params.class
    ],
    item: [
        'relative flex shrink-0',
        '|',
        'not-last:pr-15 before:absolute before:inset-x-0 before:top-1/2 before:h-px before:bg-white/30',
        '|',
        'lg:not-last:pr-32.5'
    ],
    mark: [
        'relative cursor-pointer bg-black px-2.5 text-base font-medium leading-none motion-safe:transition-colors motion-safe:duration-600 motion-safe:ease-out',
        '|',
        'focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-secondary/50'
    ],
    dash: [
        'pointer-events-none absolute left-full top-1/2 h-px w-27 bg-fluro motion-safe:transition-opacity motion-safe:duration-600 motion-safe:ease-out'
    ]
} %}

{# Output #}

{# It reads the carousel's own state, so it belongs in that carousel's after-content slot. #}

<ol
    aria-label="Years"
    class="{{ classes.row|join(' ')|trim }}"
    x-data="{{ component }}"
>

    {% for label in params.labels %}

        {% set state = loop.first ? 'active' : 'inactive' %}
        {% set isActive = 'activeIndex === ' ~ loop.index0 %}

        <li class="{{ classes.item|join(' ')|trim }}">

            <button
                type="button"
                class="{{ classes.mark|merge([options.mark[state]])|join(' ')|trim }}"
                aria-label="Go to {{ label }}"
                {{ loop.first ? 'aria-current="true"' }}
                x-bind:aria-current="{{ isActive }} ? 'true' : null"
                x-bind:class="{ '{{ options.mark.active }}': {{ isActive }}, '{{ options.mark.inactive }}': !({{ isActive }}) }"
                x-on:click="slideTo({{ loop.index0 }})"
            >
                {{ label }}

                {% if not loop.last %}

                    <span
                        class="{{ classes.dash|merge([options.dash[state]])|join(' ')|trim }}"
                        aria-hidden="true"
                        x-bind:class="{ '{{ options.dash.active }}': {{ isActive }}, '{{ options.dash.inactive }}': !({{ isActive }}) }"
                    ></span>

                {% endif %}
            </button>

        </li>

    {% endfor %}

</ol>

{# prettier-ignore-start #}
{% js %}

    document.addEventListener('alpine:init', () => {
        Alpine.data('{{ component }}', () => ({
            init() {

                const _self = this;
                const row = _self.$root;
                const behavior = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';

                // Scrolling the row itself, never scrollIntoView, keeps the page still.
                _self.$watch('activeIndex', (index) => {
                    const mark = row.children[index].firstElementChild.getBoundingClientRect();
                    const bounds = row.getBoundingClientRect();

                    row.scrollBy({
                        left: mark.left - bounds.left - (bounds.width - mark.width) / 2,
                        behavior,
                    });
                });

            },
        }));
    });

{% endjs %}
{# prettier-ignore-end #}
