{# Default Params #}

{% set defaultParams = {
    type: 'a',
    button: {},
    colour: 'base',
    size: 'base',
    icon: '',
    iconPosition: 'after',
    class: '',
    attributes: ''
} %}

{# Merge Params #}

{% set params = params is defined ? defaultParams|merge(params) : defaultParams %}

{# Options #}

{% set options = {
    colour: {
        base: 'bg-black text-white ring-black/50 pointer-fine:hover:bg-zinc-600',
    },
    size: {
        base: 'text-md px-5 py-3 rounded-md'
    },
    iconPosition: {
        before: 'flex-row',
        after: 'flex-row-reverse'
    }
} %}

{# Split the label into characters for the per-character roll #}

{% set chars = params.button.label|split('') %}

{# Classes #}

{% set classes = {
    button: [
        'group inline-flex flex-shrink-0 justify-center items-center relative gap-x-2 leading-none overflow-hidden border border-transparent cursor-pointer motion-safe:transition focus:outline-none focus:ring-3',
        options.size[params.size],
        options.colour[params.colour],
        options.iconPosition[params.iconPosition],
        params.class
    ],
    icon: [
        'inline-block align-middle motion-safe:transition'
    ],
    label: [
        'relative inline-block overflow-hidden align-middle'
    ],
    char: [
        'inline-block whitespace-pre motion-safe:transition-transform duration-500 ease-out pointer-fine:group-hover:-translate-y-[120%]'
    ],
    charHover: [
        'inline-block whitespace-pre translate-y-[120%] motion-safe:transition-transform duration-500 ease-out pointer-fine:group-hover:translate-y-0'
    ]
} %}

{# Output #}

{% if params.button|length %}

    <{{ params.type }}
        {% if params.type == 'a' %}
            href="{{ params.button.value }}"
            {% if params.button.target is defined %}
                target="{{ params.button.target }}"
                {% if params.button.target == '_blank' %}
                    rel="noopener noreferrer"
                {% endif %}
            {% endif %}
        {% endif %}
        class="{{ classes.button|join(' ')|trim }}"
        {{ params.attributes|raw }}
    >
        {% if params.icon %}
            <span class="{{ classes.icon|join(' ')|trim }}" aria-hidden="true">
                <i class="{{ params.icon }}"></i>
            </span>
        {% endif %}

        <span class="{{ classes.label|join(' ')|trim }}">
            <span class="inline-flex">
                {% for char in chars %}
                    <span class="{{ classes.char|join(' ')|trim }}" style="transition-delay: {{ loop.index0 * 25 }}ms">{{ char }}</span>
                {% endfor %}
            </span>
            <span class="absolute inset-0 inline-flex" aria-hidden="true">
                {% for char in chars %}
                    <span class="{{ classes.charHover|join(' ')|trim }}" style="transition-delay: {{ loop.index0 * 25 }}ms">{{ char }}</span>
                {% endfor %}
            </span>
        </span>
    </{{ params.type }}>

{% endif %}
