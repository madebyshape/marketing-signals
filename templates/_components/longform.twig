{% set component = 'longform' %}

{# Default Params #}

{% set defaultParams = {
    entry: null,
    vars: null,
    id: null,
    shareLabel: 'Share this article',
    tableOfContents: true,
    readingProgress: true,
    readTime: true,
    shareButtons: true,
    class: null
} %}

{# Merge Params #}

{% set params = params is defined ? defaultParams|merge(params) : defaultParams %}

{# Content #}

{# Named apart from `params` and `classes`, which the section embed shadows #}

{% set longform = params.entry.longform ?? [] %}
{% set scrollMargin = params.vars ? params.vars.class.header.scrollMargin : 'scroll-mt-20 | xl:scroll-mt-[123px]' %}
{% set cta = params.entry.sidebarCta ?? null %}
{% set hasCta = cta and cta.sidebarCta and cta.heading|striptags|trim|length %}
{% set avatars = hasCta ? cta.avatars.limit(3).all() : [] %}
{% set ctaButton = hasCta ? cta.button : null %}
{% set shareLabel = params.shareLabel %}
{% set sectionId = params.id %}
{% set ctaHashLink = (ctaButton.value ?? '') starts with '#' %}
{% set readingProgress = params.readingProgress %}
{% set readTime = params.readTime %}
{% set shareButtons = params.shareButtons %}

{# Classes #}

{% set longformClasses = {
    section: [
        scrollMargin,
        params.class
    ],
    grid: [
        'grid max-w-[750px] grid-cols-1 gap-x-5',
        '|',
        'xl:max-w-none xl:grid-cols-12'
    ],
    left: [
        'xl:col-span-3'
    ],
    body: [
        'xl:col-span-6 xl:col-start-4'
    ],
    right: [
        'xl:col-span-3 xl:col-start-10'
    ],
    sticky: [
        'xl:sticky xl:top-[143px]'
    ],
    progress: [
        'hidden',
        '|',
        'xl:block'
    ],
    readTime: [
        'max-w-[257px] mb-10 text-black',
        '|',
        'xl:justify-center xl:mt-5 xl:mb-0'
    ],
    card: [
        'mt-10 flex w-full max-w-[305px] flex-col items-center rounded-[20px] bg-white p-7.5 text-center',
        '|',
        'xl:mt-0 xl:ml-auto'
    ],
    avatars: [
        'flex -space-x-1.5'
    ],
    avatar: [
        'size-[33px] overflow-hidden rounded-full bg-creme-200'
    ],
    ctaHeading: [
        'font-medium leading-1.2 tracking-tighter',
        avatars|length ? 'mt-5'
    ],
    ctaButton: [
        'mt-5 w-full justify-center'
    ],
    share: [
        'w-full max-w-[305px]',
        hasCta ? 'mt-12.5' : 'mt-10',
        '|',
        hasCta ? 'xl:ml-auto' : 'xl:mt-0 xl:ml-auto'
    ],
    heading: [
        scrollMargin
    ],
    headingSpaced: [
        'mt-25',
        scrollMargin
    ]
} %}

{# Heading Anchors #}

{# Each H2 gains a server-rendered slug id so section links work without JavaScript. #}

{% set slugs = [] %}
{% set bodies = [] %}

{% for chunk in longform %}

    {% if chunk.type == 'markup' %}

        {% set parts = chunk.html|split('<h2') %}
        {% set html = parts|first %}

        {% for part in parts|slice(1) %}

            {% set slug = part|split('</h2>')|first|split('>', 2)|last|striptags|replace('/&[^;\\s]+;/', ' ')|kebab ?: 'section' %}
            {% set repeats = slugs|filter(s => s == slug)|length %}
            {% set id = repeats ? slug ~ '-' ~ (repeats + 1) : slug %}
            {% set headingClass = slugs|length ? longformClasses.headingSpaced : longformClasses.heading %}
            {% set html = html ~ '<h2 id="' ~ id ~ '" tabindex="-1" class="' ~ headingClass|join(' ')|trim ~ '"' ~ part %}
            {% set slugs = slugs|merge([slug]) %}

        {% endfor %}

        {% set bodies = bodies|merge([html|replace({ '<h3': '<h3 class="' ~ longformClasses.heading|join(' ')|trim ~ '"' })]) %}

    {% endif %}

{% endfor %}

{% set hasToc = params.tableOfContents and slugs|length %}
{% set hasLeft = hasToc or readingProgress or readTime %}
{% set hasRight = hasCta or shareButtons %}

{# Output #}

{% if bodies|join|striptags|trim|length %}

    {% embed '_components/section'
        with {
            params: {
                class: longformClasses.section|join(' ')|trim,
                attributes: 'id="' ~ sectionId ~ '" tabindex="-1"',
                paddingY: 'bottom'
            }
        }
    %}
        {% block sectionContent %}

            <div class="{{ longformClasses.grid|join(' ')|trim }}" x-data="{{ component }}">

                <div class="{{ longformClasses.left|join(' ')|trim }}">

                    {% if hasLeft %}

                        <div class="{{ longformClasses.sticky|join(' ')|trim }}">

                            {% if hasToc %}

                                {% include '_components/tableOfContents' with {
                                    params: {
                                        id: sectionId,
                                        class: 'mb-10'
                                    }
                                } only %}

                            {% endif %}

                            {% if readingProgress %}

                                {% include '_components/scrollProgress' with {
                                    params: {
                                        id: sectionId,
                                        class: longformClasses.progress|join(' ')|trim
                                    }
                                } only %}

                            {% endif %}

                            {% if readTime %}

                                {% include '_components/readTime' with {
                                    params: {
                                        text: bodies|join(' '),
                                        icon: 'fa-sharp fa-regular fa-clock',
                                        class: longformClasses.readTime|join(' ')|trim
                                    }
                                } only %}

                            {% endif %}

                        </div>

                    {% endif %}

                </div>

                <div class="{{ longformClasses.body|join(' ')|trim }}">

                    {% for body in bodies %}

                        {% include '_components/richText' with {
                            params: {
                                content: body,
                                colour: 'black',
                                size: 'longform',
                                list: 'longform'
                            }
                        } only %}

                    {% endfor %}

                </div>

                <div class="{{ longformClasses.right|join(' ')|trim }}">

                    {% if hasRight %}

                        <div class="{{ longformClasses.sticky|join(' ')|trim }}">

                            {% if hasCta %}

                                <div class="{{ longformClasses.card|join(' ')|trim }}">

                                    {% if avatars|length %}

                                        <div class="{{ longformClasses.avatars|join(' ')|trim }}" aria-hidden="true">

                                            {% for avatar in avatars %}

                                                <div class="{{ longformClasses.avatar|join(' ')|trim }}">

                                                    {% include '_components/picture' with {
                                                        params: {
                                                            image: avatar,
                                                            alt: '',
                                                            transform: '1x1',
                                                            ratio: false,
                                                            focalPoint: true,
                                                            sizes: '33px'
                                                        }
                                                    } only %}

                                                </div>

                                            {% endfor %}

                                        </div>

                                    {% endif %}

                                    {% include '_components/headingAlternate' with {
                                        params: {
                                            tag: 'h2',
                                            heading: cta.heading,
                                            size: '3xl',
                                            class: longformClasses.ctaHeading|join(' ')|trim
                                        }
                                    } only %}

                                    {# A same-page hash scrolls down to its heading; any other link keeps the default arrow. #}

                                    {% include '_components/button' with {
                                        params: {
                                            button: ctaButton,
                                            class: longformClasses.ctaButton|join(' ')|trim
                                        }|merge(ctaHashLink ? {
                                            icon: 'fa-sharp fa-regular fa-arrow-down',
                                            attributes: '@click.prevent="scrollToHash($el.hash)"'
                                        } : {})
                                    } only %}

                                </div>

                            {% endif %}

                            {% if shareButtons %}

                                {% include '_components/socialShare' with {
                                    params: {
                                        links: ['linkedin', 'facebook', 'x', 'copy'],
                                        heading: shareLabel,
                                        class: longformClasses.share|join(' ')|trim
                                    }
                                } only %}

                            {% endif %}

                        </div>

                    {% endif %}

                </div>

            </div>

        {% endblock %}
    {% endembed %}

{% endif %}

{# prettier-ignore-start #}
{% js %}

    document.addEventListener('alpine:init', () => {
        Alpine.data('{{ component }}', () => ({
            scrollToHash(hash) {

                const target = document.querySelector(hash);

                if (!target) {
                    return;
                }

                history.pushState(null, '', hash);

                // Lenis subtracts the target's scroll margin, which clears the fixed header.
                window.lenis.scrollTo(target, {
                    immediate: window.matchMedia('(prefers-reduced-motion: reduce)').matches
                });

                target.focus({ preventScroll: true });

            }
        }))
    })

{% endjs %}
{# prettier-ignore-end #}
