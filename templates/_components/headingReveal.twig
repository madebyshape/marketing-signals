{% set component = 'headingReveal' %}

{# Default Params #}

{% set defaultParams = {
    heading: null,
    tag: 'h2',
    size: '5xl',
    colour: 'base',
    indent: 'none',
    class: null,
    id: null
} %}

{# Merge Params #}

{% set params = params is defined ? defaultParams|merge(params) : defaultParams %}

{# Options #}

{# The indent is the design's two grid columns plus the two gaps between them, which on a
   12-column grid is one sixth of the content width plus one sixth of the gap. Text indent takes
   its percentage from the containing block, so the same class holds at every width and no inline
   style is needed. It moves the first line only, which is what the design asks for. #}

{% set options = {
    indent: {
        none: '',
        columns: 'indent-[calc((100%_+_1.25rem)/6)]'
    }
} %}

{# Classes #}

{% set classes = {
    heading: [
        'font-semibold leading-0.97 tracking-tighter',
        options.indent[params.indent] ?? '',
        params.class ?: ''
    ]
} %}

{# Output #}

{# The wrapper is the element the Reveal is driven from, so the heading itself carries the ref
   rather than being found by selector. The heading is handed on as the editor wrote it: the
   alternate heading reads the level off the front of it and turns the italic words into the
   Highlight. #}

{% if params.heading|striptags|trim|length %}

    <div{{ params.id|length ? ' id="' ~ params.id ~ '"' }}>

        {% include '_components/headingAlternate' with {
            params: {
                heading: params.heading,
                tag: params.tag,
                size: params.size,
                colour: params.colour,
                class: classes.heading|join(' ')|trim,
                attributes: 'x-ref="heading"'
            }
        } only %}

    </div>

{% endif %}
