{% set component = 'headingReveal' %}

{# Default Params #}

{% set defaultParams = {
    heading: null,
    tag: 'h2',
    size: '5xl',
    colour: 'base',
    indent: 'none',
    class: null,
    id: null
} %}

{# Merge Params #}

{% set params = params is defined ? defaultParams|merge(params) : defaultParams %}

{# Options #}

{# Two grid columns plus two gaps: one sixth of the content width plus one sixth of the gap. #}

{% set options = {
    indent: {
        none: '',
        columns: 'indent-[calc((100%_+_1.25rem)/6)]'
    }
} %}

{# Classes #}

{% set classes = {
    heading: [
        'font-semibold leading-0.97 tracking-tighter',
        options.indent[params.indent] ?? '',
        params.class ?: ''
    ]
} %}

{# Output #}

{% if params.heading|striptags|trim|length %}

    <div
        {{ params.id|length ? 'id="' ~ params.id ~ '"' }}
        x-data="{{ component }}"
    >

        {% include '_components/headingAlternate' with {
            params: {
                heading: params.heading,
                tag: params.tag,
                size: params.size,
                colour: params.colour,
                class: classes.heading|join(' ')|trim,
                attributes: 'x-ref="heading"'
            }
        } only %}

    </div>

{% endif %}

{# prettier-ignore-start #}
{% js %}

    document.addEventListener('alpine:init', () => {
        Alpine.data('{{ component }}', () => ({
            init() {

                const heading = this.$refs.heading;

                gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', (context) => {

                    // Split after the webfonts load, or ScrollTrigger measures against the fallback font's layout.
                    document.fonts.ready.then(() => context.add(() => {

                        // Words, not lines: line blocks would take the first-line indent with them.
                        const split = SplitText.create(heading, {
                            type: 'words',
                            tag: 'span',
                            aria: 'auto'
                        });

                        gsap.set(split.words, {
                            opacity: 0.2,
                            willChange: 'opacity'
                        });

                        // Duration four against stagger one keeps four words mid-fade, so the Reveal reads as a wave.
                        gsap.to(split.words, {
                            opacity: 1,
                            ease: 'none',
                            duration: 4,
                            stagger: 1,
                            scrollTrigger: {
                                trigger: heading,
                                start: 'top 80%',
                                end: 'bottom 55%',
                                scrub: 1
                            }
                        });

                    }));

                });

            }
        }))
    })

{% endjs %}
{# prettier-ignore-end #}
