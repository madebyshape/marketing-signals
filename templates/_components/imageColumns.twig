{% set component = 'imageColumns' %}

{# Default Params #}

{% set defaultParams = {
    columns: null,
    transform: '3x4',
    speed: 0.3,
    class: null
} %}

{# Merge Params #}

{% set params = params is defined ? defaultParams|merge(params) : defaultParams %}

{# Options #}

{% set options = {
    grid: {
        1: 'grid-cols-1',
        2: 'grid-cols-2'
    },
    sizes: {
        1: '(min-width: 1024px) 40vw, 90vw',
        2: '(min-width: 1024px) 20vw, 45vw'
    }
} %}

{# Classes #}

{% set columns = params.columns|filter(column => column|length) %}

{# The wrapper takes its height from params.class; it only clips, the columns overflow it. #}

{% set classes = {
    wrapper: [
        'overflow-hidden',
        params.class
    ],
    columns: [
        'grid gap-5 h-full',
        options.grid[columns|length]
    ],
    tile: [
        'rounded-[20px] mb-5'
    ],
    image: [
        'w-full h-full object-cover'
    ]
} %}

{# Output #}

{% if columns|length %}

    <div
        class="{{ classes.wrapper|join(' ')|trim }}"
        x-data="{{ component }}({{ params.speed }})"
    >

        <div class="{{ classes.columns|join(' ')|trim }}" x-ref="columns">

            {% for images in columns %}

                <div>

                    {# Each column renders twice so the loop has a second copy to bring round behind the first. #}

                    {% for i in 0..1 %}

                        <div>

                            {% for image in images %}

                                {% include '_components/picture' with {
                                    params: {
                                        image: image,
                                        transform: params.transform,
                                        sizes: options.sizes[columns|length],
                                        wrapperClass: classes.tile|join(' ')|trim,
                                        imgClass: classes.image|join(' ')|trim
                                    }
                                } only %}

                            {% endfor %}

                        </div>

                    {% endfor %}

                </div>

            {% endfor %}

        </div>

    </div>

{% endif %}

{# prettier-ignore-start #}
{% js %}

    document.addEventListener('alpine:init', () => {
        Alpine.data('{{ component }}', (speed) => ({
            init() {

                if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
                    return;
                }

                Array.from(this.$refs.columns.children).forEach((column, index) => {
                    gsapVerticalLoop(column.children, {
                        repeat: -1,
                        speed: speed,
                        reversed: index % 2 === 1
                    });
                });

            }
        }))
    })

{% endjs %}
{# prettier-ignore-end #}
