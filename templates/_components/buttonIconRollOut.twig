{# Default Params #}

{% set defaultParams = {
    type: 'a',
    button: {},
    colour: 'base',
    size: 'base',
    icon: 'fa-sharp fa-regular fa-arrow-up',
    iconPosition: 'after',
    class: '',
    attributes: ''
} %}

{# Merge Params #}

{% set params = params is defined ? defaultParams|merge(params) : defaultParams %}

{# Options #}

{% set options = {
    colour: {
        base: {
            button: 'bg-black text-white',
            icon: 'bg-black text-white'
        }
    },
    size: {
        base: {
            button: 'text-md px-5 py-3 rounded-full',
            icon: 'w-10 h-10 text-sm'
        }
    },
    iconPosition: {
        before: {
            wrapper: 'flex-row pointer-fine:translate-x-5',
            button: 'pointer-fine:-translate-x-5 pointer-fine:group-hover:translate-x-0',
            icon: 'pointer-fine:translate-x-5 pointer-fine:rotate-0 pointer-fine:group-hover:rotate-180 pointer-fine:group-hover:translate-x-0'
        },
        after: {
            wrapper: 'flex-row-reverse pointer-fine:-translate-x-5',
            button: 'pointer-fine:translate-x-5 pointer-fine:group-hover:translate-x-0',
            icon: 'pointer-fine:-translate-x-5 pointer-fine:rotate-0 pointer-fine:group-hover:rotate-180 pointer-fine:group-hover:translate-x-0'
        }
    }
} %}

{# Classes #}

{% set classes = {
    wrapper: [
        'relative group inline-flex flex-shrink-0 cursor-pointer',
        params.icon ? options.iconPosition[params.iconPosition].wrapper : '',
        params.class
    ],
    button: [
        'group inline-flex flex-shrink-0 z-20 justify-center items-center relative leading-none overflow-hidden motion-safe:transition',
        params.icon ? options.iconPosition[params.iconPosition].button : '',
        options.size[params.size].button,
        options.colour[params.colour].button
    ],
    icon: [
        'rounded-full flex items-center justify-center motion-safe:transition z-10 rotate-180',
        options.iconPosition[params.iconPosition].icon,
        options.size[params.size].icon,
        options.colour[params.colour].icon
    ]
} %}

{# Output #}

{% if params.button|length %}

    <{{ params.type }}
        {% if params.type == 'a' %}
            href="{{ params.button.value }}"
            {% if params.button.target is defined %}
                target="{{ params.button.target }}"
                {% if params.button.target == '_blank' %}
                    rel="noopener noreferrer"
                {% endif %}
            {% endif %}
        {% endif %}
        class="{{ classes.wrapper|join(' ')|trim }}"
        {{ params.attributes|raw }}
    >
        {% if params.icon %}
            <div class="{{ classes.icon|join(' ')|trim }}">
                <i class="{{ params.icon }}"></i>
            </div>
        {% endif %}
        <div class="{{ classes.button|join(' ')|trim }}">
            <span class="text-nowrap">
                {{ params.button.label }}
            </span>
        </div>
    </{{ params.type }}>

{% endif %}
