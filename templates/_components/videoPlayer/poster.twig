{# Default Params #}

{% set defaultParams = {
    image: null,
    transform: '3x4',
    label: 'Play video',
    shade: false,
    class: null
} %}

{# Merge Params #}

{% set params = params is defined ? defaultParams|merge(params) : defaultParams %}

{# Classes #}

{% set classes = {
    button: [
        'group relative block w-full h-full cursor-pointer overflow-hidden bg-black',
        '|',
        'focus:outline-none focus:ring-3 focus:ring-secondary/50',
        params.class
    ],
    play: [
        'absolute inset-0 z-10 flex items-center justify-center'
    ],
    image: [
        params.shade ? 'opacity-60'
    ]
} %}

{# Output #}

<button
    type="button"
    class="{{ classes.button|join(' ')|trim }}"
    aria-label="{{ params.label }}"
    x-ref="poster"
    x-on:click="open()"
>

    {% if params.image %}

        {% include '_components/picture' with {
            params: {
                image: params.image,
                alt: '',
                transform: params.transform,
                focalPoint: true,
                ratio: false,
                wrapperClass: classes.image|join(' ')|trim
            }
        } only %}

    {% endif %}

    <span class="{{ classes.play|join(' ')|trim }}" aria-hidden="true">
        {% include '_components/videoPlayer/playButton' with {
            params: {
                type: 'span'
            }
        } only %}
    </span>

</button>
