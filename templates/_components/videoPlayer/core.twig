{% set component = 'videoPlayer' %}

{# Output #}

{% js %}

    document.addEventListener('alpine:init', () => {
        Alpine.data('{{ component }}', (props) => ({

            visible: false,
            ready: false,
            playing: false,
            muted: false,
            currentTime: 0,
            duration: 0,
            fullscreen: false,
            adapter: null,
            pinned: false,
            started: false,
            ended: false,
            wanted: false,
            ambientAdapter: null,
            ambientStarted: false,

            init() {

                // Hardware media keys would otherwise fight the Controls.
                if (navigator.mediaSession) {
                    ['play', 'pause', 'seekbackward', 'seekforward', 'previoustrack', 'nexttrack'].forEach((action) => {
                        try {
                            navigator.mediaSession.setActionHandler(action, () => {});
                        } catch (error) {}
                    });
                }

                ['fullscreenchange', 'webkitfullscreenchange'].forEach((event) => {
                    document.addEventListener(event, () => {
                        const element = document.fullscreenElement || document.webkitFullscreenElement;
                        this.fullscreen = element === this.$refs.panel;
                    });
                });

                // The Ambient Video waits for the panel to first come into view, so the page loads without an embed.
                if (props.ambient && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
                    const observer = new IntersectionObserver((entries) => {
                        if (!entries.some((entry) => entry.isIntersecting)) return;
                        observer.disconnect();
                        this.createAmbient();
                    });
                    observer.observe(this.$el);
                }

            },

            // The Provider is only created on the first open, so the page loads without an embed.
            create() {

                const provider = window.videoPlayerProviders ? window.videoPlayerProviders[props.provider] : null;

                if (!provider) return;

                this.adapter = provider.create(this.$refs.video, {
                    videoId: props.videoId,
                    videoHash: props.videoHash,
                    videoSrc: props.videoSrc,
                    muted: props.inline === true,
                    onReady: (duration) => {
                        this.ready = true;
                        this.duration = duration || 0;

                        // Inline, the pointer may have left again while the player was loading.
                        if (props.inline) {
                            this.wanted ? this.adapter.play() : this.adapter.pause();
                            return;
                        }

                        this.adapter.unmute();
                        this.adapter.play();
                    },
                    onPlay: () => { this.playing = true; this.started = true; this.ended = false; },
                    onPause: () => { this.playing = false; },
                    onEnded: () => { this.playing = false; this.ended = true; },
                    onTimeUpdate: (current, duration) => {
                        this.currentTime = current || 0;
                        if (duration) this.duration = duration;
                    }
                });

            },

            // A second Provider player that loops muted behind the content, never unmuted and without Controls.
            createAmbient() {

                const provider = window.videoPlayerProviders ? window.videoPlayerProviders[props.provider] : null;

                if (!provider) return;

                this.ambientAdapter = provider.create(this.$refs.ambient, {
                    videoId: props.videoId,
                    videoHash: props.videoHash,
                    videoSrc: props.videoSrc,
                    muted: true,
                    loop: true,
                    background: true,
                    // The Video Modal may have opened while the player was loading.
                    onReady: () => { this.visible ? this.ambientAdapter.pause() : this.ambientAdapter.play(); },
                    onPlay: () => { this.ambientStarted = true; },
                    onPause: () => {},
                    onEnded: () => {},
                    onTimeUpdate: () => {}
                });

            },

            open() {

                this.visible = true;
                document.body.classList.add('overflow-hidden');

                if (this.ambientAdapter) this.ambientAdapter.pause();

                // The close button is only focusable once x-show has revealed the modal.
                this.$nextTick(() => this.$refs.close.focus());

                this.adapter ? this.adapter.play() : this.create();

            },

            close() {

                if (!this.visible) return;

                this.visible = false;
                document.body.classList.remove('overflow-hidden');

                if (this.adapter) this.adapter.pause();
                if (this.ambientAdapter) this.ambientAdapter.play();

                this.$refs.poster.focus();

            },

            togglePlay() {
                if (!this.adapter) return;
                this.playing ? this.adapter.pause() : this.adapter.play();
            },

            toggleMute() {
                if (!this.adapter) return;
                this.muted ? this.adapter.unmute() : this.adapter.mute();
                this.muted = !this.muted;
            },

            seek(event) {

                if (!this.adapter || !this.duration) return;

                const bounds = event.currentTarget.getBoundingClientRect();
                const fraction = Math.min(Math.max((event.clientX - bounds.left) / bounds.width, 0), 1);

                this.adapter.seek(fraction * this.duration);

            },

            // Fullscreen takes the panel, not the video, so the Controls stay on top of it.
            toggleFullscreen() {

                const panel = this.$refs.panel;

                if (document.fullscreenElement || document.webkitFullscreenElement) {
                    const exit = document.exitFullscreen || document.webkitExitFullscreen;
                    if (exit) exit.call(document);
                    return;
                }

                const request = panel.requestFullscreen || panel.webkitRequestFullscreen;
                if (request) request.call(panel);

            },

            hoverPlay() {
                if (!this.hoverable) return;
                this.pinned = false;
                this.playInline();
            },

            hoverPause() {
                if (!this.hoverable || this.pinned) return;
                this.pauseInline();
            },

            // The Time Ring pins what it did, so the pointer leaving or staying cannot undo it.
            toggleInline() {

                this.pinned = true;

                if (this.playing) {
                    this.pauseInline();
                    return;
                }

                // Nothing loops, so the ring's play glyph at the end starts the video again.
                if (this.ended && this.adapter) this.adapter.seek(0);

                this.playInline();

            },

            // The player is only created by the first play, so the page loads without an embed.
            playInline() {
                this.wanted = true;
                this.adapter ? this.adapter.play() : this.create();
            },

            pauseInline() {
                this.wanted = false;
                if (this.adapter) this.adapter.pause();
            },

            formatTime(seconds) {

                const total = Math.floor(!seconds || isNaN(seconds) || seconds < 0 ? 0 : seconds);
                const hours = Math.floor(total / 3600);
                const minutes = Math.floor((total % 3600) / 60);
                const remainder = String(total % 60).padStart(2, '0');

                return hours > 0
                    ? hours + ':' + String(minutes).padStart(2, '0') + ':' + remainder
                    : minutes + ':' + remainder;

            },

            get progress() {
                return this.duration ? (this.currentTime / this.duration) * 100 : 0;
            },

            // Read at the time of the event, so a pointer plugged in later is honoured.
            get hoverable() {
                return window.matchMedia('(hover: hover) and (pointer: fine)').matches
                    && !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            },

            get remaining() {
                return this.formatTime(this.duration - this.currentTime);
            }

        }))
    })

{% endjs %}
