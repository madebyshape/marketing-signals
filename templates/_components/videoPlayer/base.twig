{% set component = 'videoPlayer' %}

{# Default Params #}

{% set defaultParams = {
    video: null,
    videoUrl: null,
    videoFile: null,
    poster: null,
    posterClass: null,
    transform: '3x4',
    playerType: 'modal',
    label: 'Play video',
    size: 'base',
    shade: false,
    modalLabel: 'Video player',
    playButtonClass: 'absolute bottom-5 left-5 z-10 | lg:bottom-10 lg:left-10',
    class: null
} %}

{# Merge Params #}

{% set params = params is defined ? defaultParams|merge(params) : defaultParams %}

{# Video #}

{% set videoUrl = params.video ? params.video.videoUrl : params.videoUrl %}
{% set videoType = params.video ? params.video.videoType.value : null %}
{% set videoFile = params.video ? (videoType == 'file' ? params.video.videoFile.one() : null) : params.videoFile %}
{% set poster = params.video ? params.video.videoThumbnail.one() : params.poster %}

{# Provider #}

{% set url = videoUrl|length ? videoUrl|trim|split('#')|first : '' %}
{% set path = url|split('?')|first|trim('/') %}
{% set query = '&' ~ ('?' in url ? url|split('?')|last : '') %}

{% set vimeoPath = 'player.vimeo.com/video/' in path
    ? path|split('player.vimeo.com/video/')|last
    : ('vimeo.com/' in path ? path|split('vimeo.com/')|last : '') %}

{% set vimeoSegments = vimeoPath|length ? vimeoPath|split('/') : [] %}

{% set vimeoId = (vimeoSegments|length and (vimeoSegments|first matches '/^[0-9]+$/')) ? vimeoSegments|first : null %}

{# An unlisted Vimeo carries its hash as a second segment, which the player needs. #}

{% set videoHash = (vimeoId and vimeoSegments|length > 1) ? vimeoSegments[1] : null %}

{% set youtubePath = '' %}

{% if 'youtu.be/' in path %}
    {% set youtubePath = path|split('youtu.be/')|last %}
{% elseif 'youtube.com/' in path or 'youtube-nocookie.com/' in path %}
    {% if '/shorts/' in path %}
        {% set youtubePath = path|split('/shorts/')|last %}
    {% elseif '/embed/' in path %}
        {% set youtubePath = path|split('/embed/')|last %}
    {% elseif '&v=' in query %}
        {% set youtubePath = query|split('&v=')|last %}
    {% endif %}
{% endif %}

{% set youtubeSegment = youtubePath|length ? youtubePath|split('/')|first|split('&')|first : '' %}

{% set youtubeId = youtubeSegment matches '/^[A-Za-z0-9_-]{6,}$/' ? youtubeSegment : null %}

{% set provider = videoFile ? 'file' : (vimeoId ? 'vimeo' : (youtubeId ? 'youtube' : null)) %}

{# Player Type #}

{# YouTube never plays in place, so an inline Video of one falls back to the Video Modal. #}

{% set playerType = params.playerType == 'ambient' ? 'ambient' : ((params.playerType == 'inline' and provider != 'youtube') ? 'inline' : 'modal') %}

{# Likewise an ambient Video of YouTube keeps its still Poster. #}

{% set ambientVideo = playerType == 'ambient' and provider in ['vimeo', 'file'] %}

{% set props = {
    provider: provider,
    videoId: vimeoId ?? youtubeId,
    videoHash: videoHash,
    videoSrc: videoFile ? videoFile.url : null,
    inline: playerType == 'inline',
    ambient: ambientVideo
} %}

{# Classes #}

{% set classes = {
    wrapper: [
        'relative',
        params.class
    ]
} %}

{# Output #}

{% if playerType == 'ambient' %}

    {% if provider %}

        {% include '_components/videoPlayer/core' only %}

        {% include '_components/videoPlayer/providers/' ~ provider only %}

    {% endif %}

    <div
        class="{{ classes.wrapper|join(' ')|trim }}"
        {% if provider %}x-data='{{ component }}({{ props|json_encode|raw }})'{% endif %}
    >

        {% include '_components/videoPlayer/ambient' with {
            params: {
                poster: poster,
                transform: params.transform,
                video: ambientVideo
            }
        } only %}

        {# An embedding Block fills this with its content and places the Play Button with parent(). #}

        {% block videoPlayerContent %}

            {% if provider %}

                {# The modal returns focus to the `poster` ref when it closes. #}

                {% include '_components/videoPlayer/playButton' with {
                    params: {
                        size: 'md',
                        attributes: 'x-ref="poster" x-on:click="open()"',
                        class: params.playButtonClass
                    }
                } only %}

            {% endif %}

        {% endblock %}

        {% if provider %}

            {% include '_components/videoPlayer/modal' with {
                params: {
                    label: params.modalLabel
                }
            } only %}

        {% endif %}

    </div>

{% elseif provider %}

    {% include '_components/videoPlayer/core' only %}

    {% include '_components/videoPlayer/providers/' ~ provider only %}

    <div
        class="{{ classes.wrapper|join(' ')|trim }}"
        x-data='{{ component }}({{ props|json_encode|raw }})'
    >

        {% if playerType == 'inline' %}

            {% include '_components/videoPlayer/inline' with {
                params: {
                    poster: poster,
                    transform: params.transform,
                    size: params.size,
                    shade: params.shade
                }
            } only %}

        {% else %}

            {% include '_components/videoPlayer/poster' with {
                params: {
                    image: poster,
                    transform: params.transform,
                    label: params.label,
                    size: params.size,
                    shade: params.shade,
                    class: params.posterClass
                }
            } only %}

            {% include '_components/videoPlayer/modal' with {
                params: {
                    label: params.modalLabel
                }
            } only %}

        {% endif %}

    </div>

{% elseif poster %}

    {# No Provider the site can read, so the Poster is a plain image. #}

    {% include '_components/picture' with {
        params: {
            image: poster,
            transform: params.transform,
            focalPoint: true,
            ratio: false,
            wrapperClass: params.class
        }
    } only %}

{% endif %}
