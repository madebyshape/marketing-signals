{% set component = 'videoPlayer' %}

{# Default Params #}

{% set defaultParams = {
    video: null,
    videoUrl: null,
    poster: null,
    posterClass: null,
    transform: '3x4',
    playerType: 'modal',
    label: 'Play video',
    modalLabel: 'Video player',
    class: null
} %}

{# Merge Params #}

{% set params = params is defined ? defaultParams|merge(params) : defaultParams %}

{# Video #}

{% set videoUrl = params.video ? params.video.videoUrl : params.videoUrl %}
{% set poster = params.video ? params.video.videoThumbnail.one() : params.poster %}

{# Provider #}

{% set path = videoUrl|length ? videoUrl|split('?')|first|split('#')|first|trim('/') : '' %}

{% set vimeoPath = 'player.vimeo.com/video/' in path
    ? path|split('player.vimeo.com/video/')|last
    : ('vimeo.com/' in path ? path|split('vimeo.com/')|last : '') %}

{% set vimeoSegments = vimeoPath|length ? vimeoPath|split('/') : [] %}

{% set videoId = (vimeoSegments|length and (vimeoSegments|first matches '/^[0-9]+$/')) ? vimeoSegments|first : null %}

{# An unlisted Vimeo carries its hash as a second segment, which the player needs. #}

{% set videoHash = (videoId and vimeoSegments|length > 1) ? vimeoSegments[1] : null %}

{% set provider = videoId ? 'vimeo' : null %}

{% set props = {
    provider: provider,
    videoId: videoId,
    videoHash: videoHash
} %}

{# Classes #}

{% set classes = {
    wrapper: [
        'relative',
        params.class
    ]
} %}

{# Output #}

{% if provider %}

    {% include '_components/videoPlayer/core' only %}

    {% include '_components/videoPlayer/providers/' ~ provider only %}

    <div
        class="{{ classes.wrapper|join(' ')|trim }}"
        x-data='{{ component }}({{ props|json_encode|raw }})'
    >

        {% include '_components/videoPlayer/poster' with {
            params: {
                image: poster,
                transform: params.transform,
                label: params.label,
                class: params.posterClass
            }
        } only %}

        {% include '_components/videoPlayer/' ~ params.playerType with {
            params: {
                label: params.modalLabel
            }
        } only %}

    </div>

{% elseif poster %}

    {# No Provider the site can read, so the Poster is a plain image. #}

    {% include '_components/picture' with {
        params: {
            image: poster,
            transform: params.transform,
            focalPoint: true,
            ratio: false,
            wrapperClass: params.class
        }
    } only %}

{% endif %}
