{% set component = 'playButton' %}

{# Default Params #}

{% set defaultParams = {
    type: 'button',
    size: 'base',
    label: 'Play video',
    attributes: '',
    class: null
} %}

{# Merge Params #}

{% set params = params is defined ? defaultParams|merge(params) : defaultParams %}

{# Options #}

{# A span is decoration inside a parent `group` button, so it scales on the parent's hover. #}

{% set options = {
    type: {
        button: 'cursor-pointer | motion-safe:pointer-fine:hover:scale-110 focus:outline-none focus:ring-3 focus:ring-secondary/50',
        span: 'motion-safe:pointer-fine:group-hover:scale-110'
    },
    size: {
        sm: {
            circle: 'size-[42px]',
            icon: 'text-[12px]'
        },
        base: {
            circle: 'size-20 | lg:size-30',
            icon: 'text-[24px]'
        },
        md: {
            circle: 'size-20 | lg:size-25',
            icon: 'text-[24px]'
        }
    }
} %}

{# Classes #}

{% set classes = {
    circle: [
        'flex items-center justify-center rounded-full bg-secondary text-black motion-safe:transition-transform motion-safe:duration-300',
        '|',
        options.type[params.type],
        '|',
        options.size[params.size].circle,
        params.class
    ],
    icon: [
        'fa-sharp fa-solid fa-play',
        '|',
        options.size[params.size].icon
    ]
} %}

{# Output #}

<{{ params.type }}
    {% if params.type == 'button' %}
        type="button"
        aria-label="{{ params.label }}"
    {% endif %}
    class="{{ classes.circle|join(' ')|trim }}"
    {{ params.attributes|raw }}
>
    <i class="{{ classes.icon|join(' ')|trim }}"></i>
</{{ params.type }}>
