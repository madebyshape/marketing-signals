{% set component = 'carousel' %}

{# Default Params #}

{% set defaultParams = {
    id: null,
    items: null,
    tag: 'div',
    slideTag: 'div',
    ease: 'smooth',
    props: null,
    class: null,
    innerClass: null,
    slideClass: null,
} %}

{# Merge Params #}

{% set params = params is defined ? defaultParams|merge(params) : defaultParams %}

{# Options #}

{% set options = {
    ease: {
        smooth: 'ease-out!',
        linear: 'ease-linear!',
    }
} %}

{# Classes #}

{# Swiper's stylesheet is unlayered, so utilities overriding it carry the ! suffix. #}

{% set classes = {
    wrapper: [
        'w-full relative',
        params.class
    ],
    swiper: [
        'swiper w-full relative z-0',
        '||',
        'js-carousel-' ~ params.id
    ],
    inner: [
        'swiper-wrapper',
        options.ease[params.ease],
        params.innerClass
    ],
    slide: [
        'swiper-slide flex! h-auto!',
        params.slideClass
    ]
} %}

{# Output #}

{# The Controls go in the after-content slot so their prev/next refs resolve in this Alpine scope. #}

{% if params.items|length %}

    <div
        class="{{ classes.wrapper|join(' ')|trim }}"
        x-data='{{ component }}({{ params.props|json_encode|raw }})'
    >

        {% block beforeContent %}{% endblock %}

        <div class="{{ classes.swiper|join(' ')|trim }}" x-ref="swiper">

            <{{ params.tag }} class="{{ classes.inner|join(' ')|trim }}">

                {% for item in params.items %}

                    <{{ params.slideTag }} class="{{ classes.slide|join(' ')|trim }}">
                        {% block slideContent %}{% endblock %}
                    </{{ params.slideTag }}>

                {% endfor %}

            </{{ params.tag }}>

        </div>

        {% block afterContent %}{% endblock %}

    </div>

{% endif %}

{# prettier-ignore-start #}
{% js %}

    document.addEventListener('alpine:init', () => {
        Alpine.data('{{ component }}', (props) => ({
            activeIndex: 0,
            slideCount: 0,
            isBeginning: true,
            isEnd: false,
            isLocked: false,
            init() {

                const _self = this;
                const { prev, next } = _self.$refs;
                const options = { ...props };

                if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
                    options.speed = 0;
                }

                const swiper = new Swiper(_self.$refs.swiper, {
                    ...options,
                    // Swiper handed a missing navigation element throws on the first press.
                    ...(prev && next ? {
                        navigation: {
                            prevEl: prev,
                            nextEl: next,
                        },
                    } : {}),
                });

                _self.slideCount = swiper.slides.length;

                // Free mode never fires slideChange, so the edges follow the translate.

                const syncEdges = () => {
                    _self.isBeginning = swiper.isBeginning;
                    _self.isEnd = swiper.isEnd;
                    _self.isLocked = swiper.isLocked;
                };

                syncEdges();

                swiper.on('progress resize update lock unlock', syncEdges);

                swiper.on('slideChange', () => {
                    _self.activeIndex = swiper.realIndex;
                });

                swiper.on('update', () => {
                    _self.slideCount = swiper.slides.length;
                });

            },
        }));
    });

{% endjs %}
{# prettier-ignore-end #}
