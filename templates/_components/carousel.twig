{% set component = 'carousel' %}

{# Default Params #}

{% set defaultParams = {
    id: null,
    items: null,
    tag: 'div',
    slideTag: 'div',
    ease: 'smooth',
    props: null,
    class: null,
    innerClass: null,
    slideClass: null,
} %}

{# Merge Params #}

{% set params = params is defined ? defaultParams|merge(params) : defaultParams %}

{# Options #}

{% set options = {
    ease: {
        smooth: 'ease-out!',
        linear: 'ease-linear!',
    }
} %}

{# Classes #}

{# Swiper's stylesheet is unlayered, so it beats a Tailwind utility of the same specificity; the
   classes that replace one of its own declarations carry the `!` suffix to reach it. #}

{% set classes = {
    wrapper: [
        'w-full relative',
        params.class
    ],
    swiper: [
        'swiper w-full relative z-0',
        '||',
        'js-carousel-' ~ params.id
    ],
    inner: [
        'swiper-wrapper',
        options.ease[params.ease],
        params.innerClass
    ],
    slide: [
        'swiper-slide flex! h-auto!',
        params.slideClass
    ]
} %}

{# Output #}

{# The carousel is one Alpine scope: the caller's Controls go in the after-content slot, inside
   it, so the `prev` and `next` refs they carry resolve here and two carousels on one page never
   reach for each other's buttons. #}

{% if params.items|length %}

    <div
        class="{{ classes.wrapper|join(' ')|trim }}"
        x-data='{{ component }}({{ params.props|json_encode|raw }})'
    >

        {% block beforeContent %}{% endblock %}

        <div class="{{ classes.swiper|join(' ')|trim }}" x-ref="swiper">

            <{{ params.tag }} class="{{ classes.inner|join(' ')|trim }}">

                {% for item in params.items %}

                    <{{ params.slideTag }} class="{{ classes.slide|join(' ')|trim }}">
                        {% block slideContent %}{% endblock %}
                    </{{ params.slideTag }}>

                {% endfor %}

            </{{ params.tag }}>

        </div>

        {% block afterContent %}{% endblock %}

    </div>

{% endif %}

{# prettier-ignore-start #}
{% js %}

    document.addEventListener('alpine:init', () => {
        Alpine.data('{{ component }}', (props) => ({
            activeIndex: 0,
            init() {

                const _self = this;
                const { prev, next } = _self.$refs;
                const options = { ...props };

                // A visitor who asked for less motion still pages the row; it just lands the
                // next Slide rather than sliding to it.
                if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
                    options.speed = 0;
                }

                const swiper = new Swiper(_self.$refs.swiper, {
                    ...options,
                    // A caller that leaves the after-content slot empty has no buttons to wire,
                    // and Swiper handed a missing element would throw on the first press.
                    ...(prev && next ? {
                        navigation: {
                            prevEl: prev,
                            nextEl: next,
                        },
                    } : {}),
                });

                swiper.on('slideChange', () => {
                    _self.activeIndex = swiper.realIndex;
                });

            },
        }));
    });

{% endjs %}
{# prettier-ignore-end #}
