{# Default Params #}

{% set defaultParams = {
    content: '',
    colour: 'base',
    size: 'base',
    list: 'base',
    class: null,
} %}

{# Merge Params #}

{% set params = params is defined ? defaultParams|merge(params) : defaultParams %}

{# Options #}

{# Except on base, italic is the highlight marker and takes the alternate colour. #}

{% set options = {
    colour: {
        base: {
            heading: 'text-zinc-900',
            link: 'text-indigo-800 decoration-indigo-300 hover:decoration-indigo-900',
            paragraph: 'text-zinc-700',
            italic: 'italic',
            list: 'text-zinc-700 marker:text-indigo-500',
            blockquote: 'bg-zinc-100 text-zinc-900'
        },
        'creme-100': {
            heading: 'text-creme-100',
            link: 'text-creme-100 decoration-creme-100/50 hover:decoration-creme-100',
            paragraph: 'text-creme-100',
            italic: 'not-italic text-secondary',
            list: 'text-creme-100 marker:text-secondary',
            blockquote: 'bg-creme-100/10 text-creme-100'
        },
        secondary: {
            heading: 'text-secondary',
            link: 'text-creme-100 decoration-creme-100/50 hover:decoration-creme-100',
            paragraph: 'text-secondary',
            italic: 'not-italic text-creme-100',
            list: 'text-secondary marker:text-creme-100',
            blockquote: 'bg-creme-100/10 text-creme-100'
        },
        black: {
            heading: 'text-black',
            link: 'text-primary decoration-primary/50 hover:decoration-primary',
            paragraph: 'text-black',
            italic: 'not-italic text-primary',
            list: 'text-black marker:text-primary',
            blockquote: 'bg-black/10 text-black'
        },
        'black-links': {
            heading: 'text-black',
            link: 'text-black decoration-black',
            paragraph: 'text-black',
            italic: 'not-italic text-primary',
            list: 'text-black marker:text-primary',
            blockquote: 'bg-black/10 text-black'
        },
        white: {
            heading: 'text-white',
            link: 'text-fluro decoration-fluro/50 hover:decoration-fluro',
            paragraph: 'text-white',
            italic: 'not-italic text-fluro',
            list: 'text-white marker:text-fluro',
            blockquote: 'bg-white/10 text-white'
        }
    },
    size: {
        xs: 'text-xs leading-1.33 tracking-tight',
        sm: 'text-sm leading-1.33',
        base: 'text-base leading-1.33',
        md: 'text-md font-normal leading-1.33',
        xl: 'text-xl font-medium leading-1.33 tracking-tighter',
        '2xl': 'text-xl font-medium leading-1.2 tracking-tighter | md:text-2xl',
        '3xl': 'text-2xl font-medium leading-1.2 tracking-tighter | lg:text-3xl',
        '5xl': 'text-3xl font-semibold leading-0.97 tracking-tighter | md:text-4xl | lg:text-5xl',
        '6xl': 'text-3xl font-semibold leading-0.97 tracking-tighter | md:text-4xl | lg:text-6xl',
        longform: 'text-base leading-1.33',
        listPanel: 'text-base leading-1.33'
    },
    h2: {
        longform: 'text-3xl font-semibold leading-0.97 tracking-tighter !mb-6.25 | md:text-4xl | lg:text-5xl',
        listPanel: 'text-4xl !font-medium leading-1.2 tracking-tighter !mb-3.75'
    },
    h3: {
        longform: 'text-2xl !font-medium leading-1.2 tracking-tighter mt-10 !mb-7.5',
        listPanel: 'text-4xl !font-medium leading-1.2 tracking-tighter !mb-3.75'
    },
    strong: {
        longform: 'font-medium'
    },
    table: {
        longform: {
            figure: 'w-full overflow-x-auto mt-10 mb-5 rounded-[10px] | focus:outline-none focus-visible:ring-3 focus-visible:ring-primary/50',
            table: 'w-full min-w-[600px] table-fixed border-separate border-spacing-0',
            cell: 'p-5 align-top bg-creme-100 border-r border-b border-creme-300 leading-1.33 tracking-tight text-black',
            th: 'text-xs font-medium text-center',
            td: 'text-2xs font-normal text-left',
            paragraph: 'mb-0.75 | last:mb-0'
        }
    },
    list: {
        base: {
            list: 'list-outside leading-relaxed pl-4 mb-5',
            item: 'list-disc'
        },
        check: {
            list: 'grid grid-cols-1 gap-y-3.75 mb-5 text-base leading-1.33 | md:grid-cols-2 md:gap-x-5',
            item: 'flex items-start gap-[7px]'
        },
        'check-single': {
            list: 'grid grid-cols-1 gap-y-3.75 mb-5 text-base leading-1.33',
            item: 'flex items-start gap-[7px]'
        },
        longform: {
            list: 'grid grid-cols-1 gap-y-5 mb-5 text-base leading-1.33',
            item: 'group relative pl-3 | before:absolute before:left-0 before:top-2 before:size-[5px] before:rounded-full before:bg-black has-[input]:pl-[26px] has-[input]:before:hidden'
        }
    },
    alternate: {
        listPanel: {
            list: 'grid grid-cols-1 gap-y-3.25 mb-12.5 text-base leading-1.33 | last:mb-0 | md:gap-x-5 md:has-[>li:nth-child(5)]:grid-cols-2',
            item: 'flex items-start gap-[7px]',
            markers: [
                { mark: 'bg-primary', icon: 'fa-check', highlight: 'text-primary' },
                { mark: 'bg-red', icon: 'fa-xmark', highlight: 'text-red' }
            ]
        }
    }
} %}

{% set alternate = options.alternate[params.size] ?? null %}

{# Classes #} 

{% set classes = {
    wrapper: [
        'w-full',
        params.class
    ],
    heading: [
        'font-semibold text-balance mb-4',
        options.colour[params.colour].heading
    ],
    link: [
        'font-medium break-words transition-all underline decoration-1.5 underline-offset-2',
        options.colour[params.colour].link
    ],
    paragraph: [
        'text-pretty mb-5',
        options.size[params.size],
        options.colour[params.colour].paragraph
    ],
    italic: options.colour[params.colour].italic,
    numberList: [
        options.list.base.list,
        options.colour[params.colour].list
    ],
    bulletList: [
        alternate.list ?? options.list[params.list].list,
        options.colour[params.colour].list
    ],
    bulletItem: alternate.item ?? options.list[params.list].item,
    mark: 'flex shrink-0 items-center justify-center order-first size-[19px] mt-px rounded-full bg-secondary text-[10px] text-black',
    alternateMark: 'flex shrink-0 items-center justify-center order-first size-[19px] mt-px rounded-full text-[10px] text-white',
    todoMark: [
        'absolute left-0 top-px flex items-center justify-center size-[19px] rounded-full border border-creme-300 text-[10px] text-transparent',
        '|',
        'group-has-checked:border-secondary group-has-checked:bg-secondary group-has-checked:text-black'
    ],
    blockquote: [
        'relative text-2xl text-pretty font-light rounded-lg py-10 px-7 mb-5',
        options.colour[params.colour].blockquote
    ]
} %}

{# Mark #}

{# The tick is injected here rather than authored in CKEditor, so the stored value stays plain. #}

{# It is injected after the italic pass, which would otherwise overwrite the icon's classes. #}

{% set mark %}<span class="{{ classes.mark }}" aria-hidden="true"><i class="fa-sharp fa-solid fa-check"></i></span>{% endset %}

{% set marks = params.list in ['check', 'check-single'] ? [['inject', 'ul li', mark|trim]] : [] %}

{# A to-do item's mark follows its checkbox, which stays for assistive technology. #}

{% set todoMark %}<span class="{{ classes.todoMark|join(' ')|trim }}" aria-hidden="true"><i class="fa-sharp fa-solid fa-check"></i></span>{% endset %}

{% set marks = params.list == 'longform' ? [
    ['attr', 'ul li input', { class: 'sr-only' }],
    ['inject', 'ul li input + span', todoMark|trim]
] : marks %}

{# Bullet lists take turns between the markers, and a heading's Highlight takes the next list's colour. #}

{% set alternates = [] %}

{% if alternate %}
    {% set headings = ['h2 em', 'h2 i', 'h3 em', 'h3 i'] %}
    {% set lists = (params.content ~ '')|split('<ul')|length - 1 %}
    {% set alternates = [['attr', headings|map(heading => 'body > ' ~ heading), { class: 'not-italic ' ~ (alternate.markers|first).highlight }]] %}

    {% for n in lists ? 1..lists : [] %}
        {% set marker = cycle(alternate.markers, loop.index0) %}
        {% set next = loop.last ? alternate.markers|first : cycle(alternate.markers, loop.index) %}
        {% set list = 'body > ul:nth-of-type(' ~ n ~ ')' %}
        {% set alternateMark %}<span class="{{ classes.alternateMark }} {{ marker.mark }}" aria-hidden="true"><i class="fa-sharp fa-solid {{ marker.icon }}"></i></span>{% endset %}

        {% set alternates = alternates|merge([
            ['inject', list ~ ' > li', alternateMark|trim],
            ['attr', headings|map(heading => list ~ ' ~ ' ~ heading), { class: 'not-italic ' ~ next.highlight }]
        ]) %}
    {% endfor %}
{% endif %}

{# Tables #}

{# The figure's own `table` class is overwritten last, as Tailwind reads it as `display: table`. #}

{% set table = options.table[params.size] ?? null %}
{% set firstRow = ['figure.table thead > tr:first-child', 'figure.table :not(thead) + tbody > tr:first-child', 'figure.table tbody:first-child > tr:first-child'] %}
{% set lastRow = 'figure.table tbody:last-child > tr:last-child' %}

{% set tables = table ? [
    ['attr', 'figure.table table', { class: table.table }],
    ['attr', ['figure.table th', 'figure.table td'], { class: table.cell }, false],
    ['attr', 'figure.table th', { class: table.th }, false],
    ['attr', 'figure.table td', { class: table.td }, false],
    ['attr', ['figure.table th p', 'figure.table td p'], { class: table.paragraph }],
    ['attr', 'figure.table tr > :first-child', { class: 'border-l' }, false],
    ['attr', firstRow|map(row => row ~ ' > *')|join(', '), { class: 'border-t' }, false],
    ['attr', firstRow|map(row => row ~ ' > :first-child')|join(', '), { class: 'rounded-tl-[10px]' }, false],
    ['attr', firstRow|map(row => row ~ ' > :last-child')|join(', '), { class: 'rounded-tr-[10px]' }, false],
    ['attr', lastRow ~ ' > :first-child', { class: 'rounded-bl-[10px]' }, false],
    ['attr', lastRow ~ ' > :last-child', { class: 'rounded-br-[10px]' }, false],
    ['attr', 'figure.table', { class: table.figure, tabindex: '0', role: 'region', 'aria-label': 'Table' }]
] : [] %}

{# Output #}

<div class="{{ classes.wrapper|join(' ')|trim }}">
	{{ params.content|retcon([
        ['attr', ['h1', 'h2', 'h3', 'h4', 'h5', 'h6'], { class: classes.heading|join(' ')|trim }, false],
        ['attr', 'h1', { class: 'text-5xl' }, false],
        ['attr', 'h2', { class: options.h2[params.size] ?? 'text-4xl' }, false],
        ['attr', 'h3', { class: options.h3[params.size] ?? 'text-3xl' }, false],
        ['attr', 'h4', { class: 'text-2xl' }, false],
        ['attr', 'h5', { class: 'text-xl' }, false],
        ['attr', 'h6', { class: 'text-lg' }, false],
        ['attr', 'a', { class: classes.link|join(' ')|trim }],
        ['attr', 'p', { class: classes.paragraph|join(' ')|trim }, false],
        ['attr', 'ol', { class: classes.numberList|join(' ')|trim }],
        ['attr', 'ol li', { class: 'list-decimal' }],
        ['attr', 'ul', { class: classes.bulletList|join(' ')|trim }],
        ['attr', 'ul li', { class: classes.bulletItem }],
        ['attr', ['p:last-of-type'], { class: '!mb-0' }, false],
        ['attr', 'strong', { class: options.strong[params.size] ?? 'font-semibold' }],
        ['attr', ['em', 'i'], { class: classes.italic }],
        ['attr', 'img', { class: 'w-full h-auto rounded-lg mb-5', loading: 'lazy' }],
        ['attr', 'blockquote', { class: classes.blockquote|join(' ')|trim }]
    ]|merge(marks)|merge(alternates)|merge(tables)) }}
</div>

