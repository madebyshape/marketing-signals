{% set component = 'scrollProgress' %}

{# Default Params #}

{% set defaultParams = {
    id: null,
    colour: 'base',
    class: null
} %}

{# Merge Params #}

{% set params = params is defined ? defaultParams|merge(params) : defaultParams %}

{# Options #}

{% set options = {
    colour: {
        base: {
            track: 'bg-creme-300',
            bar: 'bg-primary'
        }
    }
} %}

{# Classes #}

{% set classes = {
    track: [
        'w-full max-w-[257px] h-0.75 overflow-hidden rounded-full',
        options.colour[params.colour].track,
        params.class
    ],
    bar: [
        'w-0 h-full rounded-full',
        options.colour[params.colour].bar
    ]
} %}

{# Output #}

<div
    class="{{ classes.track|join(' ')|trim }}"
    aria-hidden="true"
    x-data="{{ component }}('{{ params.id }}')"
>
    <div class="{{ classes.bar|join(' ')|trim }}" x-ref="bar"></div>
</div>

{# prettier-ignore-start #}
{% js %}

    document.addEventListener('alpine:init', () => {
        Alpine.data('{{ component }}', (id) => ({
            init() {

                const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

                ScrollTrigger.create({
                    trigger: document.getElementById(id),
                    start: 'top top',
                    end: 'bottom bottom',
                    onUpdate: self => {
                        const width = self.progress * 100 + '%';

                        reducedMotion.matches
                            ? gsap.set(this.$refs.bar, { width })
                            : gsap.to(this.$refs.bar, { width, duration: 0.4, ease: 'power1.out', overwrite: 'auto' });
                    }
                });

            }
        }))
    })

{% endjs %}
{# prettier-ignore-end #}
