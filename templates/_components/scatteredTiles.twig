{% set component = 'scatteredTiles' %}

{# Default Params #}

{% set defaultParams = {
    tiles: [],
    transform: '3x5',
    sizes: '(min-width: 1024px) 242px, 120px',
    rounded: 'sm',
    slots: [
        { position: 'top-[-18.9%] left-[2.2%]', speed: 'slow' },
        { position: 'top-[-2.4%] right-[8.5%]', speed: 'mid' },
        { position: 'hidden top-[44%] left-[8.1%] | lg:block', speed: 'fast' },
        { position: 'hidden top-[86.6%] left-[42.6%] | lg:block', speed: 'slow' },
        { position: 'top-[71%] right-[-1.9%]', speed: 'mid' }
    ],
    class: null
} %}

{# Merge Params #}

{% set params = params is defined ? defaultParams|merge(params) : defaultParams %}

{# Options #}

{% set options = {
    speed: {
        slow: 0.1,
        mid: 0.2,
        fast: 0.36
    },
    size: {
        base: 'w-[120px] | lg:w-[242px]',
        md: 'w-[120px] | lg:w-[187px]',
        lg: 'w-[150px] | lg:w-[235px]'
    },
    rounded: {
        sm: 'rounded-[10px]',
        md: 'rounded-[15px]'
    }
} %}

{# Classes #}

{% set tiles = params.tiles|slice(0, params.slots|length) %}

{# The parent clips the Tiles; the layer ignores the pointer so a drifting Tile never takes a click. #}

{% set classes = {
    layer: [
        'absolute inset-0 select-none pointer-events-none',
        params.class
    ],
    tile: [
        'absolute overflow-hidden',
        options.rounded[params.rounded]
    ],
    image: [
        'w-full h-auto'
    ],
    fade: [
        'absolute inset-x-0 bottom-0 h-[38%] bg-linear-to-b from-transparent to-black'
    ],
    caption: [
        'absolute inset-x-2.5 bottom-2.5 flex flex-col text-white | lg:inset-x-3.75 lg:bottom-3.75'
    ],
    title: [
        'text-sm font-medium leading-1.33 | lg:text-base'
    ],
    text: [
        'text-2xs leading-1.33 tracking-tight | lg:text-xs'
    ]
} %}

{# Output #}

{% if tiles|length %}

    <div
        class="{{ classes.layer|join(' ')|trim }}"
        aria-hidden="true"
        x-data="{{ component }}"
        x-ref="layer"
    >

        {# All Tiles sit in the first viewport, so none is lazy loaded. #}

        {% for tile in tiles %}

            {% set slot = params.slots[loop.index0] %}
            {% set title = tile.title ?? '' %}
            {% set text = tile.text ?? '' %}

            <div
                class="{{ classes.tile|merge([options.size[slot.size ?? 'base'], slot.position])|join(' ')|trim }}"
                data-speed="{{ options.speed[slot.speed] }}"
            >

                {% include '_components/picture' with {
                    params: {
                        image: tile.image,
                        alt: '',
                        transform: params.transform,
                        sizes: params.sizes,
                        lazy: false,
                        ratio: false,
                        imgClass: classes.image|join(' ')|trim
                    }
                } only %}

                {% if title|trim|length %}

                    <div class="{{ classes.fade|join(' ')|trim }}"></div>

                    <div class="{{ classes.caption|join(' ')|trim }}">

                        <p class="{{ classes.title|join(' ')|trim }}">{{ title }}</p>

                        {% if text|trim|length %}

                            <p class="{{ classes.text|join(' ')|trim }}">{{ text }}</p>

                        {% endif %}

                    </div>

                {% endif %}

            </div>

        {% endfor %}

    </div>

{% endif %}

{# prettier-ignore-start #}
{% js %}

    document.addEventListener('alpine:init', () => {
        Alpine.data('{{ component }}', () => ({
            init() {

                const layer = this.$refs.layer;
                const tiles = Array.from(layer.children);
                const speeds = tiles.map((tile) => parseFloat(tile.dataset.speed));

                gsap.matchMedia().add({
                    motion: '(prefers-reduced-motion: no-preference)',
                    finePointer: '(pointer: fine)'
                }, (context) => {

                    const { motion, finePointer } = context.conditions;

                    if (!motion) {
                        return;
                    }

                    tiles.forEach((tile, index) => {
                        gsap.to(tile, {
                            yPercent: speeds[index] * 10,
                            ease: 'none',
                            scrollTrigger: {
                                trigger: layer,
                                start: 'top bottom',
                                end: 'bottom top',
                                scrub: true
                            }
                        });
                    });

                    if (!finePointer) {
                        return;
                    }

                    gsap.set(tiles, {
                        willChange: 'transform'
                    });

                    const drifts = tiles.map((tile) => ({
                        x: gsap.quickTo(tile, 'x', { duration: 0.6, ease: 'power3' }),
                        y: gsap.quickTo(tile, 'y', { duration: 0.6, ease: 'power3' })
                    }));

                    // Clamped to half the layer either way, so a Tile travels at most its multiplier of 200px.
                    const clamp = gsap.utils.clamp(-0.5, 0.5);

                    const onPointerMove = (event) => {

                        const bounds = layer.getBoundingClientRect();
                        const x = clamp((event.clientX - bounds.left) / bounds.width - 0.5);
                        const y = clamp((event.clientY - bounds.top) / bounds.height - 0.5);

                        drifts.forEach((drift, index) => {
                            drift.x(x * speeds[index] * 200);
                            drift.y(y * speeds[index] * 200);
                        });

                    };

                    // On the window, since the layer ignores the pointer.
                    window.addEventListener('mousemove', onPointerMove, { passive: true });

                    return () => window.removeEventListener('mousemove', onPointerMove);

                });

            }
        }))
    })

{% endjs %}
{# prettier-ignore-end #}
