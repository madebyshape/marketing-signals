{% set component = 'blogMeta' %}

{# Default Params #}

{% set defaultParams = {
    date: null,
    readTime: null,
    colour: 'black',
    orientation: 'row',
    class: null
} %}

{# Merge Params #}

{% set params = params is defined ? defaultParams|merge(params) : defaultParams %}

{# Content #}

{# Markup chunks only, so nested entries are never loaded. #}

{% set text = params.readTime ? params.readTime.getChunks(false)|filter(chunk => chunk.type == 'markup')|map(chunk => chunk.html)|join(' ') : null %}

{% set readTime %}{% include '_components/readTime' with { params: { text: text } } only %}{% endset %}

{% set hasReadTime = readTime|trim|length %}

{# Options #}

{% set options = {
    colour: {
        black: {
            text: 'text-black',
            divider: 'border-creme-400'
        },
        white: {
            text: 'text-white',
            divider: 'border-white'
        }
    },
    orientation: {
        row: {
            wrapper: 'flex-row flex-wrap items-center gap-x-3.75 gap-y-2',
            date: 'border-r pr-3.75'
        },
        column: {
            wrapper: 'flex-col items-start gap-y-4.5',
            date: null
        }
    }
} %}

{# Classes #}

{% set classes = {
    wrapper: [
        'flex text-base font-normal leading-1.33',
        options.orientation[params.orientation].wrapper,
        options.colour[params.colour].text,
        params.class
    ],
    item: [
        'inline-flex flex-row items-center gap-x-2 whitespace-nowrap'
    ],
    date: [
        hasReadTime ? options.orientation[params.orientation].date,
        options.colour[params.colour].divider
    ],
    icon: [
        'text-[12px]'
    ]
} %}

{# Output #}

<div class="{{ classes.wrapper|join(' ')|trim }}">

    <div class="{{ classes.item|join(' ')|trim }} {{ classes.date|join(' ')|trim }}">

        <i class="{{ classes.icon|join(' ')|trim }} fa-sharp fa-regular fa-calendar-day" aria-hidden="true"></i>

        {% include '_components/date' with {
            params: {
                date: params.date,
                format: 'j F Y'
            }
        } only %}

    </div>

    {% if hasReadTime %}

        <div class="{{ classes.item|join(' ')|trim }}">

            <i class="{{ classes.icon|join(' ')|trim }} fa-sharp fa-regular fa-clock" aria-hidden="true"></i>

            {{ readTime }}

        </div>

    {% endif %}

</div>
