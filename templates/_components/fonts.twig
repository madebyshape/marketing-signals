{# Fonts live in src/public/fonts/ as woff2; every entry is preloaded, so list only critical faces. #}

{% set fonts = {
    'Noi Grotesk': [
        { file: 'noi-grotesk-regular',  weight: 400, style: 'normal' },
        { file: 'noi-grotesk-medium',   weight: 500, style: 'normal' },
        { file: 'noi-grotesk-semibold', weight: 600, style: 'normal' },
    ],
} %}

{# Preload critical font files first so the browser can fetch them early. #}
{% for family, faces in fonts %}
    {% for font in faces %}
        <link rel="preload" href="/dist/fonts/{{ font.file }}.woff2" as="font" type="font/woff2" crossorigin="anonymous">
    {% endfor %}
{% endfor %}

{% if fonts is not empty %}
    <style>
        {% for family, faces in fonts %}
            {% for font in faces %}
                @font-face {
                    font-family: "{{ family }}";
                    src: url("/dist/fonts/{{ font.file }}.woff2") format("woff2");
                    font-weight: {{ font.weight }};
                    font-style: {{ font.style }};
                    font-display: swap;
                }
            {% endfor %}
        {% endfor %}
    </style>
{% endif %}
