{% set component = 'carouselProgress' %}

{# Default Params #}

{% set defaultParams = {
    count: 1,
    class: null
} %}

{# Merge Params #}

{% set params = params is defined ? defaultParams|merge(params) : defaultParams %}

{# Classes #}

{% set classes = {
    track: [
        'w-full h-[3px] overflow-hidden rounded-full bg-creme-300',
        params.class
    ],
    fill: [
        'h-full w-(--carousel-progress) rounded-full bg-primary',
        '|',
        'motion-safe:transition-[width] motion-safe:duration-600 motion-safe:ease-out'
    ]
} %}

{# Output #}

{# It reads the carousel's own state, so it belongs in that carousel's after-content slot. #}

<div class="{{ classes.track|join(' ')|trim }}" aria-hidden="true">

    <div
        class="{{ classes.fill|join(' ')|trim }}"
        style="--carousel-progress: {{ (100 / params.count)|round(2) }}%"
        x-bind:style="{ '--carousel-progress': ((activeIndex + 1) / (slideCount || {{ params.count }})) * 100 + '%' }"
    ></div>

</div>
