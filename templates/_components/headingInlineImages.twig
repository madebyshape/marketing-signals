{% set component = 'headingInlineImages' %}

{# Default Params #}

{% set defaultParams = {
    tag: 'h2',
    heading: null,
    imagePosition: null,
    images: [],
    colour: 'black',
    size: '10xl',
    margin: 'none',
    marginSize: 'base',
    class: null
} %}

{# Merge Params #}

{% set params = params is defined ? defaultParams|merge(params) : defaultParams %}

{# Options #}

{% set options = {
    colour: {
        black: {
            heading: 'text-black',
            highlight: 'not-italic text-primary'
        }
    },
    size: {
        '10xl': 'text-5xl | md:text-7xl | lg:text-9xl | xl:text-10xl'
    },
    placement: {
        start: 'mr-[0.1em]',
        middle: 'mx-[0.1em]',
        end: 'ml-[0.1em]'
    },
    rotate: ['-rotate-5', 'rotate-3', '-rotate-4'],
    margin: {
        base: {
            none: 'm-0',
            top: 'mt-10',
            bottom: 'mb-10',
            topBottom: 'my-10',
        }
    },
} %}

{# Content #}

{% set heading = (params.heading ~ '')|replace({'&nbsp;': ' '})|retcon([
    ['attr', ['em', 'i'], { class: options.colour[params.colour].highlight }],
    ['attr', 'strong', { class: 'font-semibold' }]
])|replace('/<\\/?p\\b[^>]*>/', '')|trim %}

{% set words = heading|striptags|replace('/\\s+/', ' ')|trim|split(' ')|filter(word => word|length) %}
{% set position = params.imagePosition|trim matches '/^\\d+$/' ? params.imagePosition|trim + 0 : 0 %}
{% set placement = position == 0 ? 'start' : (position >= words|length ? 'end' : 'middle') %}

{# Classes #}

{% set classes = {
    heading: [
        'font-semibold leading-0.97 tracking-tighter',
        options.colour[params.colour].heading,
        options.size[params.size],
        options.margin[params.marginSize][params.margin],
        params.class
    ],
    group: [
        'inline-flex items-center align-middle',
        options.placement[placement]
    ],
    tile: [
        'relative block h-[0.878em] w-[0.561em] shrink-0 overflow-hidden rounded-[0.122em] border-2 border-creme-100',
        'not-first:-ml-[0.061em]'
    ],
    space: 'sr-only',
    picture: 'block size-full',
    img: 'size-full object-cover'
} %}

{# Group #}

{% set group %}
    {% if params.images|length %}
        <span class="{{ classes.group|join(' ')|trim }}" aria-hidden="true">
            {% for image in params.images %}
                <span class="{{ classes.tile|join(' ')|trim }} {{ cycle(options.rotate, loop.index0) }}">
                    {% include '_components/picture' with {
                        params: {
                            image: image,
                            alt: '',
                            transform: '2x3',
                            ratio: false,
                            lazy: false,
                            sizes: '100px',
                            pictureClass: classes.picture,
                            imgClass: classes.img
                        }
                    } only %}
                </span>
            {% endfor %}
        </span>
    {% endif %}
{% endset %}

{% set group = group|replace('/>\\s+</', '><')|trim %}

{# Placement #}

{# Open tags close around a mid-sentence group and reopen after it, so a Highlight keeps its colour. #}

{# The hidden space keeps the words apart in the heading's accessible name. #}

{% set output = '' %}
{% set openTags = [] %}
{% set wordIndex = 0 %}
{% set inWord = false %}
{% set swallow = false %}

{% for chunk in heading|split('<') %}

    {% set text = chunk %}

    {% if not loop.first %}
        {% set tag = chunk|split('>', 2) %}
        {% set text = tag|last %}
        {% set tagName = tag|first|split(' ')|first|lower %}

        {% if tagName starts with '/' %}
            {% set openTags = openTags|slice(0, -1) %}
        {% elseif tagName not in ['br', 'br/', 'wbr', 'img'] %}
            {% set openTags = openTags|merge(['<' ~ tag|first ~ '>']) %}
        {% endif %}

        {% set output = output ~ '<' ~ tag|first ~ '>' %}
    {% endif %}

    {% for character in text|split('') %}

        {% if character|trim is empty %}
            {% if inWord %}
                {% set inWord = false %}
                {% set wordIndex = wordIndex + 1 %}

                {% if placement == 'middle' and group and wordIndex == position %}
                    {% set closing = openTags|reverse|map(open => '</' ~ open|slice(1)|split(' ')|first|split('>')|first ~ '>')|join %}
                    {% set output = output ~ closing ~ group ~ '<span class="' ~ classes.space ~ '">&nbsp;</span>' ~ openTags|join %}
                    {% set swallow = true %}
                {% endif %}
            {% endif %}

            {% set output = swallow ? output : output ~ character %}
        {% else %}
            {% set inWord = true %}
            {% set swallow = false %}
            {% set output = output ~ character %}
        {% endif %}

    {% endfor %}

{% endfor %}

{# Output #}

{% if words|length %}

    <{{ params.tag }} class="{{ classes.heading|join(' ')|trim }}">
        {{- placement == 'start' ? group|raw -}}
        {{- output|raw -}}
        {{- placement == 'end' ? group|raw -}}
    </{{ params.tag }}>

{% endif %}
