{#
    The ticker uses a `ticker` keyframes animation, included in the <style>
    block at the bottom of this component so it works standalone.
    Optionally move the keyframes into your Tailwind @theme (src/css/index.css)
    and swap `motion-safe:animate-[ticker_6s_linear_infinite]` for `motion-safe:animate-ticker`:

    @theme {
        --animate-ticker: ticker 6s linear infinite;
        @keyframes ticker {
            0% { transform: translateX(0); }
            100% { transform: translateX(-50%); }
        }
    }
#}

{# Default Params #}

{% set defaultParams = {
    type: 'a',
    button: {},
    colour: 'base',
    size: 'base',
    icon: '',
    iconPosition: 'after',
    ticker: true,
    class: '',
    attributes: ''
} %}

{# Merge Params #}

{% set params = params is defined ? defaultParams|merge(params) : defaultParams %}

{# Options #}

{% set options = {
    colour: {
        base: 'bg-black text-white ring-black/50 pointer-fine:hover:bg-zinc-600',
    },
    size: {
        base: 'text-md px-5 py-3 rounded-md'
    },
    iconPosition: {
        before: 'flex-row',
        after: 'flex-row-reverse'
    }
} %}

{# Classes #}

{% set classes = {
    button: [
        'group inline-flex flex-shrink-0 justify-center items-center relative leading-none overflow-hidden border border-transparent cursor-pointer motion-safe:transition focus:outline-none focus:ring-3',
        options.size[params.size],
        options.colour[params.colour],
        params.class
    ],
    content: [
        'relative z-10 inline-flex flex-shrink-0 justify-center gap-x-2 items-center leading-none motion-safe:transition duration-200',
        params.ticker ? 'pointer-fine:group-hover:opacity-0' : '',
        options.iconPosition[params.iconPosition]
    ],
    icon: [
        'inline-block align-middle motion-safe:transition'
    ],
    ticker: [
        'pointer-events-none absolute inset-0 z-10 flex items-center overflow-hidden opacity-0 motion-safe:transition duration-200 pointer-fine:group-hover:opacity-100'
    ],
    tickerTrack: [
        'flex flex-shrink-0 items-center w-max motion-safe:animate-[ticker_6s_linear_infinite]'
    ],
    tickerItem: [
        'flex-shrink-0 text-nowrap px-2'
    ]
} %}

{# Output #}

{% if params.button|length %}

    <{{ params.type }}
        {% if params.type == 'a' %}
            href="{{ params.button.value }}"
            {% if params.button.target is defined %}
                target="{{ params.button.target }}"
                {% if params.button.target == '_blank' %}
                    rel="noopener noreferrer"
                {% endif %}
            {% endif %}
        {% endif %}
        class="{{ classes.button|join(' ')|trim }}"
        {{ params.attributes|raw }}
    >
        {# Content #}
        <span class="{{ classes.content|join(' ')|trim }}">
            {% if params.icon %}
                <span class="{{ classes.icon|join(' ')|trim }}" aria-hidden="true">
                    <i class="{{ params.icon }}"></i>
                </span>
            {% endif %}
            <span class="text-nowrap">{{ params.button.label }}</span>
        </span>

        {# Ticker #}
        {% if params.ticker %}
            <span class="{{ classes.ticker|join(' ')|trim }}" aria-hidden="true">
                <span class="{{ classes.tickerTrack|join(' ')|trim }}">
                    {# Two identical halves so the -50% loop is seamless #}
                    {% for i in 1..8 %}
                        <span class="{{ classes.tickerItem|join(' ')|trim }}">{{ params.button.label }}</span>
                    {% endfor %}
                </span>
            </span>
        {% endif %}
    </{{ params.type }}>

{% endif %}

{# Remove this <style> block once the `ticker` keyframes are added to your Tailwind @theme (see note at top). #}
<style>
    @keyframes ticker {
        0% { transform: translateX(0); }
        100% { transform: translateX(-50%); }
    }
</style>
