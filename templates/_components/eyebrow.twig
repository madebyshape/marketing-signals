{# Default Params #}

{% set defaultParams = {
    text: null,
    colour: 'black',
    rule: false,
    ruleColour: 'creme-300',
    margin: 'none',
    marginSize: 'base',
    class: null
} %}

{# Merge Params #}

{% set params = params is defined ? defaultParams|merge(params) : defaultParams %}

{# Options #}

{# The Rule is the wrapper's own bottom border, so it spans the wrapper rather than the text and
   needs no element of its own. Its 10px of padding, the 21px of text above it and the border make
   the design's 31px row. Its colour is set apart from the text so a dark section can take a white
   Rule under white, creme or primary text. #}

{% set options = {
    colour: {
        black: 'text-black',
        white: 'text-white',
        'creme-100': 'text-creme-100',
        primary: 'text-primary'
    },
    rule: 'pb-2.5 border-b',
    ruleColour: {
        'creme-300': 'border-creme-300',
        white: 'border-white'
    },
    margin: {
        base: {
            none: 'm-0',
            top: 'mt-10 | lg:mt-15',
            bottom: 'mb-10 | lg:mb-15',
            topBottom: 'my-10 | lg:my-15',
        }
    },
} %}

{# Classes #}

{% set classes = {
    wrapper: [
        params.rule ? options.rule : '',
        params.rule ? (options.ruleColour[params.ruleColour] ?? '') : '',
        options.margin[params.marginSize][params.margin] ?: '',
        params.class ?: ''
    ],
    eyebrow: [
        'text-base font-medium leading-1.33',
        options.colour[params.colour] ?: '',
    ]
} %}

{# Output #}

<div class="{{ classes.wrapper|join(' ')|trim }}">
    <div class="{{ classes.eyebrow|join(' ')|trim }}">{{ params.text }}</div>
</div>
