{# Default Params #}

{% set defaultParams = {
    text: null,
    colour: 'black',
    rule: false,
    ruleColour: 'creme-300',
    aside: null,
    asideAttributes: null,
    margin: 'none',
    marginSize: 'base',
    class: null
} %}

{# Merge Params #}

{% set params = params is defined ? defaultParams|merge(params) : defaultParams %}

{# Options #}

{% set options = {
    colour: {
        black: 'text-black',
        white: 'text-white',
        'creme-100': 'text-creme-100',
        primary: 'text-primary'
    },
    rule: 'pb-2.5 border-b',
    ruleColour: {
        'creme-300': 'border-creme-300',
        white: 'border-white',
        'white-30': 'border-white/30',
        black: 'border-black'
    },
    aside: 'flex flex-row items-baseline justify-between gap-x-5',
    margin: {
        base: {
            none: 'm-0',
            top: 'mt-10 | lg:mt-15',
            bottom: 'mb-10 | lg:mb-15',
            topBottom: 'my-10 | lg:my-15',
        }
    },
} %}

{# Classes #}

{% set classes = {
    wrapper: [
        params.aside|length ? options.aside : '',
        params.rule ? options.rule : '',
        params.rule ? (options.ruleColour[params.ruleColour] ?? '') : '',
        options.margin[params.marginSize][params.margin] ?: '',
        params.class ?: ''
    ],
    eyebrow: [
        'text-base font-medium leading-1.33',
        options.colour[params.colour] ?: '',
    ]
} %}

{# Output #}

<div class="{{ classes.wrapper|join(' ')|trim }}">
    <div class="{{ classes.eyebrow|join(' ')|trim }}">{{ params.text }}</div>

    {% if params.aside|length %}

        <div
            class="{{ classes.eyebrow|join(' ')|trim }}"
            {{ params.asideAttributes|raw }}
        >{{ params.aside }}</div>

    {% endif %}
</div>
