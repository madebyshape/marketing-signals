{% set component = 'chunks' %}

{# Default Params #}

{% set defaultParams = {
    richText: null,
    gap: 'md',
    size: 'md',
    colour: 'base',
    list: 'base',
    vars: null,
    class: null
} %}

{# Merge Params #}

{% set params = params is defined ? defaultParams|merge(params) : defaultParams %}

{# Options #}

{% set options = {
    gap: {
        sm: params.vars.class.gap.y.sm,
        base: params.vars.class.gap.y.base,
        md: params.vars.class.gap.y.md,
        lg: params.vars.class.gap.y.lg,
        xl: params.vars.class.gap.y.xl,
        xxl: params.vars.class.gap.y.xxl,
    }
} %}

{# Classes #}

{% set classes = {
    wrapper: [
        'grid',
        '|',
        options.gap[params.gap],
        params.class
    ]
} %}

{# Output #}

<div class="{{ classes.wrapper|join(' ')|trim }}">

    {% for chunk in params.richText ?? [] %}

        {% if chunk.type == 'markup' %}

            {% include '_components/richText' with {
                params: {
                    content: chunk.html,
                    colour: params.colour,
                    size: params.size,
                    list: params.list
                }
            } only %}

        {% elseif chunk.entry ?? false %}

            {{ chunk.entry.render({
                vars: params.vars
            }) }}

        {% endif %}

    {% endfor %}

</div>
