{% set component = 'tableOfContents' %}

{# Default Params #}

{% set defaultParams = {
    id: null,
    heading: 'Table of Contents',
    class: null
} %}

{# Merge Params #}

{% set params = params is defined ? defaultParams|merge(params) : defaultParams %}

{# Classes #}

{% set classes = {
    wrapper: [
        'w-full max-w-[257px]',
        params.class
    ],
    heading: [
        'mb-3 text-xs leading-1.33 tracking-tight text-creme-500'
    ],
    list: [
        'flex flex-col gap-5 list-inside list-decimal text-sm leading-1.33'
    ],
    item: [
        'has-[a:hover]:text-primary has-focus-visible:text-primary'
    ],
    link: [
        'rounded-xs',
        '|',
        'hover:underline focus:outline-none focus-visible:underline focus-visible:ring-3 focus-visible:ring-primary/50'
    ]
} %}

{# Output #}

<nav
    class="{{ classes.wrapper|join(' ')|trim }}"
    aria-labelledby="{{ component }}-{{ params.id }}"
    x-data="{{ component }}"
    x-init="collect('{{ params.id }}')"
>

    <p id="{{ component }}-{{ params.id }}" class="{{ classes.heading|join(' ')|trim }}">{{ params.heading }}</p>

    <ol class="{{ classes.list|join(' ')|trim }}">

        <template x-for="(heading, index) in headings" :key="heading.id">

            <li
                class="{{ classes.item|join(' ')|trim }}"
                :class="index === active ? 'text-primary' : 'text-black'"
            >
                <a
                    :href="'#' + heading.id"
                    class="{{ classes.link|join(' ')|trim }}"
                    :class="index === active && 'underline'"
                    x-text="heading.title"
                    @click.prevent="scrollToHash('#' + heading.id)"
                ></a>
            </li>

        </template>

    </ol>

</nav>

{# prettier-ignore-start #}
{% js %}

    document.addEventListener('alpine:init', () => {
        Alpine.data('{{ component }}', () => ({
            headings: [],
            active: 0,
            collect(id) {

                const elements = [...document.getElementById(id).querySelectorAll('h2[id]')];

                this.headings = elements.map(heading => ({ id: heading.id, title: heading.textContent.trim() }));

                // The active entry is the last H2 above a line a third of the way down the viewport.
                const update = () => {
                    const passed = elements.filter(heading => heading.getBoundingClientRect().top <= window.innerHeight / 3);

                    this.active = Math.max(passed.length - 1, 0);
                };

                update();
                window.addEventListener('scroll', update, { passive: true });

            }
        }))
    })

{% endjs %}
{# prettier-ignore-end #}
