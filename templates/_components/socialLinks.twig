{% set component = 'socialLinks' %}

{# Default Params #}

{% set defaultParams = {
    direction: 'vertical',
    size: 'base',
    class: null
} %}

{# Merge Params #}

{% set params = params is defined ? defaultParams|merge(params) : defaultParams %}

{# Options #}

{% set options = {
    labels: {
        twitter: 'Twitter / X',
        facebook: 'Facebook',
        linkedin: 'LinkedIn'
    },
    direction: {
        vertical: {
            list: '',
            item: 'flex items-center h-11'
        },
        horizontal: {
            list: 'flex flex-wrap gap-x-7.5 gap-y-2.5',
            item: ''
        }
    },
    size: {
        lg: 'text-lg font-medium leading-1.2 tracking-tighter',
        base: 'text-base font-medium leading-1.33'
    }
} %}

{# Classes #}

{% set classes = {
    wrapper: [
        params.class
    ],
    list: [
        options.direction[params.direction].list
    ],
    item: [
        options.direction[params.direction].item
    ],
    link: [
        'link | inline-block text-white',
        options.size[params.size]
    ]
} %}

{# Output #}

{% set sameAsLinks = seomatic.site.sameAsLinks ?? [] %}
{% set links = options.labels|filter((label, handle) => sameAsLinks[handle] is defined and sameAsLinks[handle].url) %}

{% if links|length %}

    <nav class="{{ classes.wrapper|join(' ')|trim }}" aria-label="Social Links">

        <ul class="{{ classes.list|join(' ')|trim }}">

            {% for handle, label in links %}

                <li class="{{ classes.item|join(' ')|trim }}">
                    <a
                        href="{{ sameAsLinks[handle].url }}"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="{{ classes.link|join(' ')|trim }}"
                    >{{ label }}</a>
                </li>

            {% endfor %}

        </ul>

    </nav>

{% endif %}
