{% set component = 'socialShare' %}

{# Default Params #}

{% set defaultParams = {
    links: ['linkedin', 'x', 'facebook', 'threads', 'whatsapp', 'messenger', 'email'],
    url: craft.app.request.absoluteUrl,
    text: '',
    heading: null,
    colour: 'base',
    size: 'base',
    direction: 'horizontal',
    class: null
} %}

{# Merge Params #}

{% set params = params is defined ? defaultParams|merge(params) : defaultParams %}

{# Options #}

{% set options = {
    links: {
        linkedin: {
            title: 'Share on LinkedIn',
            url: 'https://www.linkedin.com/sharing/share-offsite/?url=' ~ params.url|url_encode,
            icon: 'fa-brands fa-linkedin-in'
        },
        x: {
            title: 'Share on X / Twitter',
            url: 'https://x.com/intent/tweet?text=' ~ params.text ~ ' - ' ~ params.url|url_encode,
            icon: 'fa-brands fa-x-twitter'
        },
        facebook: {
            title: 'Share on Facebook',
            url: 'https://www.facebook.com/sharer/sharer.php?u=' ~ params.url|url_encode,
            icon: 'fa-brands fa-facebook-f'
        },
        threads: {
            title: 'Share on Threads',
            url: 'https://threads.net/intent/post?text=' ~ params.text ~ ' - ' ~ params.url|url_encode,
            icon: 'fa-brands fa-threads'
        },
        whatsapp: {
            title: 'Share on WhatsApp',
            url: 'https://api.whatsapp.com/send?text=' ~ params.text ~ ' - ' ~ params.url|url_encode,
            icon: 'fa-brands fa-whatsapp'
        },
        messenger: {
            title: 'Share on Messenger',
            url: 'fb-messenger://share/?link=' ~ params.url|url_encode,
            icon: 'fa-brands fa-facebook-messenger'
        },
        email: {
            title: 'Share on Email',
            url: 'mailto:?subject=' ~ params.text ~ '&body=' ~ params.url|url_encode,
            icon: 'fa-solid fa-envelope',
            popup: false
        },
        copy: {
            title: 'Copy link',
            icon: 'fa-sharp fa-regular fa-link',
            copiedIcon: 'fa-sharp fa-regular fa-check'
        }
    },
    colour: {
        base: 'border-creme-300 bg-creme-100 text-black | hover:border-primary hover:bg-primary hover:text-white focus-visible:border-primary focus-visible:bg-primary focus-visible:text-white focus-visible:ring-3 focus-visible:ring-primary/50'
    },
    size: {
        base: 'size-[35px] text-[13px]'
    },
    direction: {
        horizontal: 'flex flex-row gap-1.25',
        vertical: 'flex flex-col gap-1.25'
    }
} %}

{# Classes #}

{% set classes = {
    wrapper: [
        params.class
    ],
    heading: [
        'mb-5 text-sm leading-1.33 text-creme-500'
    ],
    list: [
        options.direction[params.direction]
    ],
    link: [
        'flex items-center justify-center rounded-full border cursor-pointer motion-safe:transition-colors focus:outline-none',
        options.colour[params.colour],
        options.size[params.size]
    ]
} %}

{# Output #}

<nav class="{{ classes.wrapper|join(' ')|trim }}" aria-label="Social sharing" x-data="{{ component }}('{{ params.url|e('js') }}')">

    {% if params.heading %}
        <p class="{{ classes.heading|join(' ')|trim }}">{{ params.heading }}</p>
    {% endif %}

    <ul class="{{ classes.list|join(' ')|trim }}">

        {% for handle in params.links %}

            {% set link = options.links[handle] ?? null %}

            {% if link and handle == 'copy' %}

                <li>

                    <button
                        type="button"
                        class="{{ classes.link|join(' ')|trim }}"
                        aria-label="{{ link.title }}"
                        @click="copy"
                    >
                        <span x-show="!copied"><i class="{{ link.icon }}" aria-hidden="true"></i></span>
                        <span x-show="copied" x-cloak><i class="{{ link.copiedIcon }}" aria-hidden="true"></i></span>
                    </button>

                    <span class="sr-only" aria-live="polite" x-text="copied ? 'Link copied' : ''"></span>

                </li>

            {% elseif link %}

                <li>

                    <a
                        href="{{ link.url }}"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="{{ classes.link|join(' ')|trim }}"
                        aria-label="{{ link.title }}"
                        {% if link.popup ?? true %}
                            x-on:click.prevent="window.open('{{ link.url }}', 'Share', 'width=600,height=400')"
                            role="button"
                        {% endif %}
                    >
                        <i class="{{ link.icon }}" aria-hidden="true"></i>
                        <span class="sr-only">{{ link.title }}</span>
                    </a>

                </li>

            {% endif %}

        {% endfor %}

    </ul>

</nav>

{# prettier-ignore-start #}
{% js %}

    document.addEventListener('alpine:init', () => {
        Alpine.data('{{ component }}', (url) => ({
            copied: false,
            timer: null,
            copy() {

                navigator.clipboard.writeText(url).then(() => {
                    this.copied = true;

                    clearTimeout(this.timer);
                    this.timer = setTimeout(() => this.copied = false, 2000);
                });

            }
        }))
    })

{% endjs %}
{# prettier-ignore-end #}
