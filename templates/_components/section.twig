{# Default Params #}

{% set defaultParams = {
    id: null,
    class: null,
    attributes: null,
    paddingY: 'topBottom',
    paddingYSize: 'base',
    paddingX: 'leftRight'
} %}

{# Merge Params #}

{% set params = params is defined ? defaultParams|merge(params) : defaultParams %}

{# Options #}

{% set options = {
    paddingY: {
        base: {
            'top': 'pt-16 | lg:pt-20 | xl:pt-24 | 2xl:pt-32',
            'bottom': 'pb-16 | lg:pb-20 | xl:pb-24 | 2xl:pb-32',
            'topBottom': 'py-16 | lg:py-20 | xl:py-24 | 2xl:py-32',
            'none': 'py-0'
        }
    },
    paddingX: {
        leftRight: vars is defined ? vars.class.siteMargin.x : 'px-10',
        left: vars is defined ? vars.class.siteMargin.l : 'pl-10',
        right: vars is defined ? vars.class.siteMargin.r : 'pr-10',
        none: 'px-0'
    }
} %}

{# Classes #}

{% set classes = {
    section: [
        'w-full',
        options.paddingY[params.paddingYSize][params.paddingY],
        params.class
    ],
    content: [
        'w-full',
        options.paddingX[params.paddingX]
    ]
} %}

{# Output #}

<section
    class="{{ classes.section|join(' ')|trim }}"
    {{ params.id|length ? 'id="' ~ params.id ~ '"' }}
    {{ params.attributes|raw }}
>

    <div class="{{ classes.content|join(' ')|trim }}">

        {% block sectionContent %}
        {% endblock %}

    </div>

</section>