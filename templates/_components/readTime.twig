{% set component = 'readTime' %}

{# Default Params #}

{% set defaultParams = {
    text: null,
    wordsPerMinute: 265,
    icon: null,
    class: null
} %}

{# Merge Params #}

{% set params = params is defined ? defaultParams|merge(params) : defaultParams %}

{# Classes #}

{% set classes = {
    wrapper: [
        'flex items-center gap-1.75 text-base leading-1.33',
        params.class
    ],
    icon: [
        'text-[12px]',
        params.icon
    ]
} %}

{# Output #}

{# Spaces before tags and entities keep words in adjacent elements apart. #}

{% set words = (params.text ?? '')|replace({ '<': ' <' })|striptags|replace('/&[^;\\s]+;|[\\s—–-]+/u', ' ')|trim|split(' ')|filter(word => word) %}

{% if words|length %}

    <div class="{{ classes.wrapper|join(' ')|trim }}">

        {% if params.icon %}
            <i class="{{ classes.icon|join(' ')|trim }}" aria-hidden="true"></i>
        {% endif %}

        {{ ceil(words|length / params.wordsPerMinute) }} min read

    </div>

{% endif %}
