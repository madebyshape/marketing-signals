{% set component = 'header' %}

{# Default Params #}

{% set defaultParams = {
    colour: 'creme-100',
    class: null
} %}

{# Merge Params #}

{% set params = params is defined ? defaultParams|merge(params) : defaultParams %}

{# Options #}

{% set options = {
    colour: {
        'creme-100': {
            wrapper: 'text-black',
            background: 'bg-creme-100',
            panel: 'bg-creme-100 text-black',
            divider: 'border-black/10',
            button: 'white'
        },
        black: {
            wrapper: 'text-white',
            background: 'bg-black',
            panel: 'bg-black text-white',
            divider: 'border-white/10',
            button: 'creme-100'
        }
    }
} %}

{# Classes #}

{% set classes = {
    wrapper: [
        'fixed inset-x-0 top-0 z-50 flex items-center justify-between motion-safe:transition-transform motion-safe:duration-500',
        options.colour[params.colour].wrapper,
        vars.class.siteMargin.x,
        vars.class.header.height,
        params.class
    ],
    logoLink: 'block flex-shrink-0',
    logo: 'w-40 h-auto | xl:w-[213px]',
    nav: 'absolute left-1/2 -translate-x-1/2 hidden | xl:block',
    list: [
        'flex items-center',
        vars.class.gap.x.lg
    ],
    dropdownItem: 'flex items-center gap-1.5',
    dropdownButton: 'inline-flex size-5 items-center justify-center rounded-full cursor-pointer | focus:outline-none focus:ring-3 focus:ring-current/20',
    dropdownIcon: 'block text-xs leading-none motion-safe:transition-transform motion-safe:duration-300',
    overlay: 'fixed inset-0 z-30 hidden motion-safe:transition motion-safe:duration-500 | xl:block',
    button: 'hidden | xl:block',
    burger: 'inline-flex flex-shrink-0 items-center justify-center size-10 -mr-2 rounded-full cursor-pointer | focus:outline-none focus:ring-3 focus:ring-current/20 | xl:hidden',
    burgerBars: 'relative flex flex-col justify-between w-6 h-2',
    burgerBar: 'block w-full h-px origin-center bg-current motion-safe:transition-transform motion-safe:duration-300',
    panel: [
        'fixed inset-0 z-40 flex flex-col overflow-y-auto overscroll-contain pb-10 motion-safe:transition-opacity motion-safe:duration-500',
        options.colour[params.colour].panel,
        vars.class.siteMargin.x,
        vars.class.header.paddingTop,
        vars.class.gap.y.lg,
        'xl:hidden || js-modal'
    ],
    panelItem: [
        'border-b | first:border-t',
        options.colour[params.colour].divider
    ],
    panelRow: 'flex items-center justify-between gap-5',
    panelButton: [
        'flex size-6.25 shrink-0 items-center justify-center rounded-full border cursor-pointer | focus:outline-none focus:ring-3 focus:ring-current/20',
        options.colour[params.colour].divider
    ],
    panelIcon: 'block text-[10px] leading-none motion-safe:transition-transform motion-safe:duration-300',
    panelDropdown: 'motion-reduce:duration-0!',
    panelList: 'flex flex-col gap-y-3 pb-5',
    panelLink: 'link | inline-block text-lg leading-1.2 tracking-tighter'
} %}

{# Output #}

{% set menuItems = site.mainMenu.all() %}
{% set currentElement = craft.app.urlManager.matchedElement %}
{% set dropdownItems = menuItems|filter(item => item.type.handle == 'menuDropdownItem' and item.dropdownLinks.exists()) %}
{% set dropdownIds = dropdownItems|map(item => item.id) %}

<div
    x-data="{{ component }}"
    x-on:keydown.escape.window="mobileMenu = false; closeDropdown(true)"
>

    {# js-modal while the Mobile Menu is open so Lenis leaves scrolling to the browser. #}

    <header
        class="{{ classes.wrapper|join(' ')|trim }}"
        x-bind:class="{
            '-translate-y-full': !isVisible && !mobileMenu && !dropdown,
            '{{ options.colour[params.colour].background }}': hasBackground || mobileMenu || dropdown,
            'js-modal': mobileMenu
        }"
        x-on:mouseenter="cancelDropdownClose()"
        x-on:mouseleave="scheduleDropdownClose()"
    >

        <a href="{{ siteUrl }}" class="{{ classes.logoLink }}" aria-label="{{ siteName }}">
            {% include '_components/logo' with {
                params: {
                    class: classes.logo
                }
            } only %}
        </a>

        {% if menuItems|length %}

            <nav class="{{ classes.nav }}" aria-label="Main Menu">

                <ul class="{{ classes.list|join(' ')|trim }}">

                    {% for item in menuItems %}

                        {% set link = item.linksTo %}
                        {% set active = currentElement and link.type == 'entry' and link.element and link.element.id == currentElement.id %}
                        {% set hasDropdown = item.id in dropdownIds %}
                        {% set open = "dropdown === '" ~ item.id ~ "'" %}

                        <li
                            {% if hasDropdown %}
                                class="{{ classes.dropdownItem }}"
                                x-on:mouseenter="hoverDropdown('{{ item.id }}')"
                            {% else %}
                                x-on:mouseenter="closeDropdown()"
                            {% endif %}
                        >
                            <a
                                href="{{ link.value }}"
                                {% if link.target %}
                                    target="{{ link.target }}"
                                    {% if link.target == '_blank' %}
                                        rel="noopener noreferrer"
                                    {% endif %}
                                {% endif %}
                                {% if active %}
                                    aria-current="page"
                                {% endif %}
                                class="link{{ active ? ' link--active' : '' }} | block text-xs leading-1.33 tracking-tight"
                            >{{ link.label }}</a>

                            {% if hasDropdown %}

                                <button
                                    type="button"
                                    class="{{ classes.dropdownButton }}"
                                    aria-controls="dropdown-{{ item.id }}"
                                    aria-label="Show {{ link.label }} links"
                                    x-ref="dropdownButton{{ item.id }}"
                                    x-bind:aria-expanded="{{ open|raw }}"
                                    x-on:click="toggleDropdown('{{ item.id }}')"
                                    x-on:keydown.tab="focusDropdown($event, '{{ item.id }}')"
                                >
                                    {# The kit swaps each icon for an SVG, so the rotation is bound on the span around it. #}

                                    <span
                                        class="{{ classes.dropdownIcon }}"
                                        x-bind:class="{ 'rotate-45': {{ open|raw }} }"
                                        aria-hidden="true"
                                    >
                                        <i class="fa-sharp fa-regular fa-plus"></i>
                                    </span>
                                </button>

                            {% endif %}
                        </li>

                    {% endfor %}

                </ul>

            </nav>

        {% endif %}

        <div class="{{ classes.button }}">
            {% include '_components/button' with {
                params: {
                    button: site.headerButton,
                    colour: options.colour[params.colour].button,
                    iconStyle: 'circle'
                }
            } only %}
        </div>

        <button
            type="button"
            class="{{ classes.burger }}"
            aria-controls="mobile-menu"
            x-bind:aria-expanded="mobileMenu"
            x-bind:aria-label="mobileMenu ? 'Close menu' : 'Open menu'"
            x-on:click="mobileMenu = !mobileMenu"
        >
            <span class="{{ classes.burgerBars }}" aria-hidden="true">
                <span
                    class="{{ classes.burgerBar }}"
                    x-bind:class="{
                        'translate-y-[3.5px] rotate-45': mobileMenu
                    }"
                ></span>
                <span
                    class="{{ classes.burgerBar }}"
                    x-bind:class="{
                        '-translate-y-[3.5px] -rotate-45': mobileMenu
                    }"
                ></span>
            </span>
        </button>

    </header>

    <div
        id="mobile-menu"
        class="{{ classes.panel|join(' ')|trim }}"
        x-cloak
        x-bind:class="{
            'opacity-0 pointer-events-none': !mobileMenu,
            'opacity-100 pointer-events-auto': mobileMenu
        }"
        x-bind:inert="!mobileMenu"
        x-bind:aria-hidden="!mobileMenu"
    >

        {% if menuItems|length %}

            <nav aria-label="Mobile Menu" x-data="{ row: null }">

                <ul>

                    {% for item in menuItems %}

                        {% set link = item.linksTo %}
                        {% set active = currentElement and link.type == 'entry' and link.element and link.element.id == currentElement.id %}
                        {% set hasDropdown = item.id in dropdownIds %}
                        {% set open = "row === '" ~ item.id ~ "'" %}

                        <li class="{{ classes.panelItem|join(' ')|trim }}">

                            {% if hasDropdown %}
                                <div class="{{ classes.panelRow }}">
                            {% endif %}

                            <a
                                href="{{ link.value }}"
                                {% if link.target %}
                                    target="{{ link.target }}"
                                    {% if link.target == '_blank' %}
                                        rel="noopener noreferrer"
                                    {% endif %}
                                {% endif %}
                                {% if active %}
                                    aria-current="page"
                                {% endif %}
                                class="link{{ active ? ' link--active' : '' }} | inline-block py-4 text-2xl leading-1.2 tracking-tighter"
                            >{{ link.label }}</a>

                            {% if hasDropdown %}

                                    <button
                                        type="button"
                                        class="{{ classes.panelButton|join(' ')|trim }}"
                                        aria-controls="mobile-dropdown-{{ item.id }}"
                                        aria-label="Show {{ link.label }} links"
                                        x-bind:aria-expanded="{{ open|raw }} ? 'true' : 'false'"
                                        x-on:click="row = {{ open|raw }} ? null : '{{ item.id }}'"
                                    >
                                        <span
                                            class="{{ classes.panelIcon }}"
                                            x-bind:class="{ 'rotate-180': {{ open|raw }} }"
                                            aria-hidden="true"
                                        >
                                            <i class="fa-sharp fa-regular fa-chevron-down"></i>
                                        </span>
                                    </button>

                                </div>

                                <div
                                    id="mobile-dropdown-{{ item.id }}"
                                    class="{{ classes.panelDropdown }}"
                                    x-show="{{ open|raw }}"
                                    x-collapse.duration.300
                                    x-cloak
                                >
                                    <ul class="{{ classes.panelList }}">

                                        {% for dropdownLink in item.dropdownLinks.all() %}

                                            {% set dropdownLinksTo = dropdownLink.linksTo %}

                                            <li>
                                                <a
                                                    href="{{ dropdownLinksTo.value }}"
                                                    {% if dropdownLinksTo.target %}
                                                        target="{{ dropdownLinksTo.target }}"
                                                        {% if dropdownLinksTo.target == '_blank' %}
                                                            rel="noopener noreferrer"
                                                        {% endif %}
                                                    {% endif %}
                                                    class="{{ classes.panelLink }}"
                                                >{{ dropdownLinksTo.label }}</a>
                                            </li>

                                        {% endfor %}

                                    </ul>
                                </div>

                            {% endif %}

                        </li>

                    {% endfor %}

                </ul>

            </nav>

        {% endif %}

        <div>
            {% include '_components/button' with {
                params: {
                    button: site.headerButton,
                    colour: options.colour[params.colour].button,
                    iconStyle: 'circle'
                }
            } only %}
        </div>

    </div>

    <div
        class="{{ classes.overlay }}"
        aria-hidden="true"
        x-cloak
        x-bind:class="{
            'backdrop-blur-lg pointer-events-auto': dropdown,
            'pointer-events-none': !dropdown
        }"
        x-on:mouseenter="scheduleDropdownClose()"
        x-on:click="closeDropdown()"
    ></div>

    {% for item in dropdownItems %}
        {% include '_components/global/dropdown' with {
            params: {
                item: item
            }
        } %}
    {% endfor %}

</div>

{% js %}

    document.addEventListener('alpine:init', () => {
        Alpine.data('{{ component }}', () => ({
            threshold: 100,
            scrollPosition: 0,
            direction: 'up',
            isPastThreshold: false,
            isVisible: true,
            hasBackground: false,
            mobileMenu: false,
            dropdown: null,
            dropdownTimer: null,
            openDropdown(id) {
                clearTimeout(this.dropdownTimer);
                this.dropdown = id;
            },
            hoverDropdown(id) {
                if (window.matchMedia('(pointer: fine)').matches) {
                    this.openDropdown(id);
                }
            },
            toggleDropdown(id) {
                this.dropdown === id ? this.closeDropdown() : this.openDropdown(id);
            },
            closeDropdown(returnFocus = false) {

                clearTimeout(this.dropdownTimer);

                if (returnFocus && this.dropdown) {
                    this.$refs['dropdownButton' + this.dropdown]?.focus();
                }

                this.dropdown = null;

            },
            scheduleDropdownClose() {

                if (!this.dropdown) {
                    return;
                }

                clearTimeout(this.dropdownTimer);
                this.dropdownTimer = setTimeout(() => this.closeDropdown(), 150);

            },
            cancelDropdownClose() {
                clearTimeout(this.dropdownTimer);
            },
            focusDropdown(event, id) {

                if (this.dropdown !== id || event.shiftKey) {
                    return;
                }

                // The Dropdown sits after the header in the DOM, so Tab from its "+" is sent straight to it.
                const link = this.$refs['dropdown' + id]?.querySelector('a');

                if (link) {
                    event.preventDefault();
                    link.focus();
                }

            },
            init() {

                this.scrollPosition = window.scrollY;
                this.isPastThreshold = window.scrollY > this.threshold;
                this.hasBackground = this.isPastThreshold;

                // Lenis uses native scrolling, so the window scroll event still fires.
                window.addEventListener('scroll', () => {

                    const position = window.scrollY;

                    if (this.dropdown) {
                        this.closeDropdown();
                    }

                    this.direction = position > this.scrollPosition ? 'down' : 'up';
                    this.scrollPosition = position;
                    this.isPastThreshold = position > this.threshold;
                    this.isVisible = this.direction === 'up' || !this.isPastThreshold;

                }, { passive: true });

                // Background switches on only once the bar has slid off screen (matches duration-500).
                this.$watch('isVisible', (value) => {

                    if (value) {
                        return;
                    }

                    setTimeout(() => {
                        this.hasBackground = this.isPastThreshold;
                    }, 500);

                });

                this.$watch('isPastThreshold', (value) => {

                    if (!value) {
                        this.hasBackground = false;
                    }

                });

                this.$watch('mobileMenu', (value) => {

                    document.documentElement.style.overflow = value ? 'hidden' : '';

                    if (value) {
                        this.isVisible = true;
                    }

                });

                this.$watch('dropdown', (value) => {

                    if (value) {
                        this.isVisible = true;
                    }

                });

                // The xl breakpoint, matching --breakpoint-xl in src/css/index.css.
                const desktop = window.matchMedia('(min-width: 1280px)');

                desktop.addEventListener('change', () => {
                    this.mobileMenu = false;
                    this.closeDropdown();
                });

            }
        }))
    })

{% endjs %}
