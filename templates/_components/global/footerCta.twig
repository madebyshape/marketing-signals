{% set component = 'footerCta' %}

{# Default Params #}

{% set defaultParams = {
    class: null
} %}

{# Merge Params #}

{% set params = params is defined ? defaultParams|merge(params) : defaultParams %}

{# Options #}

{# The card is a twelve column grid. With Image Columns filling columns 1 to 5 the content
   starts at column 6 and keeps only its right padding, since the grid gap already separates
   the two; with none, the content spans the whole card and carries the padding on both sides.
   The Image Columns bleed to the card's edges rather than sitting inside its padding, so the
   card's radius clips them. #}

{% set options = {
    content: {
        withImages: 'lg:col-start-6 lg:col-span-7 lg:pl-0 lg:pr-15',
        fullWidth: 'lg:col-span-12 lg:px-15'
    }
} %}

{# Classes #}

{# The content's grid slot depends on whether any Image Column has images, so the columns are
   resolved before the classes that read them. #}

{% set cta = site.footerCta %}
{% set imageColumns = cta.imageColumns.all()|map(column => column.images.all())|filter(images => images|length) %}

{% set classes = {
    card: [
        'grid grid-cols-1 overflow-hidden bg-black-200 rounded-[20px] | lg:grid-cols-12 lg:items-center lg:gap-5',
        params.class
    ],
    imageColumnsSlot: 'relative h-[60vh] | lg:col-start-1 lg:col-span-5 lg:self-stretch lg:h-auto',
    imageColumns: 'absolute inset-0',
    content: [
        'p-7.5 | md:p-10 lg:py-25',
        imageColumns|length ? options.content.withImages : options.content.fullWidth
    ],
    heading: 'font-semibold leading-0.97 tracking-tighter | md:text-7xl lg:text-9xl',
    text: 'max-w-[716px] mt-7.5',
    actions: 'flex flex-wrap items-center gap-5 mt-10'
} %}

{# Output #}

{% set heading = cta.heading|trim %}
{% set avatar = cta.avatarGroup %}

{# The heading field is CKEditor, so the editor's own tag leads the markup. It is read off the
   front of the content and the block wrapper stripped, leaving the inline marks for the
   alternate heading to restyle. A paragraph falls back to `h2`. #}

{% set headingTag = heading matches '/^<h[2-6][ >]/' ? heading|slice(1, 2) : 'h2' %}
{% set headingText = heading|replace('/<\\/?(h[2-6]|p)\\b[^>]*>/', '') %}

{% if headingText|striptags|trim|length %}

    <div class="{{ classes.card|join(' ')|trim }}">

        {% if imageColumns|length %}

            {# The slot is empty of flow content so it never sizes the card's row: the card's
               height still comes from the content's padding, and the Image Columns fill the
               slot from inside it. #}

            <div class="{{ classes.imageColumnsSlot }}">

                {% include '_components/imageColumns' with {
                    params: {
                        columns: imageColumns,
                        class: classes.imageColumns
                    }
                } only %}

            </div>

        {% endif %}

        <div class="{{ classes.content|join(' ')|trim }}">

            {% include '_components/headingAlternate' with {
                params: {
                    tag: headingTag,
                    heading: headingText,
                    colour: 'creme-100',
                    size: '5xl',
                    alternateStyle: 'secondary',
                    class: classes.heading
                }
            } only %}

            {% if cta.text|striptags|trim|length %}

                {% include '_components/richText' with {
                    params: {
                        content: cta.text,
                        colour: 'creme-100',
                        size: 'md',
                        class: classes.text
                    }
                } only %}

            {% endif %}

            {% if cta.button|length or avatar.avatarName|length %}

                <div class="{{ classes.actions }}">

                    {% include '_components/button' with {
                        params: {
                            button: cta.button,
                            colour: 'creme-100'
                        }
                    } only %}

                    {% if avatar.avatarName|length %}

                        {% include '_components/user' with {
                            params: {
                                image: avatar.avatar.one(),
                                heading: avatar.avatarName,
                                subHeading: avatar.avatarJobRole,
                                colour: 'creme-100',
                                size: 'sm'
                            }
                        } only %}

                    {% endif %}

                </div>

            {% endif %}

        </div>

    </div>

{% endif %}
