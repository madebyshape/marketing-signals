{% set component = 'footerCta' %}

{# Default Params #}

{% set defaultParams = {
    class: null
} %}

{# Merge Params #}

{% set params = params is defined ? defaultParams|merge(params) : defaultParams %}

{# Options #}

{% set options = {
    content: {
        withImages: 'lg:col-start-6 lg:col-span-7 lg:pl-0 lg:pr-15',
        fullWidth: 'lg:col-span-12 lg:px-15'
    }
} %}

{# Classes #}

{% set cta = site.footerCta %}
{% set imageColumns = cta.imageColumns.all()|map(column => column.images.all())|filter(images => images|length) %}

{% set classes = {
    card: [
        'grid grid-cols-1 overflow-hidden bg-black-200 rounded-[20px] | lg:grid-cols-12 lg:items-center lg:gap-5',
        params.class
    ],
    imageColumnsSlot: 'relative h-[60vh] | lg:col-start-1 lg:col-span-5 lg:self-stretch lg:h-auto',
    imageColumns: 'absolute inset-0',
    content: [
        'p-7.5 | md:p-10 lg:py-25',
        imageColumns|length ? options.content.withImages : options.content.fullWidth
    ],
    heading: 'font-semibold leading-0.97 tracking-tighter | md:text-7xl lg:text-9xl',
    text: 'max-w-[716px] mt-7.5',
    actions: 'flex flex-wrap items-center gap-5 mt-10'
} %}

{# Output #}

{% set avatar = cta.avatarGroup %}

{% if cta.heading|striptags|trim|length %}

    <div class="{{ classes.card|join(' ')|trim }}">

        {% if imageColumns|length %}

            {# Empty of flow content so it never sizes the card's row. #}

            <div class="{{ classes.imageColumnsSlot }}">

                {% include '_components/imageColumns' with {
                    params: {
                        columns: imageColumns,
                        class: classes.imageColumns
                    }
                } only %}

            </div>

        {% endif %}

        <div class="{{ classes.content|join(' ')|trim }}">

            {% include '_components/headingAlternate' with {
                params: {
                    heading: cta.heading,
                    colour: 'creme-100',
                    size: '5xl',
                    alternateStyle: 'secondary',
                    class: classes.heading
                }
            } only %}

            {% if cta.text|striptags|trim|length %}

                {% include '_components/richText' with {
                    params: {
                        content: cta.text,
                        colour: 'creme-100',
                        size: 'md',
                        class: classes.text
                    }
                } only %}

            {% endif %}

            {% if cta.button|length or avatar.avatarName|length %}

                <div class="{{ classes.actions }}">

                    {% include '_components/button' with {
                        params: {
                            button: cta.button,
                            colour: 'creme-100'
                        }
                    } only %}

                    {% if avatar.avatarName|length %}

                        {% include '_components/user' with {
                            params: {
                                image: avatar.avatar.one(),
                                heading: avatar.avatarName,
                                subHeading: avatar.avatarJobRole,
                                colour: 'creme-100',
                                size: 'sm'
                            }
                        } only %}

                    {% endif %}

                </div>

            {% endif %}

        </div>

    </div>

{% endif %}
