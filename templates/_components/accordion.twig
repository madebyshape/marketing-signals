{% set component = 'accordion' %}

{# Default Params #}

{% set defaultParams = {
    id: null,
    items: null,
    visibleIndex: null,
    style: 'base',
    class: null
} %}

{# Merge Params #}

{% set params = params is defined ? defaultParams|merge(params) : defaultParams %}

{# Options #}

{% set options = {
    style: {
        base: {
            item: 'border-creme-400',
            itemOpen: 'bg-white',
            question: 'text-black',
            toggle: 'border-black text-black',
            toggleHover: 'pointer-fine:group-hover:border-secondary pointer-fine:group-hover:bg-secondary',
            toggleOpen: 'border-secondary bg-secondary'
        }
    }
} %}

{# Classes #}

{# The open item rides 1px over the line above it and drops its own, so it reads as one panel. #}

{% set classes = {
    wrapper: [
        'w-full',
        params.class
    ],
    item: [
        'w-full border-b first:border-t',
        options.style[params.style].item
    ],
    itemOpen: [
        'relative z-10 -mt-px rounded-[20px] border-transparent!',
        options.style[params.style].itemOpen
    ],
    question: [
        'group flex w-full cursor-pointer items-center justify-between gap-5 px-5 py-5.5 text-left',
        '|',
        'md:px-7.5'
    ],
    questionText: [
        'text-2xl font-medium leading-1.2 tracking-tighter',
        options.style[params.style].question
    ],
    toggle: [
        'flex size-6.25 shrink-0 items-center justify-center rounded-full border',
        options.style[params.style].toggle,
        'motion-safe:transition-colors motion-safe:duration-300',
        '|',
        options.style[params.style].toggleHover
    ],
    toggleOpen: options.style[params.style].toggleOpen,
    icon: 'text-[10px]',
    answer: [
        'px-5 pb-7.5 motion-reduce:duration-0!',
        '|',
        'md:px-7.5'
    ],
    buttons: 'mt-5'
} %}

{# Output #}

{% if params.items|length %}

    {% set visible = params.visibleIndex is not null ? "'" ~ params.items[params.visibleIndex].id ~ "'" : 'null' %}

    <div
        class="{{ classes.wrapper|join(' ')|trim }}"
        x-data="{ visible: {{ visible|raw }} }"
    >

        {% for item in params.items %}

            {# Ids come from the entry id, so two items worded the same never share one. #}

            {% set questionId = params.id ~ '-question-' ~ item.id %}
            {% set answerId = params.id ~ '-answer-' ~ item.id %}
            {% set open = "visible === '" ~ item.id ~ "'" %}

            <div
                class="{{ classes.item|join(' ')|trim }}"
                x-bind:class="{ '{{- classes.itemOpen|join(' ')|trim -}}': {{ open|raw }} }"
            >

                <h3>
                    <button
                        type="button"
                        id="{{ questionId }}"
                        class="{{ classes.question|join(' ')|trim }}"
                        aria-controls="{{ answerId }}"
                        x-bind:aria-expanded="{{ open|raw }} ? 'true' : 'false'"
                        x-on:click="visible = {{ open|raw }} ? null : '{{ item.id }}'"
                    >

                        <span class="{{ classes.questionText|join(' ')|trim }}">{{ item.heading }}</span>

                        <span
                            class="{{ classes.toggle|join(' ')|trim }}"
                            x-bind:class="{ '{{- classes.toggleOpen -}}': {{ open|raw }} }"
                            aria-hidden="true"
                        >
                            {# The kit swaps each icon for an SVG, so the state is bound on the span around it. #}

                            <span class="{{ classes.icon }} | pointer-fine:group-hover:hidden" x-bind:class="{ 'hidden': {{ open|raw }} }">
                                <i class="fa-sharp fa-regular fa-plus"></i>
                            </span>

                            <span class="{{ classes.icon }} hidden | pointer-fine:group-hover:block!" x-bind:class="{ 'block!': {{ open|raw }} }">
                                <i class="fa-sharp fa-regular fa-minus"></i>
                            </span>
                        </span>

                    </button>
                </h3>

                <div
                    id="{{ answerId }}"
                    class="{{ classes.answer|join(' ')|trim }}"
                    role="region"
                    aria-labelledby="{{ questionId }}"
                    x-show="{{ open|raw }}"
                    x-collapse.duration.300
                    x-cloak
                >

                    {% include '_components/richText' with {
                        params: {
                            content: item.content,
                            colour: 'black'
                        }
                    } only %}

                    {% if item.buttons is defined and item.buttons|length %}

                        {% include '_components/buttonGroup' with {
                            params: {
                                buttons: item.buttons,
                                class: classes.buttons
                            }
                        } only %}

                    {% endif %}

                </div>

            </div>

        {% endfor %}

    </div>

{% endif %}
