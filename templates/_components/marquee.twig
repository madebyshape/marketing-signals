{# Default Params #}

{% set defaultParams = {
    component: 'marquee',
    gap: 'base',
    props: {
        reversed: false,
        repeat: -1,
        speed: 1,
        pauseOnHover: false
    },
    class: null,
    attributes: null,
} %}

{# Merge Params #}

{% set params = params is defined ? defaultParams|merge(params) : defaultParams %}

{# Merge Props #}

{% set params = params|merge({
    props: defaultParams.props|merge(params.props ?? {})
}) %}

{# Options #}

{# The gap sits between the repeated items inside a track, so the track that follows needs the
   same space after its last item or the seam reads a gap short. `none` is for callers whose
   items already carry their own edges and must run into one another. #}

{% set options = {
    gap: {
        base: 'gap-x-8 last:!mr-8',
        none: ''
    }
} %}

{# Classes #}

{% set classes = {
    wrapper: [
        'w-full flex overflow-x-hidden relative',
        params.class
    ],
    track: [
        'flex items-center flex-shrink-0',
        options.gap[params.gap]
    ]
} %}

{# Output #}

{# Two copies of the same content: the loop measures one against the other, so the second is what
   fills the space the first leaves as it travels. Each copy takes its own ref, which is how the
   script reaches them without a per-instance class to query. #}

    <div
        class="{{ classes.wrapper|join(' ')|trim }}"
        x-data='{{ params.component }}({{ params.props|json_encode|raw }})'
        {{ params.attributes|raw }}
    >
        {% for i in 0..1 %}
            <div
                class="{{ classes.track|join(' ')|trim }}"
                x-ref="{{ loop.first ? 'trackOne' : 'trackTwo' }}"
            >
                {% block marqueeContent %}
                {% endblock %}
            </div>
        {% endfor %}
    </div>

{# prettier-ignore-start #}
{% js %}

    document.addEventListener('alpine:init', () => {
        Alpine.data('{{ params.component }}', (props = {}) => ({
            init() {

                const tracks = [this.$refs.trackOne, this.$refs.trackTwo];

                const config = {
                    reversed: props.reversed ?? false,
                    repeat: props.repeat ?? -1,
                    speed: props.speed ?? 1,
                    pauseOnHover: props.pauseOnHover ?? false
                };

                // Reduced motion gets the tracks exactly as they were served: no loop, no
                // listeners, the first copy's items showing where the server put them.
                // Everything below is inside the media context, so GSAP reverts the transforms
                // the loop writes if the preference changes.
                gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {

                    // Create the marquee loop
                    const marqueeLoop = gsapHorizontalLoop(tracks, {
                        reversed: config.reversed,
                        repeat: config.repeat,
                        speed: config.speed
                    });

                    // Block for custom JS content
                    {% block jsContent %}
                    {% endblock %}

                    // Pause on hover
                    if (!config.pauseOnHover) {
                        return;
                    }

                    const pause = () => gsap.to(marqueeLoop, { timeScale: 0, overwrite: true });
                    const play = () => gsap.to(marqueeLoop, { timeScale: 1, overwrite: true });

                    tracks.forEach((track) => {
                        track.addEventListener('mouseenter', pause);
                        track.addEventListener('mouseleave', play);
                    });

                    // GSAP reverts what it made, but the listeners are ours to take back off.
                    return () => {
                        tracks.forEach((track) => {
                            track.removeEventListener('mouseenter', pause);
                            track.removeEventListener('mouseleave', play);
                        });
                    };

                });

            }

        }))
    })

{% endjs %}
{# prettier-ignore-end #}
