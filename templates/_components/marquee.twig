{# Default Params #}

{% set defaultParams = {
    component: 'marquee',
    gap: 'base',
    props: {
        reversed: false,
        repeat: -1,
        speed: 1,
        pauseOnHover: false
    },
    class: null,
    attributes: null,
} %}

{# Merge Params #}

{% set params = params is defined ? defaultParams|merge(params) : defaultParams %}

{# Merge Props #}

{% set params = params|merge({
    props: defaultParams.props|merge(params.props ?? {})
}) %}

{# Options #}

{# The second track needs the same space after its last item or the seam reads a gap short. #}

{% set options = {
    gap: {
        base: 'gap-x-8 last:!mr-8',
        sm: 'gap-x-2.5 | last:!mr-2.5 | lg:gap-x-4 lg:last:!mr-4',
        none: ''
    }
} %}

{# Classes #}

{% set classes = {
    wrapper: [
        'w-full flex overflow-x-hidden relative',
        params.class
    ],
    track: [
        'flex items-center flex-shrink-0',
        options.gap[params.gap]
    ]
} %}

{# Output #}

{# Two copies: the second fills the space the first leaves as it travels. #}

    <div
        class="{{ classes.wrapper|join(' ')|trim }}"
        x-data='{{ params.component }}({{ params.props|json_encode|raw }})'
        {{ params.attributes|raw }}
    >
        {% for i in 0..1 %}
            <div
                class="{{ classes.track|join(' ')|trim }}"
                x-ref="{{ loop.first ? 'trackOne' : 'trackTwo' }}"
            >
                {% block marqueeContent %}
                {% endblock %}
            </div>
        {% endfor %}
    </div>

{# prettier-ignore-start #}
{% js %}

    document.addEventListener('alpine:init', () => {
        Alpine.data('{{ params.component }}', (props = {}) => {

            // Held outside the data object so Alpine doesn't make them reactive.
            let marqueeLoop = null;
            let held = false;

            const pause = () => {
                if (marqueeLoop) gsap.to(marqueeLoop, { timeScale: 0, overwrite: true });
            };

            // Leaving the row cannot restart a Crawl its caller is holding.
            const play = () => {
                if (marqueeLoop && !held) gsap.to(marqueeLoop, { timeScale: 1, overwrite: true });
            };

            return {
                init() {

                    const tracks = [this.$refs.trackOne, this.$refs.trackTwo];

                    const config = {
                        reversed: props.reversed ?? false,
                        repeat: props.repeat ?? -1,
                        speed: props.speed ?? 1,
                        pauseOnHover: props.pauseOnHover ?? false
                    };

                    gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {

                        marqueeLoop = gsapHorizontalLoop(tracks, {
                            reversed: config.reversed,
                            repeat: config.repeat,
                            speed: config.speed
                        });

                        {% block jsContent %}
                        {% endblock %}

                        if (!config.pauseOnHover) {
                            return;
                        }

                        tracks.forEach((track) => {
                            track.addEventListener('mouseenter', pause);
                            track.addEventListener('mouseleave', play);
                        });

                        return () => {
                            tracks.forEach((track) => {
                                track.removeEventListener('mouseenter', pause);
                                track.removeEventListener('mouseleave', play);
                            });
                        };

                    });

                },

                // A caller stops the Crawl through these, as the Team Modal does while it is open.
                hold() {
                    held = true;
                    pause();
                },

                release() {
                    held = false;
                    play();
                }
            };

        })
    })

{% endjs %}
{# prettier-ignore-end #}
