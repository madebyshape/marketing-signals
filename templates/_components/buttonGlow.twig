{#
    The glow shimmer uses a `glow` keyframes animation, included in the
    <style> block at the bottom of this component so it works standalone.
    Optionally move the keyframes into your Tailwind @theme (src/css/index.css)
    and swap `after:animate-[glow_5s_infinite_linear]` for `after:animate-glow`:

    @theme {
        --animate-glow: glow 5s infinite linear;
        @keyframes glow {
            0% { background-position: 0 100%; }
            100% { background-position: 0 300%; }
        }
    }
#}

{# Default Params #}

{% set defaultParams = {
    type: 'a',
    button: {},
    colour: 'base',
    size: 'base',
    icon: '',
    iconPosition: 'after',
    class: '',
    attributes: ''
} %}

{# Merge Params #}

{% set params = params is defined ? defaultParams|merge(params) : defaultParams %}

{# Options #}

{% set options = {
    colour: {
        base: {
            button: 'ring-black/50',
            content: 'bg-black text-white pointer-fine:hover:bg-zinc-600',
            glow: 'after:[background:linear-gradient(-20deg,#a855f7,#a855f720_16.5%,#3b82f6_33%,#a855f710_49.5%,#60a5fa_66%,#a855f700_85.5%,#6366f1_100%)_0_100%/100%_200%]',
        },
    },
    size: {
        base: 'text-md px-5 py-3 rounded-md'
    },
    iconPosition: {
        before: 'flex-row',
        after: 'flex-row-reverse'
    }
} %}

{# Classes #}

{% set classes = {
    button: [
        'group relative inline-flex flex-shrink-0 rounded-md cursor-pointer motion-safe:transition focus:outline-none focus:ring-3',
        options.colour[params.colour].button,
        params.class
    ],
    glow: [
        "pointer-events-none absolute inset-0 z-[1] block rounded-[inherit] after:content-[''] after:absolute after:inset-0 after:block after:rounded-[inherit] after:blur-[8px] after:opacity-0 after:transition-opacity after:duration-200 after:ease-linear after:animate-[glow_5s_infinite_linear] motion-reduce:after:animate-none group-hover:after:opacity-100 group-focus:after:opacity-100 group-focus-within:after:opacity-100",
        options.colour[params.colour].glow
    ],
    content: [
        'relative z-[2] inline-flex flex-shrink-0 justify-center gap-x-2 items-center leading-none border border-transparent',
        options.size[params.size],
        options.colour[params.colour].content,
        options.iconPosition[params.iconPosition]
    ],
    icon: [
        'inline-block align-middle motion-safe:transition'
    ]
} %}

{# Output #}

{% if params.button|length %}

    <{{ params.type }}
        {% if params.type == 'a' %}
            href="{{ params.button.value }}"
            {% if params.button.target is defined %}
                target="{{ params.button.target }}"
                {% if params.button.target == '_blank' %}
                    rel="noopener noreferrer"
                {% endif %}
            {% endif %}
        {% endif %}
        class="{{ classes.button|join(' ')|trim }}"
        {{ params.attributes|raw }}
    >
        <span class="{{ classes.glow|join(' ')|trim }}" aria-hidden="true"></span>

        <span class="{{ classes.content|join(' ')|trim }}">
            {% if params.icon %}
                <span class="{{ classes.icon|join(' ')|trim }}" aria-hidden="true">
                    <i class="{{ params.icon }}"></i>
                </span>
            {% endif %}
            {{ params.button.label }}
        </span>
    </{{ params.type }}>

{% endif %}

{# Remove this <style> block once the `glow` keyframes are added to your Tailwind @theme (see note at top). #}
<style>
    @keyframes glow {
        0% { background-position: 0 100%; }
        100% { background-position: 0 300%; }
    }
</style>