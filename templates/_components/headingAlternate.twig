{# Default Params #}

{% set defaultParams = {
    tag: 'h2',
    heading: null,
    colour: 'base',
    size: '5xl',
    style: 'sans',
    class: null,
    attributes: null,
    margin: 'none',
    marginSize: 'base',
    alternateStyle: 'base'
} %}

{# Merge Params #}

{% set params = params is defined ? defaultParams|merge(params) : defaultParams %}

{# Options #}

{% set options = {
    colour: {
        base: 'text-black',
        'creme-100': 'text-creme-100',
        secondary: 'text-secondary',
    },
    size: {
        'xs': 'text-xs',
        'sm': 'text-sm',
        'base': 'text-base',
        'md': 'text-md',        
        'lg': 'text-lg',
        'xl': 'text-xl',
        '2xl': 'text-2xl',
        '3xl': 'text-3xl',
        '4xl': 'text-4xl',
        '5xl': 'text-5xl',
        '6xl': 'text-6xl',
        '7xl': 'text-7xl',
        '8xl': 'text-8xl',
        '9xl': 'text-9xl',
        '10xl': 'text-10xl',
        '11xl': 'text-11xl',
        '12xl': 'text-12xl',
        '13xl': 'text-13xl'
    },
    style: {
        sans: 'font-sans-primary',
        serif: 'font-serif-primary'
    },
    margin: {
        base: {
            none: 'm-0',
            top: 'mt-10',
            bottom: 'mb-10',
            topBottom: 'my-10',
        }
    },
    alternateStyle: {
        base: 'text-primary',
        secondary: 'text-secondary',
    },
} %}

{# Classes #}

{% set classes = {
    heading: [
        options.colour[params.colour],
        options.size[params.size],
        options.style[params.style],
        options.margin[params.marginSize][params.margin],
        params.class
    ]
} %}

{# Heading Tag #}

{# The heading is given as the CKEditor value stores it, so the editor's own tag leads the
   markup: it is read off the front and becomes the element, and the block wrapper is stripped
   so only the inline marks are left to restyle. A paragraph, or a value with no wrapper at
   all, falls back to the `tag` param. #}

{% set heading = params.heading|trim %}
{% set headingTag = heading matches '/^<h[2-6][ >]/' ? heading|slice(1, 2) : params.tag %}
{% set headingText = heading|replace('/<\\/?(h[2-6]|p)\\b[^>]*>/', '') %}

{# Alternate Style #}

{# Underline and italic are both the editor's highlight marker rather than emphasis: the mark
   is dropped and the words take the alternate colour, as `em` does on the rich text. Retcon
   parses what it is given as a document, so it wraps the now loose text back in a paragraph;
   that wrapper comes off again on the way out. #}

{% set alternateStyles = [
    ['attr', 'u', { class: 'no-underline ' ~ options.alternateStyle[params.alternateStyle] }],
    ['attr', ['em', 'i'], { class: 'not-italic ' ~ options.alternateStyle[params.alternateStyle] }],
] %}

{% set restyledText = headingText|retcon(alternateStyles)|replace({'<p>': '', '</p>': ''}) %}


{# Output #}

{% if headingText|striptags|trim|length %}

    <{{ headingTag }}
        class="{{ classes.heading|join(' ')|trim }}"
        {{ params.attributes|raw }}
    >
        {{ restyledText|raw|nl2br }}
    </{{ headingTag }}>

{% endif %}