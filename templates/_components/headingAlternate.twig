{# Default Params #}

{% set defaultParams = {
    tag: 'h2',
    heading: null,
    colour: 'base',
    size: '5xl',
    style: 'sans',
    class: null,
    attributes: null,
    margin: 'none',
    marginSize: 'base',
    alternateStyle: 'base'
} %}

{# Merge Params #}

{% set params = params is defined ? defaultParams|merge(params) : defaultParams %}

{# Options #}

{% set options = {
    colour: {
        base: 'text-black',
        'creme-100': 'text-creme-100',
    },
    size: {
        'xs': 'text-xs',
        'sm': 'text-sm',
        'base': 'text-base',
        'md': 'text-md',        
        'lg': 'text-lg',
        'xl': 'text-xl',
        '2xl': 'text-2xl',
        '3xl': 'text-3xl',
        '4xl': 'text-4xl',
        '5xl': 'text-5xl',
        '6xl': 'text-6xl',
        '7xl': 'text-7xl',
        '8xl': 'text-8xl',
        '9xl': 'text-9xl'
    },
    style: {
        sans: 'font-sans-primary',
        serif: 'font-serif-primary'
    },
    margin: {
        base: {
            none: 'm-0',
            top: 'mt-10',
            bottom: 'mb-10',
            topBottom: 'my-10',
        }
    },
    alternateStyle: {
        base: 'text-primary',
        secondary: 'text-secondary',
    },
} %}

{# Classes #}

{% set classes = {
    heading: [
        options.colour[params.colour],
        options.size[params.size],
        options.style[params.style],
        options.margin[params.marginSize][params.margin],
        params.class
    ]
} %}

{# Alternate Style #}

{# Underline and italic are both the editor's highlight marker rather than emphasis: the mark
   is dropped and the words take the alternate colour, as `em` does on the rich text. #}

{% set alternateStyles = [
    ['attr', 'u', { class: 'no-underline ' ~ options.alternateStyle[params.alternateStyle] }],
    ['attr', ['em', 'i'], { class: 'not-italic ' ~ options.alternateStyle[params.alternateStyle] }],
] %}

{% set restyledText = params.heading|retcon(alternateStyles)|replace({'<p>': '', '</p>': ''}) %}


{# Output #}

{% if params.heading|length %}

    <{{ params.tag }} 
        class="{{ classes.heading|join(' ')|trim }}"
        {{ params.attributes|raw }}
    >
        {{ restyledText|raw|nl2br }}
    </{{ params.tag }}>

{% endif %}