{# Default Params #}

{% set defaultParams = {
    component: 'cursor',
    icon: 'fa-regular fa-sharp',
    colour: 'base',
    size: 'base',
    class: null
} %}

{# Merge Params #}

{% set params = params is defined ? defaultParams|merge(params) : defaultParams %}

{# Options #}

{% set options = {
    colour: {
        base: 'bg-white text-black',
    },
    size: {
        base: 'px-2.5 py-1.25 text-base',
    }
} %}

{# Classes #}

{# GSAP moves the pointer; the pill keeps the class scale GSAP's inline transform would wipe. #}

{% set classes = {
    pointer: [
        'hidden pointer-events-none fixed top-0 left-0 z-50',
        '|',
        'pointer-fine:block'
    ],
    cursor: [
        'flex items-center justify-center gap-x-2 whitespace-nowrap rounded-full font-medium leading-none transition scale-0',
        options.colour[params.colour],
        options.size[params.size],
        params.class
    ],
} %}

{# Output #}

{# Every part of the detail is read afresh, so a caller sending only text never inherits the last icon. #}

<div
    x-data="{{ params.component }}"
    @component-cursor.window="

        active = $event.detail.active ? true : false;
        text = $event.detail.text ? $event.detail.text : false;
        icon = $event.detail.icon ? $event.detail.icon : false;

    "
>

    <div class="{{ classes.pointer|join(' ')|trim }}" x-ref="pointer">

        <div
            class="{{ classes.cursor|join(' ')|trim }}"
            x-bind:class="{
                'scale-100': active,
                'scale-0': !active
            }"
        >

            <i
                class="{{ params.icon }}"
                x-show="icon"
                x-bind:class="icon"
            >
            </i>

            <span x-show="text" x-text="text"></span>

        </div>

    </div>

</div>

{% js %}

    document.addEventListener('alpine:init', () => {
        Alpine.data('{{ params.component }}', () => ({
            active: false,
            text: false,
            icon: false,
            init() {

                const _self = this;
                const pointer = _self.$refs.pointer;

                if (!window.matchMedia('(pointer: fine)').matches) {
                    return;
                }

                gsap.set(pointer, { xPercent: -50, yPercent: -50 });

                const moveX = gsap.quickTo(pointer, 'x', { duration: 0.3, ease: 'power3' });
                const moveY = gsap.quickTo(pointer, 'y', { duration: 0.3, ease: 'power3' });

                document.addEventListener('pointermove', (e) => {

                    moveX(e.clientX);
                    moveY(e.clientY);

                });

                _self.$watch('active', value => {

                    document.body.style.cursor = value ? 'none' : 'default';

                });

            }
        }));
    });

{% endjs %}
