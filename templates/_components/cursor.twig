{# Default Params #}

{% set defaultParams = {
    component: 'cursor',
    icon: 'fa-regular fa-sharp',
    colour: 'base',
    size: 'base',
    class: null
} %}

{# Merge Params #}

{% set params = params is defined ? defaultParams|merge(params) : defaultParams %}

{# Options #}

{% set options = {
    colour: {
        base: 'bg-white text-black',
    },
    size: {
        base: 'px-2.5 py-1.25 text-base',
    },
    style: {
        pill: {
            cursor: 'justify-center gap-x-2 rounded-full font-medium leading-none',
            icon: '',
            text: ''
        },
        outline: {
            cursor: 'gap-x-1.5',
            icon: 'flex size-[18px] items-center justify-center rounded-full border border-creme-100 text-[8px] text-creme-100',
            text: 'text-xs font-normal leading-[20px] tracking-tight text-white'
        }
    }
} %}

{# Classes #}

{# GSAP moves the pointer; the pill keeps the class scale GSAP's inline transform would wipe. #}

{% set classes = {
    pointer: [
        'hidden pointer-events-none fixed top-0 left-0 z-50',
        '|',
        'pointer-fine:block'
    ],
    cursor: [
        'flex items-center whitespace-nowrap transition',
        params.class
    ],
    style: options.style|merge({
        pill: options.style.pill|merge({
            cursor: [
                options.style.pill.cursor,
                options.colour[params.colour],
                options.size[params.size]
            ]|join(' ')
        })
    })
} %}

{# Output #}

{# Every part of the detail is read afresh, so a caller sending only text never inherits the last icon. #}

<div
    x-data='{{ params.component }}({{ classes.style|json_encode|raw }})'
    @component-cursor.window="

        active = $event.detail.active ? true : false;
        text = $event.detail.text ? $event.detail.text : false;
        icon = $event.detail.icon ? $event.detail.icon : false;
        style = $event.detail.style ? $event.detail.style : 'pill';

    "
>

    <div class="{{ classes.pointer|join(' ')|trim }}" aria-hidden="true" x-ref="pointer">

        <div
            class="{{ classes.cursor|join(' ')|trim }}"
            x-bind:class="[styles[style].cursor, active ? 'scale-100' : 'scale-0']"
        >

            <span x-show="icon" x-bind:class="styles[style].icon">

                <i class="{{ params.icon }}" x-bind:class="icon"></i>

            </span>

            <span x-show="text" x-text="text" x-bind:class="styles[style].text"></span>

        </div>

    </div>

</div>

{% js %}

    document.addEventListener('alpine:init', () => {
        Alpine.data('{{ params.component }}', (styles = {}) => ({
            active: false,
            text: false,
            icon: false,
            style: 'pill',
            styles: styles,
            init() {

                const _self = this;
                const pointer = _self.$refs.pointer;

                if (!window.matchMedia('(pointer: fine)').matches) {
                    return;
                }

                gsap.set(pointer, { xPercent: -50, yPercent: -50 });

                const moveX = gsap.quickTo(pointer, 'x', { duration: 0.3, ease: 'power3' });
                const moveY = gsap.quickTo(pointer, 'y', { duration: 0.3, ease: 'power3' });

                document.addEventListener('pointermove', (e) => {

                    moveX(e.clientX);
                    moveY(e.clientY);

                });

                _self.$watch('active', value => {

                    document.body.style.cursor = value ? 'none' : 'default';

                });

            }
        }));
    });

{% endjs %}
