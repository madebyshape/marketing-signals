{% set component = 'carouselControls' %}

{# Default Params #}

{% set defaultParams = {
    style: 'pill',
    colour: 'base',
    bind: 'ref',
    class: null,
} %}

{# Merge Params #}

{% set params = params is defined ? defaultParams|merge(params) : defaultParams %}

{# Options #}

{% set options = {
    style: {
        pill: '_components/button',
        icon: '_components/buttonShape'
    },
    colour: {
        base: {
            prev: 'creme-100-outline',
            next: 'secondary'
        },
        black: {
            prev: 'black-outline',
            next: 'secondary'
        },
        'white-30-outline': {
            prev: 'white-30-outline',
            next: 'secondary'
        }
    },
    bind: {
        ref: {
            prev: { class: null, attributes: 'x-ref="prev"' },
            next: { class: null, attributes: 'x-ref="next"' }
        },
        class: {
            prev: { class: '|| js-carousel-prev', attributes: null },
            next: { class: '|| js-carousel-next', attributes: null }
        }
    }
} %}

{# Classes #}

{% set classes = {
    wrapper: [
        'flex items-center justify-center gap-x-2.5',
        params.class
    ],
    control: [
        'disabled:pointer-events-none [&.swiper-button-disabled]:opacity-30'
    ]
} %}

{# Output #}

{# Ref-bound Controls belong in the carousel's after-content slot; class-bound ones can sit anywhere inside it. #}

<div class="{{ classes.wrapper|join(' ')|trim }}">

    {% for control in [
        { ref: 'prev', label: 'Previous', icon: 'fa-sharp fa-regular fa-arrow-left', iconPosition: 'before' },
        { ref: 'next', label: 'Next', icon: 'fa-sharp fa-regular fa-arrow-right', iconPosition: 'after' }
    ] %}

        {% set binding = options.bind[params.bind][control.ref] %}

        {# The icon circles carry no text, so they take the label as an aria-label. #}

        {% include options.style[params.style] with {
            params: {
                type: 'button',
                button: { label: control.label },
                colour: options.colour[params.colour][control.ref],
                icon: control.icon,
                iconPosition: control.iconPosition,
                class: classes.control|merge([binding.class])|join(' ')|trim,
                attributes: (binding.attributes ~ (params.style == 'icon' ? ' aria-label="' ~ control.label ~ '"'))|trim
            }
        } only %}

    {% endfor %}

</div>
